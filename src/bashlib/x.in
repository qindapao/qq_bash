((_X_IMPORTED++)) && return 0

. "${BASH_SOURCE[0]%/*}/grammar.sh"
. "${BASH_SOURCE[0]%/*}/array.sh"
. "${BASH_SOURCE[0]%/*}/var.sh"
. "${BASH_SOURCE[0]%/*}/str.sh"
. "${BASH_SOURCE[0]%/*}/meta.sh"

# ================================================================================
# Importantly, if you want to save x data, there are two recommended ways:
#
#   1. Serialize it into JSON standard format (x_to_json), and convert the
#      JSON back into x (x_from_json) before use.
#
#   2. Use the native dump format: dump the tree (which yields a stable,
#      human-readable text representation), and rebuild the tree from that
#      dump with x_rebuild_from_dump before use.
#
# Both of the above rely only on stable, documented formats, so they keep
# working even if the internal implementation of the tree changes.
#
# Do NOT save a tree by `declare -p tree` to a file and restore it via the
# `source` method. That depends on the internal implementation details of
# the tree; if those details change, restoring will fail.
#
# All variable names in the library start with tr_.
# Be careful to avoid external variables.
# tr_
#================================================================================

#-------------------------------------------------------------------------------

# If you want more powerful anti-collision capabilities, you can set it as follows
# But usually $'\034' is enough.
# Be careful not to change this value casually, as it may affect the re-import of the variable.
# The semantics will change after importing
# readonly X=$'\034\035\036\037'
readonly X=$'\034'
readonly X_ROOT_ID=1

readonly X_RET_ENUM_OK=0

readonly X_RET_ENUM_KEY_IS_TREE=1
readonly X_RET_ENUM_KEY_IS_LEAF=2
readonly X_RET_ENUM_KEY_IS_NOTFOUND=3
readonly X_RET_ENUM_KEY_IS_INVALID=4
readonly X_RET_ENUM_KEY_OUT_OF_INDEX=5
readonly X_RET_ENUM_KEY_IS_NOT_LEAF=6
readonly X_RET_ENUM_KEY_IS_NULL=7
readonly X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH=8
readonly X_RET_ENUM_KEY_CHILD_CNT_IS_ZERO=9
readonly X_RET_ENUM_KEY_OTHER_TOOL_NOT_INSTALLED=10
readonly X_RET_ENUM_KEY_BJSON_TYPE_INVALID=11
readonly X_RET_ENUM_KEY_BJSON_TYPE_OBJ=12
readonly X_RET_ENUM_KEY_BJSON_TYPE_ARR=13
readonly X_RET_ENUM_KEY_PARAMETER_LENGTH_EXCEEDS_LIMIT=14

readonly X_RET_ENUM_TREE_IS_INVALID=50
readonly X_RET_ENUM_TREE_IS_EMPTY=51
readonly X_RET_ENUM_TREE_NOT_HAVE_ROOT=52
readonly X_RET_ENUM_TREE_IS_NOT_SAME=53

# type field (dedicated to container identification)
readonly X_TYPE_OBJ=1
readonly X_TYPE_ARR=2

# Node type (walk-specific)
readonly X_NODE_KIND_OBJ=1
readonly X_NODE_KIND_ARR=2
readonly X_NODE_KIND_OBJ_EMPTY=3
readonly X_NODE_KIND_ARR_EMPTY=4
readonly X_NODE_KIND_LEAF=5
readonly X_NODE_KIND_LEAF_NULL=6
readonly X_NODE_KIND_UNKNOWN=7

# Value types (only for writing and printing)
readonly X_VALUE_NULL="null$X"
readonly X_VALUE_TRUE="true$X"
readonly X_VALUE_FALSE="false$X"
readonly X_VALUE_NULL_OBJ="{}$X"
readonly X_VALUE_NULL_ARR="[]$X"

# Flat layer judgment
readonly X_FLAT_IS_MATCH=0
readonly X_FLAT_IS_NOT_MATCH=1
readonly X_FLAT_ARRAY_NULL=2
readonly X_FLAT_ASSOC_NULL=3

# gobolt JSON Object type return value
readonly X_GOBOLT_JSONTYPENULL=1
readonly X_GOBOLT_JSONTYPETRUE=2
readonly X_GOBOLT_JSONTYPEFALSE=3
readonly X_GOBOLT_JSONTYPENUMBER=4
readonly X_GOBOLT_JSONTYPESTRING=5
readonly X_GOBOLT_JSONTYPEARRAY=6
readonly X_GOBOLT_JSONTYPEOBJECT=7
readonly X_GOBOLT_JSONTYPEUNKNOWN=8

#-------------------------------------------------------------------------------

# $1: The value of the string that needs to be converted
# $2: Variable name saved after conversion
#
# JSON 路径键转义：转义 [ ] . * ? | @ # { } ! 为带反斜杠的形态。
# @in  $1=原始字符串  $2=输出变量名（nameref）
# @ret 0（始终成功）
x_bjson_key_escape ()
{
    local -n bjsonKeyEscapeR_ekey="$2"

    bjsonKeyEscapeR_ekey="$1"

    if ((${#bjsonKeyEscapeR_ekey}>6666)) ; then
        bjsonKeyEscapeR_ekey=$(printf '%s' "$bjsonKeyEscapeR_ekey" | gobolt json -m e -k stdin)
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey%?}
    else
    #@if patsub_replacement==1
        local bjsonKeyEscapeR_is_patsub_replacement_on=0
        shopt -q patsub_replacement || {
            shopt -s patsub_replacement
            bjsonKeyEscapeR_is_patsub_replacement_on=1
        }

        # 5.2 patsub_replacement
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//[$'][\\.*?|@#{}!']/\\&}
        ((bjsonKeyEscapeR_is_patsub_replacement_on)) && shopt -u patsub_replacement
    #@endif
    #@if patsub_replacement==0
        # Backslashes must be handle first
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'\'/'\\'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//']'/'\]'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'['/'\['}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'.'/'\.'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'*'/'\*'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'?'/'\?'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'|'/'\|'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'@'/'\@'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'#'/'\#'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'{'/'\{'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'}'/'\}'}
        bjsonKeyEscapeR_ekey=${bjsonKeyEscapeR_ekey//'!'/'\!'}
    #@endif
    fi
}

#-------------------------------------------------------------------------------

# 拆分 "$X" 分隔的 token 串为数组，校验每个 token 是否合法（'{k}'/'[]'/'()'/'<>'）。
# @in  $1=token 串  $2=插入语义标志(1=允许 '()' 主键)
# @out REPLY=token 数组（@Q 格式）
# @ret 0=OK  4=X_RET_ENUM_KEY_IS_INVALID
_split_tokens ()
{
    REPLY=
    local tokens_str=$1
    local is_insertion_semantics=${2:-0}
    local -a tokens=()
    local token

    while [[ -n "$tokens_str" ]] ; do
        token=${tokens_str%%"$X"*}
        ((${#token}<=2)) && return $X_RET_ENUM_KEY_IS_INVALID
        case "${token:0:1}${token: -1}" in
        '()')
            # Must have insertion semantics and must be a positive integer
            ((is_insertion_semantics)) || {
                die ERR "now are not in insertion semantics. key:${1@Q} is invalid!"
                return $X_RET_ENUM_KEY_IS_INVALID
            }
            str_is_decimal_positive_int "${token:1:-1}" || {
                die ERR "key:${1@Q} is invalid!"
                return $X_RET_ENUM_KEY_IS_INVALID
            }
            ;;
        '[]')
            str_is_decimal_int "${token:1:-1}" || {
                die ERR "key:${1@Q} is invalid!"
                return $X_RET_ENUM_KEY_IS_INVALID
            }
            ;;
        '{}'|'<>')  : ;;
        *)  die ERR "key:${1@Q} is invalid!"
            return $X_RET_ENUM_KEY_IS_INVALID
            ;;
        esac
        tokens+=("$token")

        tokens_str="${tokens_str#*"$X"}"
    done
    
    REPLY="${tokens[*]@Q}"
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# index -> physical
#
# 索引 token 转物理 token（如 '[0]' -> '<n>'）。
# @in  $1=树名  $2=token  $3=父节点 ID
# @out REPLY=物理 token
# @ret 0=OK  5=X_RET_ENUM_KEY_OUT_OF_INDEX
tr_resolve_index_token ()
{
    REPLY=
    local -n tr_t=$1
    local tr_token=$2 tr_node=$3
    if [[ "${tr_token:0:1}${tr_token: -1}" == '[]' ]] ; then
        local -a "tr_child_ids=(${tr_t[$tr_node.s]})"
            #@if current_shell_process_replace==1
        tr_token=${|_negative_token_to_positive "$tr_token" "${#tr_child_ids[@]}" "$tr_node";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        _negative_token_to_positive "$tr_token" "${#tr_child_ids[@]}" "$tr_node" || eval "$_ret_e"
        eval "${_ret_s_/o/tr_token}"
            #@endif
        tr_token=${tr_child_ids[${tr_token:1:-1}]}
    fi
    REPLY="$tr_token"
}

#-------------------------------------------------------------------------------

# physical -> index
#
# 物理 token 转索引 token（如 '<n>' -> '[i]'）。
# @in  $1=树名  $2=token  $3=父节点 ID
# @out REPLY=索引 token
# @ret 0=OK  4=X_RET_ENUM_KEY_IS_INVALID
tr_resolve_physical_token ()
{
    REPLY=
    local -n tr_t=$1
    local tr_token=$2 tr_node=$3

    if [[ "${tr_token:0:1}${tr_token: -1}" == '<>' ]] ; then
        local -a "tr_child_ids=(${tr_t[$tr_node.s]})"
        #@if current_shell_process_replace==1
        local -i tr_index=${|array_index "${tr_token}" ${tr_child_ids[@]};}
        #@endif
        #@if current_shell_process_replace==0
        array_index "${tr_token}" ${tr_child_ids[@]} ; local -i tr_index=$REPLY
        #@endif
        ((tr_index==-1)) && {
            die ERR "node:${tr_node}(token:${tr_token@Q}) can not find index."
            return $X_RET_ENUM_KEY_IS_INVALID
        }
        tr_token="[$tr_index]"
    fi
    REPLY="$tr_token"
}

#-------------------------------------------------------------------------------

# Convert negative index of array to positive index
# a=(1 2 3 4) index=-1 -> index=3
#                         index=(($len+index))
# 负索引归一化：'[-1]' -> '[(len-1)]'。
# @in  $1=token  $2=数组长度  $3=父节点 ID
# @out REPLY=归一化后的 token
# @ret 0=OK  5=X_RET_ENUM_KEY_OUT_OF_INDEX
_negative_token_to_positive ()
{
    REPLY=
    local tr_token=$1 tr_array_len=$2 tr_node=$3
    if ((${tr_token:1:-1}<0)) ; then
        local -i tr_token_abs=${tr_token:1:-1}
        ((tr_token_abs=-tr_token_abs))
        ((tr_token_abs>tr_array_len)) && {
            die ERR "node:${tr_node}(token:${tr_token@Q}) index:${tr_token:1:-1} is out of index."
            return $X_RET_ENUM_KEY_OUT_OF_INDEX
        }
        ((tr_token_abs=tr_array_len-tr_token_abs))
        REPLY="${tr_token:0:1}$tr_token_abs${tr_token: -1}"
    else
        REPLY="$tr_token"
    fi
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# children -> s
# child    -> c
# key      -> k
# type     -> t
# 初始化一棵空树。
# @in  $1=根类型（X_TYPE_OBJ=1 或 X_TYPE_ARR=2，默认 OBJ）
# @out REPLY=新树（关联数组 KV 格式，含根节点和 max_index=2）
# @ret 0
x_init ()
{
    REPLY=
    local -A t=()
    # t[$X_ROOT_ID]=1
    t[$X_ROOT_ID.t]=${1:-"$X_TYPE_OBJ"}
    # t[$X_ROOT_ID.s]=''
    # t[$X_ROOT_ID.k]=''

    # Next available node ID
    t[max_index]=2
#@if at_k_var_substitution==1
    REPLY=${t[*]@K}
#@endif
#@if at_k_var_substitution==0
    array_to_kv_q_str t ; REPLY=$REPLY
#@endif
}

#-------------------------------------------------------------------------------

# Verify whether the subtree is a basic x
#
# 校验子树是否合法（关联数组、非空、有根节点）。
# @in  $1=树名
# @ret 0=OK  50=X_RET_ENUM_TREE_IS_INVALID  51=TREE_IS_EMPTY  52=TREE_NOT_HAVE_ROOT
_x_tree_is_valid ()
{
    local -n tr_tree=$1

    [[ "${tr_tree@a}" != *A* ]] && {
        die ERR "invalid tree: $1 is not an associative array!"
        return ${X_RET_ENUM_TREE_IS_INVALID}
    }

    ((${#tr_tree[@]})) || {
        die ERR "invalid tree: $1 is empty!"
        return ${X_RET_ENUM_TREE_IS_EMPTY}
    }

    [[ ${tr_tree[$X_ROOT_ID.t]+_} ]] || {
        die ERR "invalid tree: $1 not have root node!"
        return ${X_RET_ENUM_TREE_NOT_HAVE_ROOT}
    }

    return ${X_RET_ENUM_OK}
}

#-------------------------------------------------------------------------------

# 将 '()' 主键语义转为 '[]' 索引语义（用于 x_qinserts 的前缀归一化）。
# @in  $1=token 串
# @out REPLY=转换后的 token 串
# @ret 0
_tokens_insert_to_overwrite ()
{
    REPLY=
    local tokens_str=$1
    [[ -z "$tokens_str" ]] && return $X_RET_ENUM_OK
    local -a tokens=()
    local token
    while [[ -n "$tokens_str" ]] ; do
        token=${tokens_str%%"$X"*}
        [[ "${token:0:1}" == '(' ]] && token="[${token:1:-1}]"
        tokens+=("$token")
        tokens_str="${tokens_str#*"$X"}"
    done
    printf -v REPLY "%s$X" "${tokens[@]}"
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# Subtree mount
# Reuse x_insert, so it is not the most efficient implementation version
# is the simplest implementation
#
# REPLY: (node_id node_phy_path)
#
# 子树挂载：把子树 $3 的全部叶挂到 $1 的 $2 前缀下。
# @in  $1=目标树名  $2=挂载前缀  $3=子树名
# @out REPLY=列表 "node_id physical_key"
# @ret 0=OK  其他=透传 _x_tree_is_valid / x_insert 的返回码
x_graft ()
{
    REPLY=
    # local - ; set +x
    local tr_target_name=$1
    # If tr_prefix contains '()', it can only be used for the first time
    local tr_graft_prefix=$2
    local tr_sub_name=$3
    local tr_graft_is_first_insert=1
    local tr_graft_start_token_id=${X_ROOT_ID}
    local tr_graft_start_path_token=""
    local tr_graft_reply=()

    # 2. Simply check the legality of the subtree
    _x_tree_is_valid "$3" || return $?

    # 3. Use the x_walk function to traverse a subtree
    x_graft_walk_cb ()
    {
        local tr_node_kind=$1
        local tr_index_full_key=$3
        local tr_value=$4
        local tr_prefix=$tr_graft_prefix

        case "$tr_node_kind" in
        $X_NODE_KIND_LEAF|$X_NODE_KIND_LEAF_NULL|$X_NODE_KIND_OBJ_EMPTY|$X_NODE_KIND_ARR_EMPTY)

            x_insert "$tr_target_name" \
                        "$tr_prefix$tr_index_full_key" \
                        "$tr_value" \
                        "$tr_graft_start_token_id" \
                        "$tr_graft_start_path_token" || return $?

            if ((tr_graft_is_first_insert)) ; then
                tr_graft_is_first_insert=0
                    #@if current_shell_process_replace==1
                tr_graft_prefix=${|_tokens_insert_to_overwrite "$tr_graft_prefix";}
                local -A "tr_prefix_token_info=(${|_x_token_to_node_id "$tr_target_name" "$tr_graft_prefix";})"
                    #@endif
                    #@if current_shell_process_replace==0
                _tokens_insert_to_overwrite "$tr_graft_prefix" ; eval "${_ret_s_/o/tr_graft_prefix}"
                _x_token_to_node_id "$tr_target_name" "$tr_graft_prefix" ; eval "${_ret_A/o/tr_prefix_token_info}"
                    #@endif
                tr_graft_start_token_id=${tr_prefix_token_info[node_id]}
                tr_graft_start_path_token=${tr_prefix_token_info[physical_full_key]}
                tr_graft_prefix=$tr_graft_start_path_token
            fi
            ;;
        esac
        return 0
    }
    
    x_walk "$tr_sub_name" "" x_graft_walk_cb || return $?
    tr_graft_reply=("$tr_graft_start_token_id" "$tr_graft_start_path_token")
    REPLY=${tr_graft_reply[*]@Q}
}

#-------------------------------------------------------------------------------

# 校验物理键格式：非空、不以 $X 开头、不含连续的 $X、必须含 $X。
# @in  $1=物理键字符串
# @ret 0=OK  7=X_RET_ENUM_KEY_IS_NULL
x_key_is_invalid ()
{
    if [[ "$1" == "$X"* ]] ||
        [[ "$1" == *"$X$X"* ]] ||
        [[ "$1" == "$X" ]] ||
        [[ "$1" != *"$X" ]] ; then
        die ERR "key:${1@Q} is null or invalid!"
        return $X_RET_ENUM_KEY_IS_NULL
    else
        return $X_RET_ENUM_OK
    fi
}

#-------------------------------------------------------------------------------

# Insert with public prefix
# x_qinserts t1 common "{prefix1}$X{prefix2}$X" "[0]$X" "array_value1" \
#                                          "[1]$X" "array_value2" \
#                                          "[2]$X" "array_value3"
#
# 批量带公共前缀插入多个叶，自动处理首个 '()' 语义转 '[]' 加速后续插入。
# @in  $1=树名  $2=返回模式(leaves/common)  $3=公共前缀 token 串
#      $4..=成对的 {key value}
# @out REPLY=按返回模式拼接的 "node_id physical_key ..." 列表
# @ret 0=OK  其他=透传 x_insert 的返回码
x_qinserts ()
{
    REPLY=
    # local - ; set +x
    local tr_t_name=$1
    # leaves or common
    local tr_return_mode=$2
    local tr_common_prefix=$3
    shift 3
    # 这里有个坑 ("${@}") 这种接收参数的方式
    # windows 的 msys2 环境上会把 \r 给吞掉
    #
    # \r 并非被 Bash 的语法逻辑丢弃，而是在从 Windows 命令行到内部 POSIX 环境的
    # 转换阶段，被 MSYS2 的运行时层（msys-2.0.dll）给剥离了。
    # 这是 MSYS2 的一个历史特性：为了处理 Windows 的 CRLF 换行问题，MSYS2 的运行
    # 时层会假定出现在参数或输入中的 \r 可能是 Windows 行尾的一部分，从而进行
    # “自动清理”。不过，真正让 \r 被精准针对的，是2024年7月27日的 MSYS2 版本更
    # 新，它改变了将 Windows 宽字符命令行参数翻译为内部参数的方式。在这个新的转
    # 换逻辑中，\r 被当作需要剥离的字符，而 \n 和空格则被视为合法的数据内容被保留了下来。
    # local -a tr_insert_kv=("${@}")
    local -a tr_insert_kv=()
    while (($#)) ; do
        tr_insert_kv[${#tr_insert_kv[@]}]=$1
        shift
    done


    local tr_insert_info
    local -a tr_qinserts_reply=()

    # If the number of parameters is 1, it means only writing a single value, not a key
    ((${#tr_insert_kv[@]}==1)) && {
    #@if current_shell_process_replace==1
        REPLY=${|x_insert "$tr_t_name" "$tr_common_prefix" "${tr_insert_kv[0]}";}
        return $?
    #@endif
    #@if current_shell_process_replace==0
        x_insert "$tr_t_name" "$tr_common_prefix" "${tr_insert_kv[0]}"
        local tr_x_qinserts_ret=$? ; REPLY=$REPLY
        return $tr_x_qinserts_ret
    #@endif
    }

    ((${#tr_insert_kv[@]}<2)) && return $X_RET_ENUM_OK

    # The first insertion uses the original KEY
        #@if current_shell_process_replace==1
    tr_insert_info=${|x_insert "$tr_t_name" "$tr_common_prefix${tr_insert_kv[0]}" "${tr_insert_kv[1]}";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    x_insert "$tr_t_name" "$tr_common_prefix${tr_insert_kv[0]}" "${tr_insert_kv[1]}" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_insert_info}"
        #@endif
    local -a "tr_insert_info=($tr_insert_info)"
    [[ "$tr_return_mode" == 'leaves' ]] && tr_qinserts_reply+=("${tr_insert_info[@]}")
    

    # The subsequent insertion prefix uses the physical key and brings the node id for acceleration.
    local tr_k_index=2 tr_v_index=3

        #@if current_shell_process_replace==1
    tr_common_prefix=${|_tokens_insert_to_overwrite "$tr_common_prefix";}
    local -A "tr_prefix_token_info=(${|_x_token_to_node_id "$tr_t_name" "$tr_common_prefix";})"
        #@endif
        #@if current_shell_process_replace==0
    _tokens_insert_to_overwrite "$tr_common_prefix" ; eval "${_ret_s_/o/tr_common_prefix}"
    _x_token_to_node_id "$tr_t_name" "$tr_common_prefix" ; eval "${_ret_A/o/tr_prefix_token_info}"
        #@endif
    tr_common_prefix=${tr_prefix_token_info[physical_full_key]}
    local tr_common_id=${tr_prefix_token_info[node_id]}
    [[ "$tr_return_mode" == 'common' ]] && {
        tr_qinserts_reply=("$tr_common_id" "$tr_common_prefix")

        REPLY=${tr_qinserts_reply[*]@Q}
    }

    for((tr_k_index=2,tr_v_index=3;tr_v_index<${#tr_insert_kv[@]};tr_k_index+=2,tr_v_index+=2)) ; do
            #@if current_shell_process_replace==1
        tr_insert_info=${|x_insert "$tr_t_name" \
                                    "${tr_common_prefix}${tr_insert_kv[tr_k_index]}" \
                                    "${tr_insert_kv[tr_v_index]}" \
                                    "$tr_common_id" \
                                    "$tr_common_prefix";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        x_insert "$tr_t_name" \
                    "${tr_common_prefix}${tr_insert_kv[tr_k_index]}" \
                    "${tr_insert_kv[tr_v_index]}" \
                    "$tr_common_id" \
                    "$tr_common_prefix" || eval "$_ret_e"
        eval "${_ret_s_/o/tr_insert_info}"
            #@endif
        
        local -a "tr_insert_info=($tr_insert_info)"

        [[ "$tr_return_mode" == 'leaves' ]] && tr_qinserts_reply+=("${tr_insert_info[@]}")
    done

    REPLY=${tr_qinserts_reply[*]@Q}
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# Returns an array of node IDs
# 批量插入叶（参数顺序：{k v} 成对在前，树名在最后）。
# @in  $1=第一个键  $2=第一个值  ...  最后一个参数=树名
# @out REPLY=叶节点 "node_id physical_key" 列表
# @ret 0=OK  其他=透传 x_insert 的返回码
x_inserts ()
{
    REPLY=
    # local - ; set +x
    set -- "${@:2}" "$1"
    local tr_insert_info
    local -a tr_inserts_reply=()
    while (($#>1)) ; do
            #@if current_shell_process_replace==1
        tr_insert_info=${|x_insert "${!#}" "$1" "$2";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        x_insert "${!#}" "$1" "$2" || eval "${_ret_e}"
        eval "${_ret_s_/o/tr_insert_info}"
            #@endif
        shift 2
        local -a "tr_insert_info=($tr_insert_info)"

        tr_inserts_reply+=("${tr_insert_info[@]}")
    done
    REPLY=${tr_inserts_reply[*]@Q}
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# Quickly push a series of leaf keys into an existing physical key array and
# return an array of their IDs and physical keys (ID physical keys) tuples
#
# 快速向现有数组节点追加多个叶，只返回新节点 ID 列表。
# @in  $1=树名  $2=数组节点 ID 或空  $3=物理前缀  $4..=叶值列表
# @out REPLY=新叶 "node_id physical_key" 列表
# @ret 0=OK
x_push_leaf_fast ()
{
    REPLY=
    local -n tr_t=$1
    local tr_node=$2 tr_prefix=$3 tr_leaf= tr_token=
    local -i tr_child_id

    local -a tr_ret=()

    [[ -z "$tr_node" ]] && {
            #@if current_shell_process_replace==1
        local -A "tr_node_info=(${|_x_token_to_node_id "$1" "$tr_prefix";})"
            #@endif
            #@if current_shell_process_replace==0
        _x_token_to_node_id "$1" "$tr_prefix" ; eval "${_ret_A/o/tr_node_info}"
            #@endif
        tr_node=${tr_node_info[node_id]}
    }

    local -a "tr_children=(${tr_t[$tr_node.s]})"

    # Traverse the list of leaves that need to be pushed
    for tr_leaf in "${@:4}" ; do
        tr_child_id=${tr_t[max_index]}
        tr_token="<$tr_child_id>"
        tr_children+=("$tr_token")
        ((tr_t[max_index]++))
        case "$tr_leaf" in
        $X_VALUE_NULL_OBJ) tr_t[$tr_child_id.t]=$X_TYPE_OBJ ;;
        $X_VALUE_NULL_ARR) tr_t[$tr_child_id.t]=$X_TYPE_ARR ;;
        *)
            tr_t[$tr_child_id.k]=$tr_prefix$tr_token$X
            tr_t[$tr_prefix$tr_token$X]=$tr_leaf
            ;;
        esac
        # ["1.c.<2>"]="2"
        # array not need to contains child
        # tr_t[$tr_node.c.$tr_token]=$tr_child_id
        tr_ret+=("$tr_child_id" "$tr_prefix$tr_token$X")
    done
    
    # Update the parent node's children list
    tr_t[$tr_node.s]=${tr_children[*]@Q}
    REPLY=${tr_ret[*]@Q}
}

#-------------------------------------------------------------------------------

#-------------------------------------------------------------------------------

# Only insert and do not return any data
#
# 在已存在的容器节点下批量挂子节点 / 更新叶子值（仅插入不返回）——最快写入路径。
# 零校验：不解析路径、不创建中间节点、不检查父节点类型、不检查 token 类型。
#
# 支持的 token：
#   '{k}'  —— 对象键。挂为父节点的直接子节点；若已存在则更新其值。
#   '<id>' —— 物理 id。分两种情况：
#              · 该 id 是叶子 / 预分配节点（物理 path 已存在）：
#                守卫命中，快速更新其值，不建子节点 —— 可用于批量改一批已知叶子的值。
#              · 该 id 是容器节点（无物理 path 值）：
#                守卫失效，会创建影子节点、max_index 虚增、children 重复追加。
#                函数不报错，但结构会坏，调用方须避免。
#
# 不支持的 token：
#   '[i]' / '()' —— 索引 token。会被当作对象键写入，路径与索引语义错位（不报错）。
#
# 调用方须保证：
#   - $2 是树中已存在的容器节点 ID（OBJ 或 ARR）
#   - $3 是该节点的物理全 key
#   - $4.. 的 token 为 '{k}'，或指向叶子/预分配节点的 '<id>'
# 需要校验/自动建中间节点请用 x_insert_dict 或 x_insert。
#
# 用法示例（批量挂一层对象键）：
#   local -A assoc=(['{1 2}']='a b' ['{3 4}']='c d')
#   x_insert_token_dict my_tree "$node_id" "$physical_prefix" "${assoc[@]@k}"
#
# 用法示例（批量更新一批已知叶子 id 的值）：
#   x_insert_token_dict my_tree "$node_id" "$physical_prefix" \
#       "<5>" "new_v5" "<6>" "new_v6"
#
# @in  $1=树名  $2=已存在的父节点 ID  $3=父节点物理全 key
#      $4..=token,value 交错（token 为 '{k}' 或叶子 '<id>'）
# @out REPLY 不变
# @ret 0=OK
x_insert_token_dict ()
{
    local -n tr_t=$1

    local tr_node=$2 tr_prefix=$3
    local -a tr_token_values=("${@:4}")
    local tr_path_key=
    local -a tr_tokens=()
    local -i tr_index=0
    local tr_child_key tr_child_id
    local tr_token tr_value

    for((tr_index=0;tr_index<${#tr_token_values[@]};tr_index+=2)) ; do
        tr_token=${tr_token_values[tr_index]}
        tr_value=${tr_token_values[tr_index+1]}
        tr_path_key=$tr_prefix$tr_token$X

        [[ ${tr_t[$tr_path_key]+_} ]] && {
            tr_t[$tr_path_key]=$tr_value
            continue
        }

        tr_child_id="${tr_t[max_index]}" ; ((tr_t[max_index]++))
        if [[ "$tr_token" != '<'*'>' ]] ; then
            tr_t["$tr_node.c.$tr_token"]=$tr_child_id
        fi
        tr_tokens+=("$tr_token")

        case "$tr_value" in
        "$X_VALUE_NULL_ARR")
            tr_t[$tr_child_id.t]="$X_TYPE_ARR"
            ;;
        "$X_VALUE_NULL_OBJ")
            tr_t[$tr_child_id.t]="$X_TYPE_OBJ"
            ;;
        *)
            tr_t[$tr_child_id.k]=$tr_path_key
            tr_t["$tr_path_key"]=$tr_value
            ;;
        esac
    done
    
    ((${#tr_tokens[@]})) && tr_t[$tr_node.s]+=" ${tr_tokens[*]@Q}"
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# Only insert and do not return any data
#
# 批量挂子节点（仅插入不返回）——全库最快的写入路径，零校验。
#
# 用途：父节点已确定、且父节点确实是容器时，一次性把一批
#       "对象键 '{k}' → 值" 作为它的直接子节点挂上。
#       适合扁平字典层（如从关联数组批量灌入一层 KV）。
#
# 本函数不做任何拦截：
#   - 不解析路径，不创建中间节点
#   - 不校验父节点是否存在、是否为容器
#   - 不校验 token 类型、不校验路径是否重复
#   调用方必须自行保证：
#     $2 是树中已存在的容器节点 ID（OBJ 或 ARR）
#     $3 是该节点的物理全 key（与 $2 对应，用于拼子节点路径）
#     $4.. 的每个 token 均为对象键 '{k}'
#
# 传错的后果（函数不报错，但结构会坏）：
#   - token 传 '<id>'（容器节点）：$tr_path_key 不存在于树中，
#     守卫失效，会创建影子节点、max_index 虚增、children 重复追加
#   - token 传 '[i]' / '()'：会当作对象键写入，路径与索引语义错位
#   - 父节点传叶子：会把子节点挂到叶子节点上，产生 .k 与 .s 混合
#   以上均需调用方避免。需要校验或自动建中间节点时，请用
#   x_insert_dict（单点深层写，轻校验）或 x_insert（完整校验，返回 node_id）。
#
# 与 x_insert_dict 的区别：
#   x_insert_dict       —— 接受完整物理路径，逐级自动建 '{k}' 节点，单点写入
#   x_insert_token_dict —— 父节点已定，只铺一层，批量写入，零校验、最快
#
# 用法示例：
#   local -A assoc=(['{1 2}']='a b' ['{3 4}']='c d')
#   x_insert_token_dict my_tree "$node_id" "$physical_prefix" "${assoc[@]@k}"
#
# @in  $1=树名  $2=已存在的父节点 ID  $3=父节点物理全 key
#      $4..=token,value 交错（token 必须是 '{k}'）
# @out REPLY 不变
# @ret 0=OK
x_insert_dict ()
{
    local -n tr_t=$1
    local tr_full_key=$2

    local tr_value=$3
    local tr_start_node_id=${4:-"$X_ROOT_ID"}
    local tr_path_key=${5:-""}

    [[ ${tr_t["$tr_full_key"]+_} ]] && {
        tr_t["$tr_full_key"]=$tr_value
        return ${X_RET_ENUM_OK}
    }

    local tr_token tr_child_key tr_child_id tr_tokens_str

    # Here tr_full_key needs to remove the tr_path_key prefix and start traversing
        #@if current_shell_process_replace==1
    tr_tokens_str=${|_split_tokens "${tr_full_key#"$tr_path_key"}" 1;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _split_tokens "${tr_full_key#"$tr_path_key"}" 1 || eval "${_ret_e}"
    eval "${_ret_s_/o/tr_tokens_str}"
        #@endif
    local -a "tr_tokens=($tr_tokens_str)"

    local tr_node=${tr_start_node_id}

    for tr_token in "${tr_tokens[@]}" ; do
        local tr_token_pack="${tr_token:0:1}${tr_token: -1}"
        case "$tr_token_pack" in
        '<>')
            # 物理 id：直接取，必须已存在。物理 id 不能凭空创建，
            # 出现不存在的 <id> 说明调用者传了非物理路径或结构已坏。
            tr_child_id=${tr_token:1:-1}
            if [[ -z "${tr_t[$tr_child_id.k]+_}" ]] && \
               [[ -z "${tr_t[$tr_child_id.t]+_}" ]] && \
               [[ -z "${tr_t[$tr_child_id.s]+_}" ]] ; then
                die ERR "node:${tr_node}(token:${tr_token@Q}) is not exist."
                return $X_RET_ENUM_KEY_IS_NOTFOUND
            fi
            ;;
        '{}')
            # 快速定型：只补缺失的 OBJ 类型，不做叶子/ARR 校验（快速语义）
            [[ -z "${tr_t[$tr_node.t]+_}" ]] && tr_t[$tr_node.t]="$X_TYPE_OBJ"

            # 对象键：查 .c，缺失则建 .c
            tr_child_key="$tr_node.c.$tr_token"
            tr_child_id="${tr_t[$tr_child_key]}"
            [[ -z "$tr_child_id" ]] && {
                tr_child_id="${tr_t[max_index]}" ; ((tr_t[max_index]++))
                tr_t[$tr_node.s]+=" ${tr_token@Q}"
                tr_t["$tr_child_key"]=$tr_child_id
            }
            ;;
        *)
            # [i] / () 不在本函数支持范围：本函数不做索引解析
            die ERR "token:${tr_token@Q} is not supported by x_insert_dict (only '{k}' or '<id>')."
            return $X_RET_ENUM_KEY_IS_INVALID
            ;;
        esac

        tr_node=$tr_child_id
        tr_path_key+="$tr_token$X"
    done

    case "$tr_value" in
    "$X_VALUE_NULL_ARR")
        tr_t[$tr_node.t]="$X_TYPE_ARR"
        return $X_RET_ENUM_OK
        ;;
    "$X_VALUE_NULL_OBJ")
        tr_t[$tr_node.t]="$X_TYPE_OBJ"
        return $X_RET_ENUM_OK
        ;;
    *)
        tr_t[$tr_node.k]=$tr_path_key
        tr_t["$tr_path_key"]=$tr_value
        return $X_RET_ENUM_OK
    esac
}

#-------------------------------------------------------------------------------

# Returns the inserted node ID, used by external or object tracking systems to track the ID of the object.
#
# 核心插入：把 $3 插入到 $1 的 $2 位置，支持自动创建路径节点。
# @in  $1=树名  $2=物理全 key  $3=值（X_VALUE_NULL_OBJ/ARR 或叶值）
#      $4=起始节点 ID（默认 ROOT）  $5=已遍历物理前缀（默认空）
# @out REPLY=列表 "node_id physical_key"
# @ret 0=OK  4=X_RET_ENUM_KEY_IS_INVALID  8=X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
x_insert ()
{
    REPLY=
    # local - ; set +x
    local -n tr_t=$1
    local tr_full_key=$2
    local -i tr_array_index=-1
    local -a tr_insert_reply=()

    x_key_is_invalid "$tr_full_key" || return $?

    local tr_value=$3
    local tr_start_node_id=${4:-"$X_ROOT_ID"}
    local tr_path_key=${5:-""}

    if [[ -n "$tr_path_key" ]] ; then
        x_key_is_invalid "$tr_path_key" || return $?

        [[ "$tr_path_key" == *"]$X"* || "$tr_path_key" == *")$X"* ]] && {
            die ERR "path key:${tr_path_key@Q} is not physical key."
            return $X_RET_ENUM_KEY_IS_INVALID
        }
    fi

    # If it is a leaf node, update the value directly
    if  [[ ${tr_t["$tr_full_key"]+_} ]] &&
        [[ "$tr_value" != "$X_VALUE_NULL_ARR" ]] &&
        [[ "$tr_value" != "$X_VALUE_NULL_OBJ" ]] ; then
        tr_t["$tr_full_key"]=$tr_value
            #@if current_shell_process_replace==1
        local -A "tr_node_info=(${|_x_token_to_node_id "$1" "$tr_full_key";})"
            #@endif
            #@if current_shell_process_replace==0
        _x_token_to_node_id "$1" "$tr_full_key" ; eval "${_ret_A/o/tr_node_info}"
            #@endif
        tr_insert_reply=("${tr_node_info[node_id]}" "${tr_node_info[physical_full_key]}")
        REPLY=${tr_insert_reply[*]@Q}
        return ${X_RET_ENUM_OK}
    fi

    local tr_token tr_child_key tr_child_id tr_tokens_str

    # Here tr_full_key needs to remove the tr_path_key prefix and start traversing
    tr_tokens_str=${tr_full_key#"$tr_path_key"}
    [[ -n "$tr_path_key" && "$tr_tokens_str" == "$tr_full_key" ]] && {
        die ERR "path_key:${tr_path_key@Q} is not part of full key:${tr_full_key@Q}."
        return $X_RET_ENUM_KEY_IS_INVALID
    }
        #@if current_shell_process_replace==1
    tr_tokens_str=${|_split_tokens "$tr_tokens_str" 1;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _split_tokens "$tr_tokens_str" 1 || eval "$_ret_e"
    eval "${_ret_s_/o/tr_tokens_str}"
        #@endif
    local -a "tr_tokens=($tr_tokens_str)"

    local tr_node=${tr_start_node_id}

    # Record the ID key of the created intermediate node, all need to be deleted
    local -A tr_tmp_node_ids_map=()

    for tr_token in "${tr_tokens[@]}" ; do
        local tr_key="${tr_t[$tr_node.k]}"
        local -i tr_array_index=-1
        local tr_token_pack="${tr_token:0:1}${tr_token: -1}"
        case "$tr_token_pack" in
        '{}') 
            # The previous level must be null or obj or nothing (only nodes have tags)
            if [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_OBJ" ]] ; then
                :
            elif [[ -n "$tr_key" ]] && [[ "${tr_t[$tr_key]}" == "$X_VALUE_NULL" ]] ; then
                # Become path empty obj
                unset -v 'tr_t[$tr_node.k]'
                unset -v 'tr_t[$tr_key]'
                tr_t[$tr_node.t]=$X_TYPE_OBJ
            # If tr_node has only node tags, then turn it into empty obj
            elif [[ ${tr_tmp_node_ids_map[$tr_node]+_} ]] &&
                [[ -z ${tr_t[$tr_node.k]+_} ]] &&
                [[ -z ${tr_t[$tr_node.s]+_} ]] &&
                [[ "${tr_t[$tr_node.t]}" != "$X_TYPE_ARR" ]] ; then
                tr_t[$tr_node.t]=$X_TYPE_OBJ
            else
                die ERR "node:${tr_node}(token:${tr_token@Q}) is not obj or null."
                return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
            fi
            ;;
        '[]'|'()')
            # If the previous layer is null, create an empty array path node.
            if [[ -n "$tr_key" ]] && [[ "${tr_t[$tr_key]}" == "$X_VALUE_NULL" ]] ; then
                unset -v 'tr_t[$tr_node.k]'
                unset -v 'tr_t[$tr_key]'
                tr_t[$tr_node.t]=$X_TYPE_ARR
            # Contains only node existence flags
            elif [[ ${tr_tmp_node_ids_map[$tr_node]+_} ]] &&
                [[ -z ${tr_t[$tr_node.k]+_} ]] &&
                [[ -z ${tr_t[$tr_node.s]+_} ]] &&
                [[ "${tr_t[$tr_node.t]}" != "$X_TYPE_OBJ" ]] ; then
                tr_t[$tr_node.t]=$X_TYPE_ARR
            fi

            [[ "${tr_t[$tr_node.t]}" != "$X_TYPE_ARR" ]] && {
                die ERR "node:${tr_node}(token:${tr_token@Q}) up layer is not array or null."
                return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
            }

            # Fill incomplete null nodes and update tr_token
            local -a "tr_array=(${tr_t[$tr_node.s]})"
            local -i tr_i tr_array_len=${#tr_array[@]}
            local -a tr_add_token=()
            
            local tr_token_ret
                #@if current_shell_process_replace==1
            tr_token=${|_negative_token_to_positive "$tr_token" "$tr_array_len" "$tr_node";} ; tr_token_ret=$?
                #@endif
                #@if current_shell_process_replace==0
            _negative_token_to_positive "$tr_token" "$tr_array_len" "$tr_node" ; tr_token_ret=$?
            eval "${_ret_s_/o/tr_token}"
                #@endif
            ((tr_token_ret)) && {
                return $tr_token_ret
            }

            for((tr_i=tr_array_len;tr_i<${tr_token:1:-1};tr_i++)) ; do
                local tr_new_id=${tr_t[max_index]} ; ((tr_t[max_index]++))
                # tr_tmp_node_ids_map[$tr_new_id]=1
                tr_t[$tr_new_id.k]="$tr_path_key<$tr_new_id>$X"
                tr_t["$tr_path_key<$tr_new_id>$X"]="$X_VALUE_NULL"
                # Attach parent node children
                # ["1.c.<2>"]="2"
                # array not need to contains child
                # tr_t["$tr_node.c.<$tr_new_id>"]=$tr_new_id
                tr_add_token+=("<$tr_new_id>")
            done

            tr_array_index=${tr_token:1:-1}

            if ((${#tr_add_token[@]})) ; then
                # Populate the parent node's children list
                tr_array=("${tr_array[@]:0:tr_array_len}" "${tr_add_token[@]}" "${tr_array[@]:tr_array_len}")
                tr_t[$tr_node.s]=${tr_array[*]@Q}
                tr_token="<${tr_t[max_index]}>"
            else
                tr_token="${tr_array[tr_array_index]}"

                if [[ -z "$tr_token" ]] ||
                   [[ "$tr_token_pack" == '()' ]] ; then
                    tr_token="<${tr_t[max_index]}>"
                fi
            fi
            ;;
        '<>')
            # The previous level must be an array and elements must exist
            if [[ "${tr_t[$tr_node.t]}" != "$X_TYPE_ARR" ]] ; then
                die ERR "node:${tr_node}(token:${tr_token@Q}) up layer is not array."
                return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
            fi

            # <id> 中的 id 是全局唯一节点 id，直接检查节点是否活跃即可
            local tr_ref_id=${tr_token:1:-1}
            if [[ -z "${tr_t[$tr_ref_id.k]+_}" ]] && \
               [[ -z "${tr_t[$tr_ref_id.t]+_}" ]] && \
               [[ -z "${tr_t[$tr_ref_id.s]+_}" ]] ; then
                die ERR "node:${tr_node}(token:${tr_token@Q}) is not exist."
                return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
            fi
            ;;
        esac
            
        if [[ "$tr_token" == '<'*'>' ]] ; then
            tr_child_id=${tr_token:1:-1}
        else
            tr_child_key="$tr_node.c.$tr_token"
            tr_child_id="${tr_t[$tr_child_key]}"
        fi

        # Child node does not exist -> create
        #   - 非 <id> token：按 .c. 查不到
        #   - <id> token：节点三个标记键都不存在（预分配节点有 .k）
        if [[ -z "$tr_child_id" || ( "$tr_token" == '<'*'>' &&
            -z "${tr_t[${tr_token:1:-1}.k]+_}"  &&
            -z "${tr_t[${tr_token:1:-1}.t]+_}"  &&
            -z "${tr_t[${tr_token:1:-1}.s]+_}" ) ]] ; then
            if [[ "$tr_token" == '<'*'>' ]] ; then
                # 全新 <id> token（来自 tr_token="<max_index>"）：id 就是 max_index 当前值
                tr_child_id=${tr_token:1:-1}
                ((tr_t[max_index]++))
            else
                tr_child_id="${tr_t[max_index]}" ; ((tr_t[max_index]++))
                tr_t["$tr_child_key"]=$tr_child_id    # 对象键才建 .c.
            fi
            tr_tmp_node_ids_map[$tr_child_id]=1

            local -a "tr_children=(${tr_t[$tr_node.s]})"
            
            if ((tr_array_index!=-1)) ; then
                if [[ "$tr_token_pack" == '()' ]] ; then
                    tr_children=("${tr_children[@]:0:tr_array_index}" "$tr_token" "${tr_children[@]:tr_array_index}")
                else
                    tr_children[$tr_array_index]="$tr_token"
                fi
            else
                # Descending ASCII lexicographic order
                # array_sorted_insert tr_children "$tr_token" '<'
                tr_children+=("$tr_token")
            fi

            tr_t[$tr_node.s]=${tr_children[*]@Q}
        fi

        tr_node=$tr_child_id
        tr_path_key+="$tr_token$X"
    done

    # Write leaf key
    # Leaf nodes may be empty obj or empty array
    # Leaf nodes are set to provide better coverage.
    # Intermediate nodes are strictly limited. x_graft also maintain the same semantics.
    # If it is found at the end that there are children at the inserted place,
    # it proves to be an existing structure node,
    # and the leaf is not allowed to be inserted.
    [[ -n "${tr_t[$tr_node.s]}" ]] && {
        die ERR "node:${tr_node}(token:${tr_token@Q}) have children."
        return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
    }

    # If it is found at the end that the inserted place is an empty obj or an
    # empty array, but the content to be inserted does not match,
    # an error will be reported.
    if  [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_OBJ" ]] &&
        [[ "$tr_value" != "$X_VALUE_NULL_OBJ" ]] ; then
        die ERR "node:${tr_node}(token:${tr_token@Q}) is null obj,but insert is not."
        return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
    fi

    if  [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_ARR" ]] &&
        [[ "$tr_value" != "$X_VALUE_NULL_ARR" ]] ; then
        die ERR "node:${tr_node}(token:${tr_token@Q}) is null array,but insert is not."
        return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
    fi

    local tr_new_type
    case "$tr_value" in
        "$X_VALUE_NULL_ARR")   tr_new_type="$X_TYPE_ARR" ;;
        "$X_VALUE_NULL_OBJ")   tr_new_type="$X_TYPE_OBJ" ;;
        *)
            tr_t[$tr_node.k]=$tr_path_key
            tr_t["$tr_path_key"]=$tr_value
            # 返回节点 ID
            tr_insert_reply=("$tr_node" "$tr_path_key")
            REPLY=${tr_insert_reply[*]@Q}
            return $X_RET_ENUM_OK
    esac

    # The current leaf strings, values and bool can be overwritten into
    # empty objects and empty arrays.
    # Leaves null are naturally OK
    local tr_key="${tr_t[$tr_node.k]}"
    unset -v 'tr_t[$tr_node.k]'
    [[ -n "$tr_key" ]] && unset -v 'tr_t[$tr_key]'
    tr_t[$tr_node.t]="$tr_new_type"
    tr_insert_reply=("$tr_node" "$tr_path_key")
    REPLY=${tr_insert_reply[*]@Q}
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# 打印整棵树（调试用）。
# @in  $1=树名  $2=起始物理全 key（空=根）  $3=缩进宽度（默认 4）
#      $4=打印掩码（bit0=ID，bit1=值，bit2=数组索引，默认 0b111）
# @ret 0
x_dump ()
{
    # local - ; set +x
    local tr_t_name=$1
    local -n tr_t=$1
    local tr_full_key=$2
    # bit0: id is need to print
    # bit1: value is need to print
    local tr_indent_cnt=${3:-4}
    local tr_print_mask=${4:-$((2#111))}
    # 0: id 1: value 2: array index
    local tr_id_need_print tr_value_need_print
    local tr_print_array_index
    var_bitmap_unpack   "$tr_print_mask" \
                        "tr_id_need_print:0" \
                        "tr_value_need_print:1" \
                        "tr_print_array_index:2"

    local tr_node tr_node_info
        #@if current_shell_process_replace==1
    tr_node_info=${|_x_token_to_node_id "$tr_t_name" "$tr_full_key";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_token_to_node_id "$tr_t_name" "$tr_full_key" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_node_info}"
        #@endif
    local -A "tr_node_info=($tr_node_info)"
    tr_node=${tr_node_info[node_id]}

        #@if current_shell_process_replace==1
    local tr_indent=${|str_repeat ' ' "$tr_indent_cnt";}
        #@endif
        #@if current_shell_process_replace==0
    str_repeat ' ' "$tr_indent_cnt" ; eval "${_ret_s/o/tr_indent}"
        #@endif

    printf '%s(%s) -> %s\n' "$tr_t_name" "$tr_node" "${tr_node_info[physical_full_key]}"

    [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_OBJ" ]] &&
    [[ -z "${tr_t[$tr_node.s]}" ]] && {
        local XDump_tr_value_p
        str_escape_keep_nl "$X_VALUE_NULL_OBJ" XDump_tr_value_p
        printf '%s%s\n' "$tr_indent" "$XDump_tr_value_p"
        printf '%smax_index => %s\n' "$tr_indent" "${tr_t[max_index]}"
        return
    }

    [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_ARR" ]] &&
    [[ -z "${tr_t[$tr_node.s]}" ]] && {
        local XDump_tr_value_p
        str_escape_keep_nl "$X_VALUE_NULL_ARR" XDump_tr_value_p
        printf '%s%s\n' "$tr_indent" "$XDump_tr_value_p"
        printf '%smax_index => %s\n' "$tr_indent" "${tr_t[max_index]}"
        return
    }

    _x_dump  "$tr_t_name" "$tr_node" "$tr_indent_cnt" "$tr_indent" \
                "$tr_id_need_print" "$tr_value_need_print" \
                "$tr_print_array_index"
    printf '%smax_index => %s\n' "$tr_indent" "${tr_t[max_index]}"
}

#-------------------------------------------------------------------------------

# 递归打印内部引擎，由 x_dump 调用，不建议直接使用。
_x_dump ()
{
    local -n tr_t=$1
    local tr_node=$2
    local tr_indent_cnt=$3
    local tr_indent=$4
    local tr_id_need_print=$5
    local tr_value_need_print=$6
    local tr_print_array_index=$7
        #@if current_shell_process_replace==1
    local tr_indent_new=${|str_repeat ' ' "$tr_indent_cnt";}
        #@endif
        #@if current_shell_process_replace==0
    str_repeat ' ' "$tr_indent_cnt" ; eval "${_ret_s/o/tr_indent_new}"
        #@endif
    tr_indent_new+="$tr_indent"

    # Traverse children
    local -a "tr_children=(${tr_t[$tr_node.s]})"
    local -i tr_index=0

    # There cannot be duplicate elements in the array
    # The output order of hash keys is output in accordance with the hash bucket.
    # If a conflict occurs in the bucket, it is output in the order of the linked list.
    # So the order here is very unstable. It is OK when there are few elements,
    # but if there are too many elements,hash table will trigger expansion,
    # and if there are too few elements, the hash bucket will trigger shrinkage.
    # So here is just an approximate fix, It is not absolutely fixed. This
    # feature can be used to stabilize the display key when the number of
    # elements is small.
    [[ "${tr_children[0]}" == '{'* ]] && {
        local tr_children_sorted=
        printf -v tr_children_sorted '[%s]= ' "${tr_children[@]@Q}"
        local -A "tr_children_sorted=($tr_children_sorted)"
        tr_children=("${!tr_children_sorted[@]}")
    }

    local tr_token tr_mark='=>'
    for tr_token in "${tr_children[@]}"; do
        if [[ "$tr_token" == '<'*'>' ]] ; then
            local tr_child_id=${tr_token:1:-1}
        else
            local tr_child_id="${tr_t[$tr_node.c.$tr_token]}"
        fi
        local tr_child_id_p='' tr_value_p=''
        local tr_token_safe tr_token_disp

        tr_mark='=>'
        if [[ "${tr_t[$tr_node.t]}" == "${X_TYPE_ARR}" ]]; then
            tr_mark='='
            ((tr_print_array_index)) && tr_token=$tr_index || tr_token='o'
            # 数组 token 是索引或 'o'，无危险字符，直接透传
            tr_token_safe=$tr_token
            tr_token_disp=$tr_token
        else
            # 字典键：统一走自定义转义（保留 \n，内部的 }转义），不再用 %q/@Q
            local _XDump_tr_token_safe
            str_escape_key "${tr_token:1:-1}" _XDump_tr_token_safe
            tr_token_safe="{$_XDump_tr_token_safe}"
            # 多行键的续行加 | 补位：| 与第一行的 { 对齐，
            # 使行首空格明确属于键内容而非缩进
            tr_token_disp="${tr_token_safe//$'\n'/$'\n'$tr_indent|}"
        fi

        ((tr_id_need_print)) && tr_child_id_p="($tr_child_id)"

        if [[ -n "${tr_t[$tr_child_id.k]}" ]]; then
            local tr_key=${tr_t[$tr_child_id.k]}
            local tr_value=${tr_t["$tr_key"]}
            ((tr_value_need_print)) && {
                local tr_value_indent="${tr_token_safe}"
                ((tr_id_need_print)) && tr_value_indent+="(${tr_child_id})"
                tr_value_indent=${tr_value_indent##*$'\n'}
                local _XDump_w ; str_display_width "$tr_value_indent" _XDump_w
                printf -v tr_value_indent '%*s' "$_XDump_w" ''

                # 多行键最后一行多了 |，值续行补偿加一个空格
                [[ $tr_token_safe == *$'\n'* ]] && tr_value_indent+=" "
                # 值除了第一行其它的行都由 | 开头
                if [[ "$tr_mark" == '=' ]]; then
                    tr_value_indent+="${tr_indent}  |"
                else
                    tr_value_indent+="${tr_indent}   |"
                fi
                tr_value_p="${tr_value//$'\n'/$'\n'$tr_value_indent}"
                local _XDump_tr_value_p
                str_escape_keep_nl "$tr_value_p" _XDump_tr_value_p
                tr_value_p=$_XDump_tr_value_p
            }

            printf '%s%s%s %s %s\n' \
                "$tr_indent" \
                "$tr_token_disp" \
                "$tr_child_id_p" \
                "$tr_mark" \
                "$tr_value_p"
        elif [[ "${tr_t[$tr_child_id.t]}" == "$X_TYPE_ARR" ]] && [[ -z "${tr_t[$tr_child_id.s]}" ]] ; then
            ((tr_value_need_print)) && {
                local _XDump_tr_value_p
                str_escape_keep_nl "$X_VALUE_NULL_ARR" _XDump_tr_value_p
                tr_value_p=$_XDump_tr_value_p

            }

            printf '%s%s%s %s %s\n' \
                "$tr_indent" \
                "$tr_token_disp" \
                "$tr_child_id_p" \
                "$tr_mark" \
                "$tr_value_p"
        elif [[ "${tr_t[$tr_child_id.t]}" == "$X_TYPE_OBJ" ]] && [[ -z "${tr_t[$tr_child_id.s]}" ]] ; then
            ((tr_value_need_print)) && {
                local _XDump_tr_value_p
                str_escape_keep_nl "$X_VALUE_NULL_OBJ" _XDump_tr_value_p
                tr_value_p=$_XDump_tr_value_p
            }

            printf '%s%s%s %s %s\n' \
                "$tr_indent" \
                "$tr_token_disp" \
                "$tr_child_id_p" \
                "$tr_mark" \
                "$tr_value_p"
        else
            printf '%s%s%s\n' \
                "$tr_indent" \
                "$tr_token_disp" \
                "$tr_child_id_p"
        fi

        _x_dump "$1" "$tr_child_id" "$tr_indent_cnt" "$tr_indent_new" "$tr_id_need_print" "$tr_value_need_print" "$tr_print_array_index"
        ((tr_index++))
    done
}

#-------------------------------------------------------------------------------

# If we need to rearrange an array, it is very simple. We can use this function to
# get the node ID, then get the children through the node ID, and then rearrange
# the children and write them back to the original associative array. Because
# there is no addition or subtraction of elements, there is no deletion or addition
# of elements involved, only children need to be updated.
#
# 物理/索引 token 解析为节点 ID，可选返回子节点数或值。
# @in  $1=树名  $2=物理全 key  $3=需要 index_full_key(0/1)
#      $4=需要 child_cnt(0/1)  $5=需要 value(0/1)
# @out REPLY=关联数组 KV：node_id physical_full_key index_full_key type
#             child_cnt(可选) value(可选)
# @ret 0=OK  3=X_RET_ENUM_KEY_IS_NOTFOUND  4=X_RET_ENUM_KEY_IS_INVALID
_x_token_to_node_id ()
{
    REPLY=
    local -n tr_t=$1
    local tr_full_key=$2
    local -i    tr_need_index_full_key=${3:-0} \
                tr_need_child_cnt=${4:-0} \
                tr_need_value=${5:-0}
    local -A tr_node_info=()

    [[ -z "$tr_full_key" ]] && {
        # ROOT
        if ((tr_need_child_cnt)) ; then
            if [[ -n "${tr_t[$X_ROOT_ID.s]}" ]] ; then
                local -a "tr_children_tmp=(${tr_t[$X_ROOT_ID.s]})"
                tr_node_info[child_cnt]=${#tr_children_tmp[@]}
            else
                tr_node_info[child_cnt]=0
            fi
        fi

        tr_node_info+=(
            [node_id]="$X_ROOT_ID"
            [physical_full_key]=""
            [index_full_key]=""
            [type]=${tr_t[$X_ROOT_ID.t]}
            [value]=""
            )
            #@if at_k_var_substitution==1
        REPLY=${tr_node_info[*]@K}
            #@endif
            #@if at_k_var_substitution==0
        array_to_kv_q_str tr_node_info ; REPLY=$REPLY
            #@endif
        return ${X_RET_ENUM_OK}
    }

    x_key_is_invalid "$tr_full_key" || return $?

    local tr_tokens_str
        #@if current_shell_process_replace==1
    tr_tokens_str=${|_split_tokens "$tr_full_key";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _split_tokens "$tr_full_key" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_tokens_str}"
        #@endif
    local -a "tr_tokens=($tr_tokens_str)"
    local tr_node=$X_ROOT_ID tr_token tr_child_id tr_token_raw tr_real_full_key=''
    local tr_token_index= tr_index_full_key=
    for tr_token in "${tr_tokens[@]}" ; do
        tr_token_raw=$tr_token
            #@if current_shell_process_replace==1
        tr_token=${|tr_resolve_index_token "$1" "$tr_token" "$tr_node";}
            #@endif
            #@if current_shell_process_replace==0
        tr_resolve_index_token "$1" "$tr_token" "$tr_node" ; eval "${_ret_s_/o/tr_token}"
            #@endif
        [[ -z "$tr_token" ]] && {
            die ERR "node:${tr_node}(token:${tr_token_raw@Q}) is not found physical token!"
            return $X_RET_ENUM_KEY_IS_NOTFOUND
        }
        tr_real_full_key+="$tr_token$X"

        ((tr_need_index_full_key)) && {
                #@if current_shell_process_replace==1
            tr_token_index=${|tr_resolve_physical_token "$1" "$tr_token" "$tr_node";}
                #@endif
                #@if current_shell_process_replace==0
            tr_resolve_physical_token "$1" "$tr_token" "$tr_node" ; eval "${_ret_s_/o/tr_token_index}"
                #@endif
            [[ -z "$tr_token_index" ]] && {
                die ERR "node:${tr_node}(token:${tr_token_raw@Q}) is not found index token!"
                return $X_RET_ENUM_KEY_IS_NOTFOUND
            }
            tr_index_full_key+="$tr_token_index$X"
        }

        if [[ "$tr_token" == '<'*'>' ]] ; then
            tr_child_id=${tr_token:1:-1}
        else
            tr_child_id="${tr_t[$tr_node.c.$tr_token]}"
        fi
        [[ -z "$tr_child_id" ]] && {
            die ERR "node:${tr_node}(token:${tr_token@Q}) key is not found!"
            return "$X_RET_ENUM_KEY_IS_NOTFOUND"
        }
        tr_node=$tr_child_id
    done

    ((tr_need_index_full_key)) && tr_node_info[index_full_key]=$tr_index_full_key

    if ((tr_need_child_cnt)) ; then
        if [[ -n "${tr_t[$tr_node.s]}" ]] ; then
            local -a "tr_children_tmp=(${tr_t[$tr_node.s]})"
            tr_node_info[child_cnt]=${#tr_children_tmp[@]}
        else
            tr_node_info[child_cnt]=0
        fi
    fi

    ((tr_need_value)) && {
        local tr_key=${tr_t[$tr_node.k]} tr_value=
        [[ -n "$tr_key" ]] && tr_value=${tr_t["$tr_key"]}
        tr_node_info[value]=$tr_value
    }

    tr_node_info+=(
        [node_id]="$tr_node"
        [physical_full_key]="$tr_real_full_key"
        [type]=${tr_t[$tr_node.t]}
        )
#@if at_k_var_substitution==1
    REPLY=${tr_node_info[*]@K}
#@endif
#@if at_k_var_substitution==0
    array_to_kv_q_str tr_node_info ; REPLY=$REPLY
#@endif
    return ${X_RET_ENUM_OK}
}

#-------------------------------------------------------------------------------

# 删除节点（含全部子树）。空 key 会重置整棵树。
# @in  $1=树名  $2=物理全 key（空=清空树）
# @out REPLY=列表 "node_id physical_key"（被删除的子树根）
# @ret 0=OK  4=X_RET_ENUM_KEY_IS_INVALID
x_delete () 
{
    REPLY=
    # local - ; set +x
    local -n tr_t=$1
    local tr_full_key=$2
    local -a tr_delete_reply=()

    # Empty key is legal. Only ROOT nodes are reserved.
    [[ -z "$tr_full_key" ]] && {
            #@if current_shell_process_replace==1
        eval -- tr_t=(${|x_init "${tr_t[$X_ROOT_ID.t]}";})
            #@endif
            #@if current_shell_process_replace==0
        x_init "${tr_t[$X_ROOT_ID.t]}" ; eval -- tr_t=($REPLY)
            #@endif
        tr_delete_reply=("$X_ROOT_ID" "")
        REPLY=${tr_delete_reply[*]@Q}
        return ${X_RET_ENUM_OK}
    }

    x_key_is_invalid "$tr_full_key" || return $?
    
    local tr_tokens_str
#@if current_shell_process_replace==1
    tr_tokens_str=${|_split_tokens "$tr_full_key";} || return $?
#@endif
#@if current_shell_process_replace==0
    _split_tokens "$tr_full_key" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_tokens_str}"
#@endif
    local -a "tr_tokens=($tr_tokens_str)"

    # 2. Path search: go all the way from root to the node to be deleted
    local tr_node=$X_ROOT_ID
    local -a tr_path_nodes=("$tr_node")
    local -a tr_path_tokens=("")

    local tr_token tr_child_id tr_index
    for tr_token in "${tr_tokens[@]}"; do
            #@if current_shell_process_replace==1
        tr_token=${|tr_resolve_index_token "$1" "$tr_token" "$tr_node";}
            #@endif
            #@if current_shell_process_replace==0
        tr_resolve_index_token "$1" "$tr_token" "$tr_node" ; eval "${_ret_s_/o/tr_token}"
            #@endif
        [[ -z "$tr_token" ]] && return $X_RET_ENUM_OK

        if [[ "$tr_token" == '<'*'>' ]] ;then
            tr_child_id=${tr_token:1:-1}
        else
            tr_child_id="${tr_t[$tr_node.c.$tr_token]}"
        fi
        [[ -z "$tr_child_id" ]] && {
            # die ERR "key is not found!"
            # Keys that do not exist are returned directly.
            return "$X_RET_ENUM_OK"
        }
        tr_path_nodes+=("$tr_child_id")
        tr_path_tokens+=("$tr_token")
        tr_node=$tr_child_id
    done

    printf -v tr_full_key "%s$X" "${tr_path_tokens[@]:1}"

    # At this time, tr_node is the node corresponding to tr_full_key
    # (it can be a leaf or an intermediate node)

    # 3. First delete the value/key attached to the current node
    unset -v 'tr_t["$tr_full_key"]'   # delete value
    unset -v 'tr_t["$tr_node.k"]'   # delete key
    unset -v 'tr_t["$tr_node.t"]'  # delete type

    # 4. Kill all subtrees rooted at the current node
    #   (even if it is a single leaf)
    local -a tr_stack=("$tr_node")
    local tr_cur tr_tk tr_cid
    while ((${#tr_stack[@]})); do
        tr_cur=${tr_stack[-1]}
        unset -v 'tr_stack[-1]'

        # Get the current node children tr_token list
        local -a "tr_children=(${tr_t[$tr_cur.s]})"

        for tr_tk in "${tr_children[@]}"; do
            if [[ "$tr_tk" == '<'*'>' ]] ; then
                tr_cid=${tr_tk:1:-1}
            else
                tr_cid="${tr_t[$tr_cur.c.$tr_tk]}"
                unset -v 'tr_t["$tr_cur.c.$tr_tk"]'
            fi
            tr_stack+=("$tr_cid")
        done

        # If this node has its own key/value, clear it as well.
        local tr_key=${tr_t["$tr_cur.k"]}
        [[ -n "$tr_key" ]] && unset -v 'tr_t[$tr_key]'
        unset -v 'tr_t["$tr_cur.k"]'
        unset -v 'tr_t["$tr_cur.s"]'
        unset -v 'tr_t["$tr_cur.t"]'

        # Do not delete the root node itself
        # unset -v "tr_t[$tr_cur]"
    done

    # Update the children of the upper node
    local tr_parent=${tr_path_nodes[-2]}
    tr_token=${tr_path_tokens[-1]}
    local -a "tr_children=(${tr_t[$tr_parent.s]})"
    array_delete_first_e tr_children "$tr_token"
    if ((${#tr_children[@]})) ; then
        tr_t[$tr_parent.s]=${tr_children[*]@Q}
    else
        unset -v 'tr_t[$tr_parent.s]'
    fi

    unset -v 'tr_t["$tr_parent.c.$tr_token"]'
    
    tr_delete_reply=("$tr_node" "$tr_full_key")
    REPLY=${tr_delete_reply[*]@Q}

    return "$X_RET_ENUM_OK"
}

#-------------------------------------------------------------------------------

# 获取叶节点的值。
# @in  $1=树名  $2=物理全 key
# @out REPLY=叶值
# @ret 0=OK  6=X_RET_ENUM_KEY_IS_NOT_LEAF  7=X_RET_ENUM_KEY_IS_NULL
#      3=X_RET_ENUM_KEY_IS_NOTFOUND
x_get_leaf ()
{
    REPLY=
    # local - ; set +x
    local -n tr_t=$1
    local tr_full_key=$2

    [[ -z "$tr_full_key" ]] && {
        die ERR "key is null."
        return $X_RET_ENUM_KEY_IS_NULL
    }
    local tr_node_info
#@if current_shell_process_replace==1
    tr_node_info=${|_x_token_to_node_id "$1" "$tr_full_key";} || return $?
#@endif
#@if current_shell_process_replace==0
    _x_token_to_node_id "$1" "$tr_full_key" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_node_info}"
#@endif
    local -A "tr_node_info=($tr_node_info)"
    local tr_physical_full_key=${tr_node_info[physical_full_key]}
    if [[ ${tr_t["$tr_physical_full_key"]+_} ]] ; then
        REPLY=${tr_t["$tr_physical_full_key"]}
        return $X_RET_ENUM_OK
    else
        die ERR "full key:${tr_full_key@Q} physical full key:${tr_physical_full_key@Q} not found leaf!"
        return $X_RET_ENUM_KEY_IS_NOT_LEAF
    fi
}

#-------------------------------------------------------------------------------

# 获取子树（返回一棵新树）。空 key 返回整棵树。
# @in  $1=树名  $2=物理全 key（空=整棵树）
# @out REPLY=新树（关联数组 KV 格式）
# @ret 0=OK  2=X_RET_ENUM_KEY_IS_LEAF  3=KEY_IS_NOTFOUND  4=KEY_IS_INVALID
x_get_tree ()
{
    REPLY=
    # local - ; set +x
    local tr_t_name=$1
    local -n tr_t=$1
    local tr_full_key=$2
    local tr_node=$3
    local tr_real_full_key=$4

    if [[ -n "$tr_node" && -n "$tr_real_full_key" ]] ; then
        # 2. Determine whether tr_full_key is legal
        x_key_is_invalid "$tr_full_key" || return $?
    else
        # 1. If tr_full_key is empty, return the entire tree directly
        [[ -z "$tr_full_key" ]] && {
        #@if at_k_var_substitution==1
            REPLY="${tr_t[*]@K}"
        #@endif
        #@if at_k_var_substitution==0
            array_to_kv_q_str tr_t ; REPLY=$REPLY
        #@endif
            return ${X_RET_ENUM_OK}
        }
        
        # 2. Determine whether tr_full_key is legal
        x_key_is_invalid "$tr_full_key" || return $?

        # 4. Find the node ID corresponding to tr_full_key
        local tr_node_info
            #@if current_shell_process_replace==1
        tr_node_info=${|_x_token_to_node_id "$tr_t_name" "$tr_full_key";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        _x_token_to_node_id "$tr_t_name" "$tr_full_key" || eval "$_ret_e"
        eval "${_ret_s_/o/tr_node_info}"
            #@endif
        local -A "tr_node_info=($tr_node_info)"
        tr_node=${tr_node_info[node_id]}
        tr_real_full_key=${tr_node_info[physical_full_key]}
    fi

    [[ ${tr_t[$tr_real_full_key]+_} ]] && {
        die ERR "key:${tr_real_full_key@Q} is leaf!"
        return ${X_RET_ENUM_KEY_IS_LEAF}
    }

    # 5. Get the children of the node (the first-level node of the subtree)
    local -a "tr_root_children=(${tr_t[$tr_node.s]})"

    # 6. Create a new tree
        #@if current_shell_process_replace==1
    local -A "tr_new=(${|x_init "${tr_t[$tr_node.t]}";})"
        #@endif
        #@if current_shell_process_replace==0
    x_init "${tr_t[$tr_node.t]}" ; eval "${_ret_A/o/tr_new}"
        #@endif

    # If the subtree root is empty, it is returned directly.
    ((${#tr_root_children[@]})) || {
    #@if at_k_var_substitution==1
        REPLY=${tr_new[*]@K} ; return ${X_RET_ENUM_OK}
    #@endif
    #@if at_k_var_substitution==0
        array_to_kv_q_str tr_new ; REPLY=$REPLY
        return $X_RET_ENUM_OK
    #@endif
    }
    
    # 7. The children of the new tree are reset to the current tr_root_children
    tr_new[$X_ROOT_ID.s]=${tr_root_children[*]@Q}

    # 8. Mount all root children
    local tr_tk tr_cid
    local -a tr_stack=()
    for tr_tk in "${tr_root_children[@]}" ; do
        if [[ "$tr_tk" == '<'*'>' ]] ; then
            tr_cid=${tr_tk:1:-1}
        else
            tr_cid=${tr_t[$tr_node.c.$tr_tk]}
            tr_new["$X_ROOT_ID.c.$tr_tk"]="$tr_cid"
        fi
        tr_stack+=("$tr_cid")
    done

    # 9. DFS copy child node
    local tr_max_id=1
    while ((${#tr_stack[@]})) ; do
        local tr_cur=${tr_stack[-1]}
        unset -v 'tr_stack[-1]'
        ((tr_max_id=(tr_cur>tr_max_id)?tr_cur:tr_max_id))

        # tr_new[$tr_cur]=1
        [[ -n "${tr_t[$tr_cur.s]}" ]] && tr_new[$tr_cur.s]=${tr_t[$tr_cur.s]}
        [[ -n "${tr_t[$tr_cur.t]}" ]] && tr_new[$tr_cur.t]=${tr_t[$tr_cur.t]}

        # The key here cannot be copied directly from the old tree, and 
        # the prefix needs to be cut off.
        local tr_key=${tr_t["$tr_cur.k"]}

        if [[ -n "$tr_key" ]] ; then
            tr_new[$tr_cur.k]=${tr_key#"$tr_real_full_key"}
            local tr_new_key=${tr_new["$tr_cur.k"]}
            tr_new["$tr_new_key"]=${tr_t["$tr_key"]}
        fi

        local -a "tr_children=(${tr_t[$tr_cur.s]})"

        for tr_tk in "${tr_children[@]}" ; do
            if [[ "$tr_tk" == '<'*'>' ]] ; then
                tr_cid="${tr_tk:1:-1}"
            else
                tr_cid="${tr_t["$tr_cur.c.$tr_tk"]}"
                tr_new["$tr_cur.c.$tr_tk"]="$tr_cid"
            fi
            tr_stack+=("$tr_cid")
        done
    done

    tr_new[max_index]=$((tr_max_id+1))

#@if at_k_var_substitution==1
    REPLY=${tr_new[*]@K}
#@endif
#@if at_k_var_substitution==0
    array_to_kv_q_str tr_new ; REPLY=$REPLY
#@endif
    return ${X_RET_ENUM_OK}
}

#-------------------------------------------------------------------------------

# Iterate children under prefix
#                                  Arrays do not need to be wrapped with []
#                   phy_token type index_token value node 
# default               1       1       0        0    0
# bit                   0       1       2        3    4
#
# 遍历子节点，每行元组："phy_token type index_token value node"。
# 未请求的字段为空串。
# @in  $1=树名  $2=物理前缀（默认空=根）  $3=迭代掩码
#      （bit0=phy_token bit1=type bit2=index_token bit3=value bit4=node）
#      $4=节点 ID（可选，省略则按前缀解析）
# @out REPLY=多行元组（@Q 格式，行内字段空格分隔）
# @ret 0=OK  4=X_RET_ENUM_KEY_IS_INVALID
x_iter ()
{
    REPLY=
    # local - ; set +x
    local -n tr_t=$1
    local tr_prefix=$2
    local -i tr_is_iter_{phy_token,type,index_token,value,node}=0
    local tr_iter_bitmap=${3:-$((2#00011))}         
    local tr_node_id=$4
    var_bitmap_unpack   "$tr_iter_bitmap"          \
                        "tr_is_iter_phy_token:0"   \
                        "tr_is_iter_type:1"        \
                        "tr_is_iter_index_token:2" \
                        "tr_is_iter_value:3"       \
                        "tr_is_iter_node:4"

    [[ -z "$tr_node_id" ]] && {
        [[ -n "$tr_prefix" ]] && {
            x_key_is_invalid "$tr_prefix" || return $?
        }
        local tr_node_info
            #@if current_shell_process_replace==1
        tr_node_info=${|_x_token_to_node_id "$1" "$tr_prefix";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        _x_token_to_node_id "$1" "$tr_prefix" || eval "$_ret_e"
        eval "${_ret_s_/o/tr_node_info}"
            #@endif
        local -A "tr_node_info=($tr_node_info)"
        tr_node_id=${tr_node_info[node_id]}
    }

    # If tr_node_id is empty, traverse the root node
    tr_node_id=${tr_node_id:-"$X_ROOT_ID"}

    local -a "tr_children=(${tr_t[$tr_node_id.s]})"

    local tr_tk tr_child_id tr_type tr_key
    local tr_tk_p tr_type_p tr_value_p tr_node_p tr_index_tk_p

    local -i tr_index=0
    local tr_parent_type=${tr_t[$tr_node_id.t]}
    
    # The safest method for REPLY can only be separate assignment. If you want
    # to append a string to it, it is best to use a separate intermediate
    # variable to process it, and finally assign it to REPLY all at once,
    # or you must clear the value of REPLY first.
    REPLY=
    for tr_tk in "${tr_children[@]}"; do
        if [[ "$tr_tk" == '<'*'>' ]] ; then
            tr_child_id=${tr_tk:1:-1}
        else
            tr_child_id=${tr_t["$tr_node_id.c.$tr_tk"]}
        fi
        if ((tr_is_iter_type)) ; then
            x_get_node_type "$1" "$tr_child_id" ; tr_type=$?
            tr_type_p=${tr_type@Q}
        else
            tr_type_p=''
        fi

        if ((tr_is_iter_index_token)) ; then
            if [[ "$tr_parent_type" == "$X_TYPE_ARR" ]] ; then
                tr_index_tk_p=${tr_index@Q}
            else
                tr_index_tk_p=${tr_tk@Q}
            fi
        else
            tr_index_tk_p=''
        fi
        
        if ((tr_is_iter_value)) ; then
            tr_key="${tr_t["$tr_child_id.k"]}"
            [[ -n "$tr_key" ]] && tr_value_p=${tr_t["$tr_key"]}

            ((tr_is_iter_type)) || { x_get_node_type "$1" "$tr_child_id" ; tr_type=$? ; }

            # Empty objects and empty arrays return simulated values
            case "$tr_type" in
            $X_NODE_KIND_OBJ_EMPTY)    tr_value_p="$X_VALUE_NULL_OBJ" ;;
            $X_NODE_KIND_ARR_EMPTY)    tr_value_p=$"$X_VALUE_NULL_ARR" ;;
            esac
            tr_value_p=${tr_value_p@Q}
        else
            tr_value_p=''
        fi

        ((tr_is_iter_phy_token)) && tr_tk_p=${tr_tk@Q}         || tr_tk_p=''
        ((tr_is_iter_node))      && tr_node_p=${tr_child_id@Q} || tr_node_p=''

        #                      phy_token      type       index_token       value         node
        REPLY+="${REPLY:+$'\n'}${tr_tk_p} ${tr_type_p} ${tr_index_tk_p} ${tr_value_p} ${tr_node_p}"
        ((tr_index++))
    done

    return ${X_RET_ENUM_OK}
}

#-------------------------------------------------------------------------------

# This is just an example to demonstrate the callback function of x_walk,
# processing the entire tree
#
# 示例回调：把遍历元组打印为一行。演示 x_walk 用法，不用于生产。
x_cb_print ()
{
    local node_kind=$1         # leaf / leaf_null / obj / obj_empty / arr / arr_empty
    local index_token=$2       # "{k}" or "[0]"
    local index_full_key=$3    # "{a}$X[0]$X{b}$X"
    local value=$4             # only meaningful for leaf/leaf_null
    local physical_token=$5    # Internal tokens like "<123>" (if needed)
    local physical_full_key=$6 # "{a}$X<12>$X<56>$X"
    local node_id=$7
    local parent_id=$8
    local printf_info
    printf_info+="node kind:$node_kind "
    printf_info+="index token:$index_token "
    printf_info+="index full key:$index_full_key "
    printf_info+="value:$value "
    printf_info+="physical token:$physical_token "
    printf_info+="physical full key:$physical_full_key "
    printf_info+="node id:$node_id "
    printf_info+="parent id:$parent_id"
    printf '%s\n' "$printf_info"
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# 获取节点类型。
# @in  $1=树名  $2=节点 ID
# @ret X_NODE_KIND_OBJ=1 / ARR=2 / OBJ_EMPTY=3 / ARR_EMPTY=4
#      / LEAF=5 / LEAF_NULL=6 / UNKNOWN=7
x_get_node_type ()
{
    # local - ; set +x
    local -n tr_t=$1
    local tr_node=$2
    local tr_key
    
    if [[ ${tr_t[$tr_node.k]+_} ]] ; then
        tr_key="${tr_t["$tr_node.k"]}"
        if [[ "${tr_t["$tr_key"]}" == "$X_VALUE_NULL" ]] ; then
            return $X_NODE_KIND_LEAF_NULL
        else
            return $X_NODE_KIND_LEAF
        fi
    elif [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_OBJ" ]] ; then
        if [[ -n "${tr_t[$tr_node.s]}" ]] ; then
            return $X_NODE_KIND_OBJ
        else
            return $X_NODE_KIND_OBJ_EMPTY
        fi
    elif [[ "${tr_t[$tr_node.t]}" == "$X_TYPE_ARR" ]] ; then
        if [[ -n "${tr_t[$tr_node.s]}" ]] ; then
            return $X_NODE_KIND_ARR
        else
            return $X_NODE_KIND_ARR_EMPTY
        fi
    else
        return $X_NODE_KIND_UNKNOWN
    fi
}

#-------------------------------------------------------------------------------

# 判断节点是否"扁平"（叶/空容器）。用于 x_layer_get_flat。
# @in  $1=X_NODE_KIND_*
# @ret 0=扁平  1=非扁平
x_layer_child_is_flat ()
{
    case "$1" in
    $X_NODE_KIND_OBJ_EMPTY|$X_NODE_KIND_ARR_EMPTY|$X_NODE_KIND_LEAF_NULL|$X_NODE_KIND_LEAF)
        return 0
        ;;
    esac
    
    return 1
}

#-------------------------------------------------------------------------------

# 深度优先遍历子树，每个节点调用 $3 回调。
# 回调参数：node_kind index_token index_full_key value
#           physical_token physical_full_key node_id parent_id
# @in  $1=树名  $2=起始物理全 key（空=根）  $3=回调函数名（默认 x_cb_print）
# @ret 0=OK  其他=回调返回的非 0 值（提前终止）
x_walk ()
{
    # local - ; set +x
    local -n tr_t=$1
    local tr_prefix=$2
    local tr_cb=${3:-x_cb_print}

    local tr_root_id tr_physical_full_key tr_index_full_key
    local tr_node_info tr_node_kind
        #@if current_shell_process_replace==1
    tr_node_info=${|_x_token_to_node_id "$1" "$tr_prefix" 1;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_token_to_node_id "$1" "$tr_prefix" 1 || eval "$_ret_e"
    eval "${_ret_s_/o/tr_node_info}"
        #@endif
    local -A "tr_node_info=($tr_node_info)"
    tr_root_id=${tr_node_info[node_id]}
    tr_physical_full_key=${tr_node_info[physical_full_key]}
    tr_index_full_key=${tr_node_info[index_full_key]}

    local -a tr_stack=()
    tr_stack+=("$tr_physical_full_key" "$tr_index_full_key" "$tr_root_id")

    while ((${#tr_stack[@]})); do
        local tr_node_id=${tr_stack[-1]} ; unset -v 'tr_stack[-1]'
        local tr_index_prefix=${tr_stack[-1]} ; unset -v 'tr_stack[-1]'
        local tr_physical_prefix=${tr_stack[-1]} ; unset -v 'tr_stack[-1]'

        local -a "tr_children=(${tr_t[$tr_node_id.s]})"
        local tr_tk tr_child_id tr_value tr_index_token

        local -i tr_index=0
        for tr_tk in "${tr_children[@]}"; do
            if [[ "$tr_tk" == '<'*'>' ]] ; then
                tr_child_id=${tr_tk:1:-1}
            else
                tr_child_id=${tr_t["$tr_node_id.c.$tr_tk"]}
            fi

            x_get_node_type "$1" "$tr_child_id" ; tr_node_kind=$?
            local tr_key="${tr_t["$tr_child_id.k"]}"
            [[ -n "$tr_key" ]] && tr_value=${tr_t["$tr_key"]} || tr_value=''
            
            # There are special cases here. Empty arrays and empty
            # objects also return simulated values.
            case "$tr_node_kind" in
            $X_NODE_KIND_OBJ_EMPTY)
                tr_value="$X_VALUE_NULL_OBJ"   ;;
            $X_NODE_KIND_ARR_EMPTY)
                tr_value="$X_VALUE_NULL_ARR"   ;;
            esac

            tr_index_token=$tr_tk
            [[ "${tr_tk:0:1}" == '<' ]] && tr_index_token="[$tr_index]"
            tr_index_full_key="$tr_index_prefix$tr_index_token$X"
            tr_physical_full_key="$tr_physical_prefix$tr_tk$X"

            "$tr_cb"  "$tr_node_kind" \
                            "$tr_index_token" \
                            "$tr_index_full_key" \
                            "$tr_value" \
                            "$tr_tk" \
                            "$tr_physical_full_key" \
                            "$tr_child_id" \
                            "$tr_node_id" || return $?

            case "$tr_node_kind" in
            $X_NODE_KIND_OBJ|$X_NODE_KIND_ARR)
                tr_stack+=("$tr_physical_full_key" "$tr_index_full_key" "$tr_child_id")
                ;;
            esac

            ((tr_index++))
        done
    done
    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# 重建节点 ID（紧凑化），默认 DFS 序重新编号。
# @in  $1=树名
# @out REPLY=新树（关联数组 KV 格式）
# @ret 0=OK
x_id_rebuild ()
{
    REPLY=
    # local - ; set +x
    local -n tr_old=$1
    local -a tr_id_list=()

    x_id_rebuild_collect_ids_cb ()
    {
        local old_id=$7
        tr_id_list+=("$old_id")
    }
    x_walk "$1" '' x_id_rebuild_collect_ids_cb

    # There is absolutely no need to waste time sorting here.
    # array_qsort tr_id_list '-gt'
    local -A tr_id_map=()
    local tr_new_id=$((X_ROOT_ID+1))
    local tr_old_id
    for tr_old_id in "${tr_id_list[@]}" ; do
        tr_id_map[$tr_old_id]=$tr_new_id
        ((tr_new_id++))
    done

    tr_id_map[$X_ROOT_ID]=1

        #@if current_shell_process_replace==1
    local -A "tr_new=(${|x_init "${tr_old[$X_ROOT_ID.t]}";})"
        #@endif
        #@if current_shell_process_replace==0
    x_init "${tr_old[$X_ROOT_ID.t]}" ; eval "${_ret_A/o/tr_new}"
        #@endif

    # 辅助函数：用 tr_id_map 重建物理全 key（把 <old_id> 换成 <new_id>）
    _x_id_rebuild_key ()
    {
        local old_key=$1
        local new_key=''
        local tk
        local -a tokens=()

        if [[ -n "$old_key" ]] ; then
            #@if current_shell_process_replace==1
            local -a "tokens=(${|_split_tokens "$old_key";})"
            #@endif
            #@if current_shell_process_replace==0
            _split_tokens "$old_key" ; eval "${_ret_a/o/tokens}"
            #@endif
        fi

        for tk in "${tokens[@]}" ; do
            if [[ "$tk" == '<'*'>' ]] ; then
                local old_id=${tk:1:-1}
                local new_id=${tr_id_map[$old_id]:-$old_id}
                new_key+="<$new_id>$X"
            else
                new_key+="$tk$X"
            fi
        done
        REPLY=$new_key
    }

    x_id_rebuild_cb ()
    {
        local type=$1 value=$4 token=$5 full_key=$6 old_id=$7 parent_old_id=$8 
        # index_token $2 本次不需要

        local new_id=${tr_id_map[$old_id]}
        local new_parent_id=${tr_id_map[$parent_old_id]}

        # 重建 full_key（内部 <old_id> 换成 <new_id>）
            #@if current_shell_process_replace==1
        local new_full_key=${|_x_id_rebuild_key "$full_key";}
            #@endif
            #@if current_shell_process_replace==0
        _x_id_rebuild_key "$full_key" ; eval "${_ret_s/o/new_full_key}"
            #@endif

        # 重建 token（数组是 <old_id> 换成 <new_id>，对象是 {key} 不变）
        local new_token
        if [[ "$token" == '<'*'>' ]] ; then
            new_token="<$new_id>"
        else
            new_token=$token
        fi

        # write type tag
        case "$type" in
        $X_NODE_KIND_OBJ|$X_NODE_KIND_OBJ_EMPTY)
            tr_new[$new_id.t]=$X_TYPE_OBJ   ;;
        $X_NODE_KIND_ARR|$X_NODE_KIND_ARR_EMPTY)
            tr_new[$new_id.t]=$X_TYPE_ARR   ;;
        # Other leaf keys need to write values
        *)  tr_new[$new_id.k]="$new_full_key"
            tr_new["$new_full_key"]="$value"
            ;;
        esac

        # 父节点的 children 和 child 映射，统一使用新 token
        if [[ "$new_token" != '<'*'>' ]] ; then
            tr_new["$new_parent_id.c.$new_token"]="$new_id"
        fi
        tr_new[$new_parent_id.s]+=" ${new_token@Q}"
    }
    x_walk $1 '' x_id_rebuild_cb

    tr_new[max_index]=$tr_new_id

        #@if at_k_var_substitution==1
    REPLY=${tr_new[*]@K}
        #@endif
        #@if at_k_var_substitution==0
    array_to_kv_q_str tr_new ; REPLY=$REPLY
        #@endif
    return ${X_RET_ENUM_OK}
}

#-------------------------------------------------------------------------------

# 比较两棵树是否完全等价（结构、路径、值全部一致）。
# @in  $1=树 1 名  $2=树 2 名
# @ret 0=OK  53=X_RET_ENUM_TREE_IS_NOT_SAME
x_equals ()
{
    # local - ; set +x
    local -n tr_x_equals_1=$1 tr_x_equals_2=$2
    local tr_x_equals_1_name=$1 tr_x_equals_2_name=$2
    local tr_ok=1
    local -A tr_x_equals_1_check=()
    local -A tr_x_equals_2_check=()
    local tr_key

    _x_equals_fail ()
    { 
        die ERR "$tr_x_equals_1_name $tr_x_equals_2_name is not the same!"
        return $X_RET_ENUM_TREE_IS_NOT_SAME
    }

    [[ "${tr_x_equals_1[$X_ROOT_ID.t]}" == "${tr_x_equals_2[$X_ROOT_ID.t]}" ]] || {
        _x_equals_fail ; return $?
    }

    [[ "${#tr_x_equals_1[@]}" == "${#tr_x_equals_2[@]}" ]] || {
        _x_equals_fail ; return $?
    }

    # Iterate over tr_1, check tr_2
    x_equals_check_ab ()
    {
        local kind=$1 index_full_key=$3 value=$4
        tr_x_equals_1_check["$index_full_key"]="$kind$X$value$X"

        return $X_RET_ENUM_OK
    }

    x_walk "$tr_x_equals_1_name" '' x_equals_check_ab || return $?

    # Iterate over tr_2, check tr_1
    x_equals_check_ba ()
    {
        local kind=$1 index_full_key=$3 value=$4

        tr_x_equals_2_check["$index_full_key"]="$kind$X$value$X"

        return $X_RET_ENUM_OK
    }

    x_walk "$tr_x_equals_2_name" '' x_equals_check_ba || return $?

    [[ "${#tr_x_equals_1_check[@]}" == "${#tr_x_equals_2_check[@]}" ]] || {
        _x_equals_fail ; return $?
    }

    for tr_key in "${!tr_x_equals_1_check[@]}" ; do
        [[ ${tr_x_equals_2_check[$tr_key]+_} ]] || {
            _x_equals_fail ; return $?
        }
        [[ "${tr_x_equals_1_check[$tr_key]}" == "${tr_x_equals_2_check[$tr_key]}" ]] || {
            _x_equals_fail ; return $?
        }
    done

    for tr_key in "${!tr_x_equals_2_check[@]}" ; do
        [[ ${tr_x_equals_1_check[$tr_key]+_} ]] || {
            _x_equals_fail ; return $?
        }
        [[ "${tr_x_equals_1_check[$tr_key]}" == "${tr_x_equals_2_check[$tr_key]}" ]] || {
            _x_equals_fail ; return $?
        }
    done

    return $X_RET_ENUM_OK
}

#-------------------------------------------------------------------------------

# 数组操作目标位置计算：push/unshift/pop/shift 通用。
# @in  $1=树名  $2=父路径物理全 key  $3=模式 push|unshift|pop|shift
# @out REPLY=目标位置物理全 key
# @ret 0=OK  9=X_RET_ENUM_KEY_CHILD_CNT_IS_ZERO
#      8=X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
_x_array_next_key ()
{
    REPLY=
    local tr_name=$1
    local tr_up_key=$2
    # push/unshift/pop/shift
    local tr_mode=$3
    local tr_child_cnt

    # Get the up node type, if it exists, it must be an array or null
    # If it does not exist create an array and write position 0
    local tr_node_info tr_node_info_ret
        #@if current_shell_process_replace==1
    tr_node_info=${|_x_token_to_node_id "$tr_name" "$tr_up_key" 0 1 1 2>/dev/null;}
    tr_node_info_ret=$?
        #@endif
        #@if current_shell_process_replace==0
    _x_token_to_node_id "$tr_name" "$tr_up_key" 0 1 1 2>/dev/null
    tr_node_info_ret=$?
    eval "${_ret_s_/o/tr_node_info}"
        #@endif

    case "$tr_node_info_ret" in
    $X_RET_ENUM_KEY_IS_NOTFOUND)
        case "$tr_mode" in
        push)   REPLY="$tr_up_key[0]$X" ;;
        unshift)
                REPLY="$tr_up_key(0)$X" ;;
        pop|shift)
                return $tr_node_info_ret ;;
        esac
        ;;
    $X_RET_ENUM_OK)
        # Get the up node type
        local -A "tr_node_info=($tr_node_info)"
        if  [[ "${tr_node_info[type]}" == "$X_TYPE_ARR" ]] ||
            [[ "${tr_node_info[value]}" == "$X_VALUE_NULL" ]] ; then
            tr_child_cnt=${tr_node_info[child_cnt]}
            case "$tr_mode" in
            push)   REPLY="${tr_node_info[physical_full_key]}[$tr_child_cnt]$X" ;;
            unshift)
                    REPLY="${tr_node_info[physical_full_key]}(0)$X" ;;
            pop|shift)    
                # First check if the child is empty
                ((tr_child_cnt)) || {
                    die ERR "node:${tr_node_info[node_id]} child cnt is 0."
                    return $X_RET_ENUM_KEY_CHILD_CNT_IS_ZERO
                }
                ;;&
            pop)    REPLY="${tr_node_info[physical_full_key]}[$((tr_child_cnt-1))]$X" ;;
            shift)  REPLY="${tr_node_info[physical_full_key]}[0]$X" ;;
            esac
        else
            die ERR "node:${tr_node_info[node_id]} type is not array or null."
            return $X_RET_ENUM_KEY_UP_LEV_TYPE_MISMATCH
        fi
        ;;
    *)
        return $tr_node_info_ret
        ;;
    esac

    return ${X_RET_ENUM_OK}
}

#-------------------------------------------------------------------------------

# Pushing empty leaves and empty arrays is OK
#
# 数组写入：push/unshift 叶或子树。
# @in  $1=树名  $2=父路径物理全 key  $3=push|unshift
#      $4=leaf|tree  $5=值/子树名
# @out REPLY=插入节点 "node_id physical_key"（透传 x_insert/x_graft）
# @ret 0=OK  其他=透传 x_insert/x_graft
_x_array_write ()
{
    # local - ; set +x
    local tr_name=$1 tr_up_key=$2
    local tr_mode=$3      # push / unshift
    local tr_write=$4     # leaf / tree
    local tr_value=$5     # leaf value or subtree name

    local tr_next_key
        #@if current_shell_process_replace==1
    tr_next_key=${|_x_array_next_key "$tr_name" "$tr_up_key" "$tr_mode";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_next_key "$tr_name" "$tr_up_key" "$tr_mode" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_next_key}"
        #@endif

    case "$tr_write" in
    leaf)   x_insert "$tr_name" "$tr_next_key" "$tr_value" ;;
    tree)   x_graft "$tr_name" "$tr_next_key" "$tr_value" ;;
    esac
}

#-------------------------------------------------------------------------------

# The return values of leaf and tree are the return values of insert and graft
#
# 数组 push/unshift 封装：
# x_push_leaf/x_push_tree/x_unshift_leaf/x_unshift_tree
# @in  $1=树名  $2=父路径物理全 key  $3=值 或 子树名
# @out REPLY=列表 "node_id physical_key"
x_push_leaf () { _x_array_write "$1" "$2" push leaf "$3" ; }
x_push_tree () { _x_array_write "$1" "$2" push tree "$3" ; }
x_unshift_leaf () { _x_array_write "$1" "$2" unshift leaf "$3" ; }
x_unshift_tree () { _x_array_write "$1" "$2" unshift tree "$3" ; }

#-------------------------------------------------------------------------------

# 数组 pop/shift 前的定位（内部）。
# @in  $1=树名  $2=父路径物理全 key  $3=pop|shift  $4=leaf|tree
# @out REPLY=叶值 或 子树
# @ret 0=OK  其他=透传 x_get_leaf/x_get_tree
_x_array_get ()
{
    # local - ; set +x
    local tr_name=$1 tr_up_key=$2
    local tr_mode=$3      # pop / shift
    local tr_read=$4      # leaf / tree

    local tr_next_key
        #@if current_shell_process_replace==1
    tr_next_key=${|_x_array_next_key "$tr_name" "$tr_up_key" "$tr_mode";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_next_key "$tr_name" "$tr_up_key" "$tr_mode" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_next_key}"
        #@endif

    case "$tr_read" in
    leaf)   x_get_leaf "$tr_name" "$tr_next_key" ;;
    tree)   x_get_tree "$tr_name" "$tr_next_key" ;;
    esac
}

#-------------------------------------------------------------------------------

# 数组 pop/shift 封装：
# x_pop_leaf/x_pop_tree/x_shift_leaf/x_shift_tree
# @in  $1=树名  $2=父路径物理全 key
# @out REPLY=弹出的叶值 或 子树
# @ret 0=OK  其他=透传 _x_array_get/x_delete
x_pop_leaf ()
{
    REPLY=
    # REPLY It will be rewritten directly in the sub-function. The explicit
    # assignment here is just for higher readability.
    local tr_pop_leaf_reply=
        #@if current_shell_process_replace==1
    tr_pop_leaf_reply=${|_x_array_get "$1" "$2" pop leaf;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_get "$1" "$2" pop leaf || eval "$_ret_e"
    eval "${_ret_s_/o/tr_pop_leaf_reply}"
        #@endif
    x_delete "$1" "$2[-1]$X" || return $?
    REPLY=$tr_pop_leaf_reply
}

#-------------------------------------------------------------------------------

# 数组 pop 子树封装（同上）。
x_pop_tree ()
{
    REPLY=
    local tr_pop_tree_reply=
        #@if current_shell_process_replace==1
    tr_pop_tree_reply=${|_x_array_get "$1" "$2" pop tree;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_get "$1" "$2" pop tree || eval "$_ret_e"
    eval "${_ret_s_/o/tr_pop_tree_reply}"
        #@endif
    x_delete "$1" "$2[-1]$X" || return $?
    REPLY=$tr_pop_tree_reply
}

#-------------------------------------------------------------------------------

# 数组 shift 叶封装（同上）。
x_shift_leaf ()
{ 
    REPLY=
    local tr_shift_leaf_reply=
        #@if current_shell_process_replace==1
    tr_shift_leaf_reply=${|_x_array_get "$1" "$2" shift leaf;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_get "$1" "$2" shift leaf || eval "$_ret_e"
    eval "${_ret_s_/o/tr_shift_leaf_reply}"
        #@endif
    x_delete "$1" "$2[0]$X" || return $?
    REPLY=$tr_shift_leaf_reply
}

#-------------------------------------------------------------------------------

# 数组 shift 子树封装（同上）。
x_shift_tree ()
{
    REPLY=
    local tr_shift_tree_reply=
        #@if current_shell_process_replace==1
    tr_shift_tree_reply=${|_x_array_get "$1" "$2" shift tree;} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_get "$1" "$2" shift tree || eval "$_ret_e"
    eval "${_ret_s_/o/tr_shift_tree_reply}"
        #@endif
    x_delete "$1" "$2[0]$X" || return $?
    REPLY=$tr_shift_tree_reply
}

#-------------------------------------------------------------------------------

# 把节点扁平化为关联数组或数组（要求节点自身及子节点都是扁平叶）。
# @in  $1='arr' 或 'obj'  $2=树名  $3=物理全 key  $4=节点 ID（可选）
# @out REPLY=扁平结果（@Q / @K 格式）
# @ret 0=X_FLAT_IS_MATCH  1=X_FLAT_IS_NOT_MATCH
#      2=X_FLAT_ARRAY_NULL  3=X_FLAT_ASSOC_NULL
x_layer_get_flat ()
{
    REPLY=
    # local - ; set +x
    local tr_expect=$1
    local -n tr_t=$2
    local tr_full_key=$3
    local tr_node_id=$4
    # 'arr' or 'obj'

    if [[ -z "$tr_node_id" ]] ; then
        [[ -n "$tr_full_key" ]] && {
            x_key_is_invalid "$tr_full_key" || return $?
        }
        local tr_node_info
            #@if current_shell_process_replace==1
        tr_node_info=${|_x_token_to_node_id "$2" "$tr_full_key";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        _x_token_to_node_id "$2" "$tr_full_key" || eval "$_ret_e"
        eval "${_ret_s_/o/tr_node_info}"
            #@endif
        local -A "tr_node_info=($tr_node_info)"
        tr_node_id=${tr_node_info[node_id]}
    fi

    # If tr_node_id is empty, determine the root node
    tr_node_id=${tr_node_id:-"$X_ROOT_ID"}

    # First determine whether the current layer is null
    local tr_key=${tr_t[$tr_node_id.k]}
    if [[ -n "$tr_key" && ${tr_t[$tr_key]+_} ]] ; then
        if [[ "${tr_t[$tr_key]}" == "$X_VALUE_NULL" ]] ; then
            return $X_FLAT_IS_MATCH
        else
            die ERR "node id:${tr_node_id} flat type not match."
            return $X_FLAT_IS_NOT_MATCH
        fi
    fi

    # Object or array to determine whether the child has children (non-flat)
    local tr_old_ifs=$IFS IFS=$'\n' tr_tuple 
    case "${tr_t[$tr_node_id.t]}" in
    $X_TYPE_ARR)
        [[ "$tr_expect" == 'arr' ]] || {
            die ERR "node id:${tr_node_id} flat type not match."
            return $X_FLAT_IS_NOT_MATCH
        }
        local -a tr_plat_arr=()
        local tr_iter_str
            #@if current_shell_process_replace==1
        tr_iter_str=${|x_iter "$2" '' $((2#11111)) "$tr_node_id";}
            #@endif
            #@if current_shell_process_replace==0
        x_iter "$2" '' $((2#11111)) "$tr_node_id" ; eval "${_ret_s_/o/tr_iter_str}"
            #@endif

        for tr_tuple in $tr_iter_str ; do
            IFS=$tr_old_ifs ; local -a "tr_tuple=($tr_tuple)"
            x_layer_child_is_flat "${tr_tuple[1]}" || {
                die ERR "node id:${tr_node_id} flat type not match."
                return $X_FLAT_IS_NOT_MATCH
            }
            tr_plat_arr+=("${tr_tuple[3]}")
        done
        REPLY=${tr_plat_arr[*]@Q}
        ;;
    $X_TYPE_OBJ)
        [[ "$tr_expect" == 'obj' ]] || {
            die ERR "node id:${tr_node_id} flat type not match."
            return $X_FLAT_IS_NOT_MATCH
        }
        local -A tr_plat_arr=()
        local tr_iter_str
    #@if current_shell_process_replace==1
        tr_iter_str=${|x_iter "$2" '' $((2#11111)) "$tr_node_id";}
    #@endif
    #@if current_shell_process_replace==0
        x_iter "$2" '' $((2#11111)) "$tr_node_id"
        tr_iter_str=$REPLY
    #@endif
        for tr_tuple in $tr_iter_str ; do
            IFS=$tr_old_ifs ; local -a "tr_tuple=($tr_tuple)"
            x_layer_child_is_flat "${tr_tuple[1]}" || {
                die ERR "node id:${tr_node_id} flat type not match."
                return $X_FLAT_IS_NOT_MATCH
            }
            tr_plat_arr["${tr_tuple[0]:1:-1}"]="${tr_tuple[3]}"
        done
    #@if at_k_var_substitution==1
        REPLY=${tr_plat_arr[*]@K}
    #@endif
    #@if at_k_var_substitution==0
        array_to_kv_q_str tr_plat_arr ; REPLY=$REPLY
    #@endif
        ;;
    esac
    
    return $X_FLAT_IS_MATCH
}

#-------------------------------------------------------------------------------

# 扁平化包装：
# x_to_flat_array  $1=树名  $2=物理全 key  -> REPLY=数组
# x_to_flat_assoc  $1=树名  $2=物理全 key  -> REPLY=关联数组
# @ret 0=X_FLAT_IS_MATCH  其他=X_FLAT_*
x_to_flat_array () { x_layer_get_flat 'arr' "$@" ; }
x_to_flat_assoc () { x_layer_get_flat 'obj' "$@" ; }

#-------------------------------------------------------------------------------

# pop 后取扁平结果（数组 / 关联数组）。
# @in  $1=树名  $2=父路径物理全 key
# @out REPLY=扁平结果
# @ret 0=X_FLAT_IS_MATCH  其他=X_FLAT_* 或 X_RET_ENUM_*
x_pop_to_flat_array ()
{
    REPLY=
    local tr_pop_fa_reply=
        #@if current_shell_process_replace==1
    tr_pop_fa_reply=${|x_to_flat_array "$1" "$2[-1]$X";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    x_to_flat_array "$1" "$2[-1]$X" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_pop_fa_reply}"
        #@endif
    x_delete "$1" "$2[-1]$X" || return $?
    REPLY=$tr_pop_fa_reply
}

#-------------------------------------------------------------------------------

# pop 关联数组（同上）。
x_pop_to_flat_assoc ()
{
    REPLY=
    local tr_pop_fs_reply=
        #@if current_shell_process_replace==1
    tr_pop_fs_reply=${|x_to_flat_assoc "$1" "$2[-1]$X";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    x_to_flat_assoc "$1" "$2[-1]$X" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_pop_fs_reply}"
        #@endif
    x_delete "$1" "$2[-1]$X" || return $?
    REPLY=$tr_pop_fs_reply
}

#-------------------------------------------------------------------------------

# shift 后取扁平结果（数组）。
# @ret 0=X_FLAT_IS_MATCH  其他=X_FLAT_* 或 X_RET_ENUM_*
x_shift_to_flat_array ()
{
    REPLY=
    local tr_shif_fa_reply=
        #@if current_shell_process_replace==1
    tr_shif_fa_reply=${|x_to_flat_array "$1" "$2[0]$X";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    x_to_flat_array "$1" "$2[0]$X" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_shif_fa_reply}"
        #@endif
    x_delete "$1" "$2[0]$X" || return $?
    REPLY=$tr_shif_fa_reply
}

#-------------------------------------------------------------------------------

# shift 后取扁平结果（关联数组）。
# @ret 0=X_FLAT_IS_MATCH  其他=X_FLAT_* 或 X_RET_ENUM_*
x_shift_to_flat_assoc ()
{
    REPLY=
    local tr_shift_fs_reply=
        #@if current_shell_process_replace==1
    tr_shift_fs_reply=${|x_to_flat_assoc "$1" "$2[0]$X";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    x_to_flat_assoc "$1" "$2[0]$X" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_shift_fs_reply}"
        #@endif
    x_delete "$1" "$2[0]$X" || return $?
    REPLY=$tr_shift_fs_reply
}

#-------------------------------------------------------------------------------

# Hooks have no deletion semantics, but writes to flat layers do
#
# 把扁平结构（数组/关联数组）写入为子树。
# @in  $1=树名  $2=目标物理全 key  $3=扁平数组名
# @ret 0=OK
x_flat_to_tree ()
{
    # local - ; set +x
    local tr_prefix=$2
    local -n tr_array=$3
    local -i tr_array_is_assoc=0

    [[ "${tr_array@a}" == *A* ]] && tr_array_is_assoc=1

    [[ "$tr_prefix" == *")$X"* ]] || {
        x_delete "$1" "$tr_prefix" || return $?
    }

    local tr_index
    local -a tr_params=()
    for tr_index in "${!tr_array[@]}" ; do
        if ((tr_array_is_assoc)) ; then
            tr_params+=("{$tr_index}$X" "${tr_array[$tr_index]}")
        else
            tr_params+=("[$tr_index]$X" "${tr_array[$tr_index]}")
        fi
    done

    ((${#tr_params[@]})) || {
        if ((tr_array_is_assoc)) ; then
            tr_params=("$X_VALUE_NULL_OBJ")
        else
            tr_params=("$X_VALUE_NULL_ARR")
        fi
    }

    x_qinserts "$1" common "$tr_prefix" "${tr_params[@]}"
}

#-------------------------------------------------------------------------------

# Not implemented, users can define it themselves through x_walk
#
# 搜索（未实现，用户可通过 x_walk 自定义）。
x_search () { : ; }

#-------------------------------------------------------------------------------

# 内部：把扁平数组 push/unshift 到数组节点。
_x_flat_insert ()
{
    # local - ; set +x
    local tr_next_key
        #@if current_shell_process_replace==1
    tr_next_key=${|_x_array_next_key "$1" "$2" "$3";} || return $?
        #@endif
        #@if current_shell_process_replace==0
    _x_array_next_key "$1" "$2" "$3" || eval "$_ret_e"
    eval "${_ret_s_/o/tr_next_key}"
        #@endif

    local -a tr_params=()
    local tr_index tr_token
    local -i tr_is_assoc=0
    local -n tr_array=$4

    [[ "${tr_array@a}" == *A* ]] && tr_is_assoc=1
    
    for tr_index in "${!tr_array[@]}" ; do
        ((tr_is_assoc)) && tr_token="{$tr_index}$X" || tr_token="[$tr_index]$X"
        tr_params+=("$tr_token" "${tr_array[$tr_index]}")
    done

    ((${#tr_array[@]})) || {
        if ((tr_is_assoc)) ; then
            tr_params=("$X_VALUE_NULL_OBJ")
        else
            tr_params=("$X_VALUE_NULL_ARR")
        fi
    }

    x_qinserts "$1" common "$tr_next_key" "${tr_params[@]}"
}

#-------------------------------------------------------------------------------

# push/unshift 扁平结构到数组：
# x_push_flat / x_unshift_flat
# @in  $1=树名  $2=父路径物理全 key  $3=扁平数组名
# @ret 0=OK
x_push_flat () { _x_flat_insert "$1" "$2" push "$3" ; }
x_unshift_flat () { _x_flat_insert "$1" "$2" unshift "$3" ; }

#-------------------------------------------------------------------------------

# This function is very slow and is only used for verification.
#
# 慢速 JSON 序列化（每条边 fork 一次 gobolt，仅作验证用）。
# @in  $1=树名  $2=物理全 key（空=整棵树）
# @out REPLY=JSON 字符串
# @ret 0=OK  10=X_RET_ENUM_KEY_OTHER_TOOL_NOT_INSTALLED
#      52=X_RET_ENUM_TREE_NOT_HAVE_ROOT
x_to_json_slow ()
{
    REPLY=
    # local - ; set +x
    local tr_name=$1
    local -n tr_t=$1
    local tr_full_key=$2
    local tr_jstr
    local tr_temp_file=$(mktemp)
    trap 'rm -f "$tr_temp_file"' RETURN

    command -v gobolt &>/dev/null || {
        die ERR "gobolt tool is not installed."
        return $X_RET_ENUM_KEY_OTHER_TOOL_NOT_INSTALLED
    }

    [[ -z "${tr_t[$X_ROOT_ID.s]}" ]] && {
        case "${tr_t[$X_ROOT_ID.t]}" in
        $X_TYPE_OBJ)   REPLY='{}' ; return $X_RET_ENUM_OK ;;
        $X_TYPE_ARR)   REPLY='[]' ; return $X_RET_ENUM_OK ;;
        *)  return $X_RET_ENUM_TREE_NOT_HAVE_ROOT  ;;
        esac
    }

    x_to_json_slow_cb ()
    {
        local node_kind=$1
        local index_full_key=$3 value=$4
    #@if current_shell_process_replace==1
        local -a "tokens=(${|_split_tokens "$index_full_key";})"
    #@endif
    #@if current_shell_process_replace==0
        _split_tokens "$index_full_key" ; eval "${_ret_a/o/tokens}"
    #@endif
        local -a bjson_params=()
        local token
        local write_jstr_param='-f'

        case "$node_kind" in
        $X_NODE_KIND_LEAF)
            case "$value" in
            $X_VALUE_TRUE) value='true'   ;;
            $X_VALUE_FALSE) value='false' ;;
            *"$X")  value=${value%"$X"}    ;;
            *) write_jstr_param='-o'       ;;
            esac
            ;;
        $X_NODE_KIND_LEAF_NULL) value='null' ;;
        $X_NODE_KIND_ARR_EMPTY) value='[]'   ;;
        $X_NODE_KIND_OBJ_EMPTY) value='{}'   ;;
        *)  return $X_RET_ENUM_OK            ;;
        esac

        for token in "${tokens[@]}" ; do
            case "$token" in
            '{'*'}') bjson_params+=(":${token:1:-1}")   ;;
            '['*']') bjson_params+=("${token:1:-1}")    ;;
            esac
        done

        printf '%s' "$value" >"$tr_temp_file"
        
            #@if current_shell_process_replace==1
        tr_jstr=${ printf '%s' "$tr_jstr" | \
            gobolt json -m w -k stdin "$write_jstr_param" "$tr_temp_file" \
            -P -- "${bjson_params[@]}";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        tr_jstr=$( printf '%s' "$tr_jstr" | \
            gobolt json -m w -k stdin "$write_jstr_param" "$tr_temp_file" \
            -P -- "${bjson_params[@]}" ) || return $?
            #@endif

        return $X_RET_ENUM_OK
    }

    x_walk "$tr_name" "$tr_full_key" x_to_json_slow_cb || return $?
    REPLY=$tr_jstr
}

#-------------------------------------------------------------------------------

# 快速 JSON 序列化（一次性 fork gobolt，超长参数自动降级到 slow）。
# @in  $1=树名  $2=物理全 key（空=整棵树）
# @out REPLY=JSON 字符串
# @ret 0=OK  10=OTHER_TOOL_NOT_INSTALLED
#      14=PARAMETER_LENGTH_EXCEEDS_LIMIT  52=TREE_NOT_HAVE_ROOT
x_to_json ()
{
    REPLY=
    # local - ; set +x
    local tr_name=$1
    local -n tr_t=$1
    local tr_full_key=$2
    local -a tr_gobolt_params=()

    command -v gobolt &>/dev/null || {
        die ERR "gobolt tool is not installed."
        return $X_RET_ENUM_KEY_OTHER_TOOL_NOT_INSTALLED
    }

    [[ -z "${tr_t[$X_ROOT_ID.s]}" ]] && {
        case "${tr_t[$X_ROOT_ID.t]}" in
        $X_TYPE_OBJ)   REPLY='{}' ; return $X_RET_ENUM_OK ;;
        $X_TYPE_ARR)   REPLY='[]' ; return $X_RET_ENUM_OK ;;
        *)  return $X_RET_ENUM_TREE_NOT_HAVE_ROOT  ;;
        esac
    }

    x_to_json_cb ()
    {
        local node_kind=$1
        local index_full_key=$3 value=$4
            #@if current_shell_process_replace==1
        local -a "tokens=(${|_split_tokens "$index_full_key";})"
            #@endif
            #@if current_shell_process_replace==0
        _split_tokens "$index_full_key" ; eval "${_ret_a/o/tokens}"
            #@endif
        local -a bjson_params=()
        local token

        case "$node_kind" in
        $X_NODE_KIND_LEAF)
            case "$value" in
            $X_VALUE_TRUE)     value='j:true'        ;;
            $X_VALUE_FALSE)    value='j:false'       ;;
            *"$X")              value=j:${value%"$X"} ;;
            *)                  value=s:${value}      ;;
            esac
            ;;
        $X_NODE_KIND_LEAF_NULL) value='j:null' ;;
        $X_NODE_KIND_ARR_EMPTY) value='j:[]'   ;;
        $X_NODE_KIND_OBJ_EMPTY) value='j:{}'   ;;
        *)  return $X_RET_ENUM_OK            ;;
        esac

        for token in "${tokens[@]}" ; do
            case "$token" in
            '{'*'}')
                x_bjson_key_escape "${token:1:-1}" token
                if ((${#bjson_params[@]})) ; then
                    bjson_params+=(".:$token")
                else
                    bjson_params+=(":$token")
                fi
                ;;
            '['*']')
                if ((${#bjson_params[@]})) ; then
                    bjson_params+=(".${token:1:-1}")
                else
                    bjson_params+=("${token:1:-1}")
                fi
                ;;
            esac
        done

        printf -v 'tr_gobolt_params[${#tr_gobolt_params[@]}]' "%s" "${bjson_params[@]}"
        tr_gobolt_params+=("$value")

        return $X_RET_ENUM_OK
    }

    x_walk "$tr_name" "$tr_full_key" x_to_json_cb || return $?

    # printf '%s\n' "${tr_gobolt_params[@]}"

    local tr_i
        #@if current_shell_process_replace==1
    local -A "tr_system_limits=(${|x_get_arg_limits "${#tr_gobolt_params[@]}";})"
        #@endif
        #@if current_shell_process_replace==0
    x_get_arg_limits "${#tr_gobolt_params[@]}" ; eval "${_ret_A/o/tr_system_limits}"
        #@endif

    # Check if each parameter exceeds
    # If it is found to be exceeded, the report will fail.

    for((tr_i=0;tr_i<${#tr_gobolt_params[@]};tr_i+=2)) ; do
            #@if current_shell_process_replace==1
        local -i tr_key_len=${|str_bytes "${tr_gobolt_params[tr_i]}";}
            #@endif
            #@if current_shell_process_replace==0
        str_bytes "${tr_gobolt_params[tr_i]}" ; eval "${_ret_i/o/tr_key_len}"
            #@endif

        ((  tr_key_len>=${tr_system_limits[MAX_ARG_STRLEN]} )) && {
            die ERR "Command line parameters exceed limit"
            return $X_RET_ENUM_KEY_PARAMETER_LENGTH_EXCEEDS_LIMIT
        }
    done

        #@if current_shell_process_replace==1
    local -i tr_all_param_byte_len=${|str_bytes "${tr_gobolt_params[*]}";}
        #@endif
        #@if current_shell_process_replace==0
    str_bytes "${tr_gobolt_params[*]}" ; eval "${_ret_i/o/tr_all_param_byte_len}"
        #@endif

    if ((tr_all_param_byte_len>=${tr_system_limits[AVAILABLE]})) ; then
        x_to_json_slow "$tr_name" "$tr_full_key" ; return $?
    else
            #@if current_shell_process_replace==1
        REPLY=${ printf '' | gobolt json -m w -k stdin -s '' -M -- "${tr_gobolt_params[@]}";}
            #@endif
            #@if current_shell_process_replace==0
        REPLY=$( printf '' | gobolt json -m w -k stdin -s '' -M -- "${tr_gobolt_params[@]}" )
            #@endif
    fi
}

#-------------------------------------------------------------------------------

# JSON 反序列化为树。
# @in  $1=JSON 字符串  $2..=go 侧需要的 bjson 路径（可选）
# @out REPLY=新树（关联数组 KV 格式）
# @ret 0=OK  10=OTHER_TOOL_NOT_INSTALLED  11=BJSON_TYPE_INVALID
x_from_json ()
{
    REPLY=
    # local - ; set +x
    local tr_json_str=$1
    local tr_bjson_keys="${@:2}"

    command -v gobolt &>/dev/null || {
        die ERR "gobolt tool is not installed."
        return $X_RET_ENUM_KEY_OTHER_TOOL_NOT_INSTALLED
    }

    local tr_assoc
        #@if current_shell_process_replace==1
    tr_assoc=${ printf '%s' "$tr_json_str" | \
        gobolt json -m r -t txt -k stdin -F trie -x "$X" -P -- "${tr_bjson_keys[@]}";}
        #@endif
        #@if current_shell_process_replace==0
    tr_assoc=$( printf '%s' "$tr_json_str" | \
        gobolt json -m r -t txt -k stdin -F trie -x "$X" -P -- "${tr_bjson_keys[@]}" )
        #@endif
    case "$?" in
    $X_GOBOLT_JSONTYPEARRAY|$X_GOBOLT_JSONTYPEOBJECT)
        local -A "tr_assoc=($tr_assoc)" ;;&
    $X_GOBOLT_JSONTYPEARRAY)
            #@if current_shell_process_replace==1
        local -A "tr_init_tree=(${|x_init "$X_TYPE_ARR";})" ;;
            #@endif
            #@if current_shell_process_replace==0
        x_init "$X_TYPE_ARR" ; eval "${_ret_A/o/tr_init_tree}" ;;
            #@endif
    $X_GOBOLT_JSONTYPEOBJECT)
            #@if current_shell_process_replace==1
        local -A "tr_init_tree=(${|x_init "$X_TYPE_OBJ";})" ;;
            #@endif
            #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; eval "${_ret_A/o/tr_init_tree}" ;;
            #@endif
    *)
        die ERR "bjson key:${tr_bjson_keys[*]} type is known."
        return $X_RET_ENUM_KEY_BJSON_TYPE_INVALID
        ;;
    esac

    local tr_key
    for tr_key in "${!tr_assoc[@]}" ; do
        x_insert tr_init_tree "$tr_key" "${tr_assoc[$tr_key]}"
    done
    
    # x_dump tr_init_tree

        #@if at_k_var_substitution==1
    REPLY=${tr_init_tree[*]@K}
        #@endif
        #@if at_k_var_substitution==0
    array_to_kv_q_str tr_init_tree ; REPLY=$REPLY
        #@endif
}

#-------------------------------------------------------------------------------

# 探测系统命令行参数限制，用于 x_to_json 决定是否降级。
# @in  $1=参数数量（默认 0）
# @out REPLY=关联数组 KV：MAX_ARG_STRLEN AVAILABLE
# @ret 0
x_get_arg_limits ()
{
    REPLY=
    # Linux: getconf ARG_MAX
    # Windows/MSYS2: fallback to 8191
    local -i argc_cnt=${1:-0}
    local -A args=()
    local argmax=$( getconf ARG_MAX 2>/dev/null )

    if [[ -z "$argmax" || "$argmax" == "undefined" ]] ; then
        # Windows hard limits
        # x=${|str_repeat 'a' 32708;}
        # printf '' | gobolt json -m w -k stdin -s "$x" -P -- :key1
        local -i safety=1024
        # 32KB
        args[MAX_ARG_STRLEN]=$((32768-safety))
        local -i msys_overhead=$(( argc_cnt * 2 ))
        # 预扣空格和引号的开销（每个参数至少 1~2 个字符）
        args[AVAILABLE]=$((32768-safety-msys_overhead))
    else
        # Linux Kernel constants MAX_ARG_STRLEN = 131072(128KB)
        local -i safety=4096
            #@if current_shell_process_replace==1
        local -i env_bytes=${|str_bytes "${ export -p;}";}
            #@endif
            #@if current_shell_process_replace==0
        str_bytes "$( export -p )" ; eval "${_ret_i/o/env_bytes}"
            #@endif
        # 扣除指针数组开销, 64位系统每个指针 8 字节
        local -i ptr_overhead=$((argc_cnt * 8))
        # 128k MAX_ARG_STRLEN 内核头文件中
        args[MAX_ARG_STRLEN]=$((131072-safety))
        args[AVAILABLE]=$((argmax-env_bytes-safety-ptr_overhead))
    fi

        #@if at_k_var_substitution==1
    REPLY=${args[*]@K}
        #@endif
        #@if at_k_var_substitution==0
    array_to_kv_q_str args ; REPLY=$REPLY
        #@endif
}

#-------------------------------------------------------------------------------
# t1(1) -> 
#     0(2)
#         {aa ge}(4) => value2
#         {b}(3) => value1
#     1(5)
#         {c2}(8) => []
#         {c8}(14) => strwxx
#         {c7}(13) => false\u001c
#         { gge
#         | gege g
#         |ggegg geg\t\t\u0002\u0003\u0004ge我是中文}(6) =>
#                                                          | 响铃 geg
#                                                          | gg  ee\u0001\u0002\u0003\u0004\u0005\u0006\u0007\b\t
#                                                          |\u000b\f\r\u000e\u000f\u0010\u0011\u0012\u0013\u0014\u0015\u0016\u0017\u0018\u0019\u001a\u001b\u001c\u001d\u001e\u001f ;over
#         {
#         |key
#         |}(21) => value_line1
#                  |value_line2
#         {c6}(12) => true\u001c
#         {c5*[]@!{}}(11) => 190.23*[]@!{}
#         {c3}(9) => null\u001c
#         {c4}(10) => 190.22\u001c
#         {c1}(7) => {}
#         {
#         | ge中各
#         | ge\\g
#         |}(15)
#             0(16) = null
#             1(17) =
#                    |gege
#                    |gege
#                    |
#             2(18) = true\u001c
#             3(19) = 1010\u001c
#             4(20) = 1010.22
#             5(22) = gegege
#     2(23)
#         {x}(24) => value3
#     3(25)
#         {y}(26) => value4
#     4(27)
#         {z}(28) => value5
#     5(29)
#         0(30) = null\u001c
#         1(31) = null\u001c
#         2(32) = null\u001c
#         3(33) = value5
#     6(34)
#         {key1ggggggggg}(35)
#             {keeeeeeeey2}(36) => valueX
#     max_index => 37
#
#
#   实现的时候可以定义很多个数组，每个数组下标都是行号，内容放置每行的属性。
#
#   1. 初始化
#       针对每行做清洗，满足下面条件的行先干掉
#           a. 所有空行和全是空字符(空格\r\n)的行
#           b. 所有的注释行(不含空格缩进的情况下的 # 开头的行)
#   2. 按照第一行的缩进前置空格数，删除每一行的前面的这么多的空格，保持树缩进干净
#   3. 删除最后一个 max_index 的行
#   4. 当前的字符串做这样的替换
#       `$'\n'   |` 替换成 `'\n'`
#       这里解释下，可能需要多行替换模式，要考虑下怎么才能实现。大概意思就是
#       `$'\n'` 这个真正的换行符换行后跟上若干个空格然后跟一个`|`竖线，这种东西替换
#       成 `'\n'` 转义。
#       这样所有的行都是单行的了。
#   5. 初始化3个容器，一个是 tr_path_stack，一个是 tr_leafs，一个是 tr_array_indexs
#       a. tr_path_stack 初始化一个元素为 ""，空字符串，代表根节点的路径，一旦遇到树节点，就把当前树
#           节点压进去，如果树节点层级减少，就从尾部弹出相应层级的节点 token.
#       b. tr_leafs 里面装当前扁平层的叶子节点键和值元组，如果是数组，键就是索引，
#           结构是(0 element1 1 element2)。如果是字典，键就是字典的键，结构是
#           (key1 value1 key2 value2)。
#       c. tr_array_indexs 里面存的是每级数组当前索引最大值，键是每个数组层级的 full_key
#           比如: 
#               t1(1) -> 
#                   0(2)           <--------- A(缓存 "" = 1)
#                       {aa ge}(4) => value2
#                       {b}(3) => value1
#                   1(5)           <--------- B(缓存 "" = 2)
#                       {c1}(7) => {}
#                       {key1}(15)
#                           0(16) = null    <---------- C(缓存 ""[1]$X{key1}$X = 1)
#                           1(18) = true\u001c   <------- D(缓存 ""[1]$X{key1}$X = 2)
#                           2(19)  <------- E(缓存 ""[1]$X{key1}$X = 3)
#                               0(58) <------- F(缓存 ""[1]$X{key1}$X[2]$X = 1)
#                                   {other_key}(69) => value1
#                   2(29)   <------  G(缓存 "" = 3)
#                       0(30) = null\u001c <-------  H(缓存 ""[2]$X = 1)
#                       1(31) = null\u001c <-------  I(缓存 ""[2]$X = 2)
#                   3(89) = xxvalue        <-------  J(缓存 "" = 4)
#           就上面这棵树来说，只要遇到数组键，那么都要缓存它的当前最大索引。
#           这样下次遍历到它的时候直接从缓存中取索引，如果发现缓存不存在，那么证明是第一次遇到
#           这个数组，索引为0。
#   6. 缓存每一行的缩进层级，以备后面方便使用。下面的情况中，空字典和空数组都属于叶子，不是树，记住这个约定。
#       为了方便处理，其它的信息也可以用数组来缓存，每个数组缓存一个属性，比如：当前的键和值，当前的节点类
#       型：字典树、数组树、键、值。
#   7. 从第二行开始读行，策略是这样的：
#       a. 如果当前行不是`{`开头(忽略前置空格)，那么证明是数组。
#           1). 如果索引后面紧跟着 = ，那么是叶子节点，把叶子索引和值推进 tr_leafs 数组
#               数组中的格式是 (0 element1 1 element2)，数组的索引从 tr_array_indexs 缓存中拿，
#               索引的键 = tr_path_stack 中前 level 个元素（含根哨兵 ""，跳过它拼接） + $X。
#               如果找不到缓存，证明是第一次，那么索引为0。缓存取完后记得让缓存计数增加1。
#               tr_path_stack 更新变成 前 level 个元素。
#               推入后判断是否触发 x_qinserts 写叶子的条件是三个。
#               1>. (J)已经没有下一行
#               2>. (I)下层的缩进层级发生改变(这里只可能减少，不可能增加！)
#               3>. (E)下层是树节点(不管是字典树还是数组树都一样)
#               使用 x_qinserts 把 tr_path_stack(剪枝后的) 和 tr_leafs 所有叶子节点处理掉，
#               然后清空 tr_leafs 数组。
#           2). 如果索引后面没有 = 标识，证明当前节点是数组树节点，那么需要做如下处理(长树枝和砍树枝)。
#               1>. 长树枝(F)：如果当前的缩进层级比 tr_path_stack 多(大于等于它的数量)，先用 tr_path_stack 从缓存中拿索引，
#                   拿不到就用0，拿完后更新缓存的最大索引，把当前拿到的索引压入 tr_path_stack 中。
#               2>. 砍树枝(G)：如果当前的缩进层级比 tr_path_stack 少(小于它的数量)，那么弹出数组中
#                   多出来的元素，使用剩余的键取 tr_array_indexs 索引缓存，并且更新索引缓存，再把当前的键压入
#                   tr_path_stack 中。
#       b. 如果当前行是`{`开头(忽略前置空格)，那么证明是字典。
#          第一件事情是获取真实的字典的键。先取第一个 { 字符，然后从这个字符开始往后扫描，
#          遇到 `\` 就放行后面的那个字符。直到遇到裸的 `}` 字符，我们取到的字典的键。如果这个键后面
#          有 ` =>` 标识，标识当前是字典叶子；如果没有标识，证明是字典树。针对树和叶子，分别按照下面来
#          处理。
#           1). 如果是字典叶子：把叶子的键和值推进 tr_leafs 数组，数组中的格式是
#               (key1 value1 key2 value2)，字典的键 = 解析出的原始 key 经 str_unescape 还原，
#               token 为 {key}$X。tr_path_stack 更新为前 level 个元素（和数组叶子同一个砍树枝动作，
#               叶子不压新 token）。字典不涉及 tr_array_indexs 缓存，不取索引、不更新缓存。推入后判
#               断是否触发 x_qinserts 写叶子的条件是三个：
#               1>. 已经没有下一行
#               2>. 下层缩进层级发生改变(这里只可能减少，不可能增加！)
#               3>. 下层是树节点(不管是字典树还是数组树都一样)
#              使用 x_qinserts 把 tr_path_stack(剪枝后的) 和 tr_leafs 所有叶子节点处理掉，
#              然后清空 tr_leafs 数组。
#           2). 如果是字典树，证明当前节点是字典树节点，那么需要根据是长树枝还是砍树枝做下面的处理。
#               1>. 长树枝：如果当前的缩进层级比 tr_path_stack 多(大于等于它的数量)，那么直接把当前树
#                  节点压进去即可。
#               2>. 砍树枝：如果当前的缩进层级比 tr_path_stack 少(小于它的数量)，那么弹出数组中
#                  多出来的元素，然后把当前键压入进去。
#   具体流程详解：
#
#               t1(1) -> 
#                  0(2)           <--------- A(缓存 "" = 1)
#                      {aa ge}(4) => value2
#                      {b}(3) => value1          <------------ M
#                  1(5)           <--------- B(缓存 "" = 2)
#                      {c1}(7) => {}
#                      {key1}(15)
#                          0(16) = null    <---------- C(缓存 ""[1]$X{key1}$X = 1)
#                          1(18) = true\u001c   <------- D(缓存 ""[1]$X{key1}$X = 2)
#                          2(19)  <------- E(缓存 ""[1]$X{key1}$X = 3)
#                              0(58) <------- F(缓存 ""[1]$X{key1}$X[2]$X = 1)
#                                  {other_key}(69) => value1
#                  2(29)   <------  G(缓存 "" = 3)
#                      0(30) = null\u001c <-------  H(缓存 ""[2]$X = 1)
#                      1(31) = null\u001c <-------  I(缓存 ""[2]$X = 2)
#                  3(89) = xxvalue        <-------  J(缓存 "" = 4)
#               E 处理前：path_stack = ["", "[1]", "{key1}"] , max_index = 2     路径缓存是三层
#               E 走长树枝：我们的缩进也是三层，直接压 E 的 token → ["", "[1]", "{key1}", "[2]"]
#               然后父节点 "" -> [1] -> {key1}, max_index = 3
#               
#               F 处理时：level = 4，max_index = 空    level4 = 缩进4 长树枝 ✓
#               F 处理前：path_stack = ["", "[1], "{key1}", "[2]"], max_index = 0(空)
#               F 走长树枝：取缓存拿索引，["", "[1]", "{key1}", "[2]"] 一定是拿不到的！这个成立，所以索引为 0
#                   并且写入 缓存 ["", "[1]", "{key1}", "[2]"] , max_index = 1
#                   压入 path_stack ["", "[1]", "{key1}", "[2]", "[0]"]
#               
#               G 处理时：level = 1, path_stack = ["", "[1]", "{key1}", "[2]", "[0]"], level5 > 缩进 1
#               G 处理前：path_stack = ["", "[1]", "{key1}", "2", "[0]"]
#               G 走砍树枝：
#                   实际的弹出步骤应该是这样：
#                       先弹出 "1", "{key1}", "2", "[0]"，剩下的路径 "" 取它的 tr_array_indexs 为 2，
#                       并且更新剩下的路径(这里是 "")的 tr_array_indexs 为3.
#                       然后，把新的路径索引压进去 path_stack = ["", "[2]"]。并且更新 tr_array_indexs 的 [""] 键 为 3.
#               
#               
#               
#               t1(1) -> 
#                  {key1}
#                      {aa ge}(4) => value2
#                      {b}(3) => value1
#                  {key2} <------------- A
#                      {c1}(7) => {}
#                      {key1}(15)
#               
#               A 处理时：level = 1, path_stack = ["", "{key1}"]，砍树枝，弹出 "{key1}"，压入我们的 "{key2}".

x_rebuild_from_dump ()
{
    local tr_dump_str=$1
    local tr_line tr_line_trim
    local tr_old_ifs=$IFS
    local IFS=$'\n'
    local -i is_first_line=1
    local tr_line1_indent=
    local tr_line1_enter=0
    local -a tr_dump_list=()

    for tr_line in $tr_dump_str ; do
        tr_line_trim="${tr_line//[[:space:]]/}"
        if [[ -z "${tr_line_trim}" ||
            "${tr_line_trim}" == '#'* ]] ; then
            continue
        fi

        ((tr_line1_enter)) || {
            tr_line1_indent=${tr_line%%[! ]*}
            tr_line1_enter=1
        }
        tr_dump_list[${#tr_dump_list[@]}]="${tr_line#$tr_line1_indent}"
    done
    IFS=$tr_old_ifs

    # 如果数组的最后一个元素是 max_index => 那么剔除它
    if [[ "${tr_dump_list[-1]//[[:space:]]/}" == max_index* ]] ; then
        unset -v 'tr_dump_list[-1]'
    fi

    # 通过 tr_dump_list[1] 的前置空格和 tr_dump_list[0] 的前置空格来判断当前的
    # 缩进空格数

    local tr_indent=${tr_dump_list[1]%%[! ]*}
    local tr_indent_cnt=${#tr_indent}

    # 先处理空字典和空列表
    if ((${#tr_dump_list[@]}==2)) ; then
        case "${tr_dump_list[1]}" in
        *${X_VALUE_NULL_OBJ})
            x_init "$X_TYPE_OBJ" ; REPLY=$REPLY ; return ${X_RET_ENUM_OK}
        ;;
        *${X_VALUE_NULL_ARR})
            x_init "$X_TYPE_ARR" ; REPLY=$REPLY ; return ${X_RET_ENUM_OK}
        ;;
        esac
    fi

    # 多行字符串变单行字符串
    # extglob 在 [[]] 中从 bash4.1 开始都是默认开启的，不需要显示启用
    local IFS=$'\n' ; tr_dump_str=${tr_dump_list[*]} ; IFS="$tr_old_ifs"
    local tr_extglob=0
    shopt -q extglob || { shopt -s extglob ; tr_extglob=1 ; }
    tr_dump_str=${tr_dump_str//$'\n'*( )|/'\n'}
    ((tr_extglob)) && shopt -u extglob

    local -a tr_path_stack=("$X") tr_leafs=()
    local -A tr_array_indexs=()
    # tr_type
    #   a_tree 数组树
    #   d_tree 字典树
    #   a_leaf 数组叶子
    #   d_leaf 字典叶子
    local -a tr_lev=() tr_type=() tr_key=() tr_value=()
    mapfile -t tr_dump_list <<<"$tr_dump_str"

    _x_rebuild_from_dump_get_dict_kv ()
    {
        local tr_out_a=()
        local -i tr_begin=0
        local tr_s= tr_out= tr_rest=${tr_dump_list[tr_i]}
        while [[ -n "$tr_rest" ]] ; do
            tr_s=${tr_rest:0:1}
            tr_rest=${tr_rest:1}
            ((tr_begin)) || {
                if [[ "$tr_s" == '{' ]] ; then tr_begin=1 ; fi
                continue
            }

            if [[ "$tr_s" == '\' ]] ; then
                tr_out_a+=("$tr_s")
                if [[ -n "$tr_rest" ]] ; then
                    tr_out_a+=("${tr_rest:0:1}")
                    tr_rest=${tr_rest:1}
                fi
                continue
            fi

            [[ "$tr_s" == '}' ]] && break
            tr_out_a+=("$tr_s")
        done

        printf -v tr_out "%s" "${tr_out_a[@]}"
            #@if current_shell_process_replace==1
        tr_out=${|str_unescape "$tr_out";}
            #@endif
            #@if current_shell_process_replace==0
        str_unescape "$tr_out" ; eval "${_ret_s/o/tr_out}"
            #@endif

        tr_key[tr_i]="{$tr_out}$X"
        
        # 函数如果返回 0 表示有值(是叶子字典)
        # 函数如果返回 1 表示无值(是字典树)
        if [[ "$tr_rest" == *'=>'* ]] ; then
                # 把值写了
                tr_out=${tr_rest#*'=> '}
                #@if current_shell_process_replace==1
            tr_out=${|str_unescape "$tr_out";}
                #@endif
                #@if current_shell_process_replace==0
            str_unescape "$tr_out" ; eval "${_ret_s/o/tr_out}"
                #@endif
            tr_value[tr_i]=$tr_out
            return 0
        else
            return 1
        fi
    }

    _x_rebuild_from_dump_get_array ()
    {
        # 数组的 key 在这里没有意义，我们只返回值
        # 函数如果返回 0 表示有值(是叶子数组)
        # 函数如果返回 1 表示无值(是数组树)

        local tr_out=${tr_dump_list[tr_i]}
        if [[ "$tr_out" == *'='* ]] ; then
            tr_out=${tr_out#*'= '}
                #@if current_shell_process_replace==1
            tr_out=${|str_unescape "$tr_out";}
                #@endif
                #@if current_shell_process_replace==0
            str_unescape "$tr_out" ; eval "${_ret_s/o/tr_out}"
                #@endif
            tr_value[tr_i]=$tr_out
            return 0
        else
            return 1
        fi
    }

    local tr_i tr_ret
    for ((tr_i=1;tr_i<${#tr_dump_list[@]};tr_i++)) ; do
        tr_indent=${tr_dump_list[tr_i]%%[! ]*}
        tr_lev[tr_i]=$((${#tr_indent}/tr_indent_cnt))
        if [[ "${tr_dump_list[tr_i]}" == *( )'{'* ]] ; then
            # 字典
            _x_rebuild_from_dump_get_dict_kv ; tr_ret=$?
            if [[ "$tr_ret" == '0' ]] ; then
                tr_type[tr_i]=d_leaf
            else
                tr_type[tr_i]=d_tree
            fi
        else
            _x_rebuild_from_dump_get_array ; tr_ret=$?
            if [[ "$tr_ret" == '0' ]] ; then
                tr_type[tr_i]=a_leaf
            else
                tr_type[tr_i]=a_tree
            fi
        fi
    done

    # 先创建根节点
    if [[   "${tr_type[1]}" == a_leaf ||
            "${tr_type[1]}" == a_tree ]] ; then
            #@if current_shell_process_replace==1
        local -A "tr_out_r_tree=(${|x_init "$X_TYPE_ARR";})"
            #@endif
            #@if current_shell_process_replace==0
        x_init "$X_TYPE_ARR" ; eval "${_ret_A/o/tr_out_r_tree}"
            #@endif
    else
            #@if current_shell_process_replace==1
        local -A "tr_out_r_tree=(${|x_init "$X_TYPE_OBJ";})"
            #@endif
            #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; eval "${_ret_A/o/tr_out_r_tree}"
            #@endif
    fi

    # local i
    # for ((i=1;i<${#tr_dump_list[@]}; i++)) ; do
    #     echo "i:$i lev:${tr_lev[i]} type:${tr_type[i]} k:${tr_key[i]} v:${tr_value[i]}"
    # done
    # return 0

    # 开始处理
    local tr_idx tr_idx_key tr_n_lev
    for (( tr_i=1;tr_i<${#tr_dump_list[@]};tr_i++ )) ; do
        case "${tr_type[tr_i]}" in
        a_leaf)
            tr_n_lev=${tr_lev[tr_i]}
            tr_path_stack=("${tr_path_stack[@]:0:tr_n_lev}")
            printf -v tr_idx_key "%s" "${tr_path_stack[@]}"
            tr_idx=${tr_array_indexs[$tr_idx_key]:-0}
            tr_array_indexs[$tr_idx_key]=$((tr_idx+1))
            tr_leafs+=("[$tr_idx]$X" "${tr_value[tr_i]}")

            # 判断是否触发写叶子
            if ((tr_i+1==${#tr_dump_list[@]})) ||
                [[ "$tr_n_lev" != "${tr_lev[tr_i+1]}" ]] ||
                [[ "${tr_type[tr_i+1]}" == [ad]_tree ]] ; then
                x_qinserts tr_out_r_tree common "${tr_idx_key#$X}" "${tr_leafs[@]}"
                # 清空叶子缓存
                tr_leafs=()
            fi
        ;;
        a_tree)
            tr_n_lev=${tr_lev[tr_i]}
            if ((tr_n_lev>=${#tr_path_stack[@]})) ; then
                printf -v tr_idx_key "%s" "${tr_path_stack[@]}"
                tr_idx=${tr_array_indexs[$tr_idx_key]:-0}
                tr_array_indexs[$tr_idx_key]=$((tr_idx+1))
                tr_path_stack+=("[$tr_idx]$X")
            else
                tr_path_stack=("${tr_path_stack[@]:0:tr_n_lev}")
                printf -v tr_idx_key "%s" "${tr_path_stack[@]}"
                tr_idx=${tr_array_indexs[$tr_idx_key]:-0}
                tr_array_indexs[$tr_idx_key]=$((tr_idx+1))
                tr_path_stack+=("[$tr_idx]$X")
            fi
        ;;
        d_leaf)
            tr_n_lev=${tr_lev[tr_i]}
            tr_path_stack=("${tr_path_stack[@]:0:tr_n_lev}")
            printf -v tr_idx_key "%s" "${tr_path_stack[@]}"
            tr_leafs+=("${tr_key[tr_i]}" "${tr_value[tr_i]}")
            # 判断是否触发写叶子
            if ((tr_i+1==${#tr_dump_list[@]})) ||
                [[ "$tr_n_lev" != "${tr_lev[tr_i+1]}" ]] ||
                [[ "${tr_type[tr_i+1]}" == [ad]_tree ]] ; then
                x_qinserts tr_out_r_tree common "${tr_idx_key#$X}" "${tr_leafs[@]}"
                # 清空叶子缓存
                tr_leafs=()
            fi
        ;;
        d_tree)
            tr_n_lev=${tr_lev[tr_i]}
            if ((tr_n_lev>=${#tr_path_stack[@]})) ; then
                tr_path_stack+=("${tr_key[tr_i]}")
            else
                tr_path_stack=("${tr_path_stack[@]:0:tr_n_lev}")
                tr_path_stack+=("${tr_key[tr_i]}")
            fi
        ;;
        esac
    done
        #@if at_k_var_substitution==1
    REPLY=${tr_out_r_tree[*]@K}
        #@endif
        #@if at_k_var_substitution==0
    array_to_kv_q_str tr_out_r_tree ; REPLY=$REPLY
        #@endif
    return $X_RET_ENUM_OK
}

return 0

