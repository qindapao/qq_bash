((_XO_IMPORTED++)) && return 0

. "${BASH_SOURCE[0]%/*}/x.sh"

# ==============================================================================
# 【当前已实现】
#   - 类对象字符串缓存：${cls}ObjStr，born 时避免重新序列化
#   - 具名对象：xo_obj_born_named，固定句柄如 OBJ_plane / OBJ_canvas
#   - Mixin 方法注入：见下方【Mixin 使用说明】
# ==============================================================================

# ==============================================================================
# 【框架保留名（用户变量禁止使用）】
#
#   变量名后缀：
#     *StaticTemplate   类模板 / Mixin 模板的变量名后缀
#                       用户自定义普通变量不要以此结尾，会被 xo_init 当成模板解析
#
#   类对象变量名（由 ${类名} 推导）：
#     ${类名}Obj        类对象（x_tree 关联数组）
#     ${类名}ObjStr     类对象 KV 字符串缓存（born 时加速用）
#                       用户变量不要用这两个名字，会被框架覆盖
#
#   对象句柄：
#     OBJ_数字          自动分配句柄，如 OBJ_11，由 XO_OBJ_SEQ 递增
#     OBJ_字母开头       具名句柄，如 OBJ_plane，由 xo_obj_born_named 分配
#     整个 OBJ_ 前缀是框架保留的，用户变量不要以 OBJ_ 开头
#
#   函数名前缀：
#     类名_方法名       公共方法
#     类名__方法名      私有方法（双下划线）
#     M_Mixin名_方法名  Mixin 公共方法
#     M_Mixin名__方法名 Mixin 私有方法
#     common_*          公共行为函数（手写转发的实现）
#     xo_* / _xo_*      xo 框架内部函数
#     x_* / _x_*        x 框架内部函数
# ==============================================================================
# 扁平类设计：
# 
# $X和大括号在游戏中或者类似的不需要嵌套结构的代码中现在完全是噪音。
# 
# 可以这样。大写字母公共键不剥离。保持API兼容。用户键可剥离。所以base类的键必须
# 只能有大写键。
# 
# 然后扁平类的父类一定是扁平类。
# 
# Base上面可以做个BaseX。这样就有自己的打印函数。这样挺好。所有X树对象继承于它。
# 而非X树对象直接继承Base。
# BaseX只实现自己的打印函数。
# 
# 这样打印函数也就可以统一了。
# 
# 扁平类只保留Base的字段其他全部剥离。
# 
# FLT 标识为1。
# 
# 扁平类和树类能力Mixin可以公用，也可以分开，取决于Mixin的实现，如果Mixin支持两
# 种键名格式那么就可以公共，
# 如果只支持扁平或者树的键的格式，那么就只能支持特定的。
# 在Mixin的 {REQUIRES} => blink 字段中，申明下当前的Mixin是全支持还是只支持特性
# 的类 FLT=1 表示当前的Mixin只支持扁平类，FLT=0 表示当前的Mixin只支持树类，如果
# 没有写，那么证明当前的同时支持树和扁平类，那么Mixin的实现内部就要自己处理这两
# 类键的差异。
#
# 【Mixin 扁平声明约定 —— 强制】
# 写法固定成下面这样，FLT 必须是 {REQUIRES} 的第一个 token：
#     {REQUIRES} => FLT=1 bi_cd inv_cd      # 只支持扁平类，后面跟依赖字段
#     {REQUIRES} => FLT=0                   # 只支持树类
#     {REQUIRES} => hp maxhp                # 不写 FLT = 树/扁平都支持
# 规则：
#   1) FLT 只能写在第一位，其它依赖字段跟在它后面（空格分隔）。位置不能变。
#   2) FLT=1 → 只支持扁平类；FLT=0 → 只支持树类；框架会拒绝不匹配的组合。
#   3) 不写 FLT → 默认两种都支持；此时 Mixin 的实现必须自己兼容两种键：
#      读字段要么同时处理 self[x] 和 self["{x}$X"]，要么通过框架访问器；
#      只按一种键写，在另一种类上会静默读到空值。
#   4) 框架用 token 边界 regex 判断（(^|空白)FLT=1(空白|$)），所以 FLT 后面跟字段、
#      跟换行、或直接在行尾都能识别；FLT=10 不会误判。为了可读性，仍然强制写在第一位。
#
# 【键名规则（扁平类 vs 树类）】
#   元键（两类都保留 {} 和 $X）：
#       {CLS}$X  {SUP}$X  {MIX}$X  {OBJMIX}$X  {FLT}$X
#   用户字段：
#       扁平类（FLT=1）：{hp}$X → hp        self[hp] / obj[hp]
#       树类  （FLT=0）：保持 {hp}$X 原样    self["{hp}$X"]
#   扁平类剥离后不再有 x 树内部节点（1.c.* / max_index 等），也不能再用
#   x_get/x_set 一类的树接口访问它。
# 
# 再增加一个语义，树的父亲可以是扁平。但是扁平的父亲不可以是树。所以Base就是扁
# 平对象。儿子的能力一定比父亲强而不能退化。但是一旦一条扁平继承链中的一个子类
# 进化成了树，那么它的父类也需要跟着一起升级，应该字段的规则都不一样的。所以一
# 般建议不要这么设计，如果扁平类确实需要一个树形的容器，更好的做法是在它的内部
# 直接组合一个树容器对象。而不是让自己升变。升变造成的
# 影响和后果是无法估量的，因为你不知道是否有人在类以外直接访问了类的字段，排查
# 起来非常麻烦。
# 
# 语义闭环。可以这么理解。扁平可以升级树。但是树只要是树就不能退化成扁平。就是
# 这个意思。只是升级很麻烦，但是Base和BaseX特殊，因为Base只有大写的元键，所以
# BaseX继承它的时候没有任何干扰，
# Base的字段不需要进行任何的剥离。这是唯一的特殊。
# 
# Base的打印函数就是打印关联数组。子类如果是x_tree需要自己实现打印函数。
# 
# 所以后期如果扁平类想升级成x_tree类。除了改实现中和使用代码中的键名和分隔符方
# 式。还要把模板中的根类指向BaseX，而不再是Base了。
# 
# 扁平类的对象拥有随便写字段的能力，但是还是建议要用的所有字段都在模板中定位好，
# 可定位可追溯。
# 
# 模板定义的时候扁平类和树类完全相同。最大不同是FLT字段的值一个是1一个是0。其他
# 字段规则完全相同。是否剥离大括号和$X发生在类对象生成的时候。
# 
# 继承描述的是「它本身是一种什么东西」；组合描述的是「它拥有一个附属部件」。这两
# 个本来就不是一回事。
# 
# 组合对象的Mixin链不自动传播，这一直是我们的设计原则，如果用户要调用组合对象的
# Mixin，那么他直接显式调用就行。


# ==============================================================================
# 【Mixin 使用说明】
#
# 当前版本支持 Mixin「方法注入」：
#   - {MIX} 字段：空格分隔的 Mixin 名列表，如 {MIX} => M_Swimmer M_Flyer
#   - 只注入方法，不注入字段（字段注入是明确不做的设计决定，见下文）
#   - 不做 {REQUIRES} 校验（当前仅作文档）
#
# 自动注入的优先级（由 xo_init 的注入顺序保证）：
#   类自身方法（含手写转发） > Mixin 方法 > 继承透传方法
# 即：子类自己定义的 > Mixin 注入的 > 从父类透传下来的。
#
# ------------------------------------------------------------------------------
# 【Mixin 当前实现状态】
#
#   已实现：
#     - Mixin 方法注入：xo_init 时从全局函数空间收集 M_Mixin名_* 方法，注入到类
#     - 优先级：类自身（含手写转发） > Mixin 注入 > 继承透传
#     - 多 Mixin 按 {MIX} 列表顺序，前面的优先
#     - 对象级动态 Mixin：运行期按对象增删（见下文【对象级 Mixin】）
#
#   M_XxxStaticTemplate 当前的作用：
#     - 文档：声明 Mixin 名、{REQUIRES} 字段依赖
#     当前 xo_init 完全跳过 M_*StaticTemplate（不解析、不建对象）
#
# ------------------------------------------------------------------------------
# 【明确不做的三件事（deliberate non-goals，不是 TODO）】
#
#   下面三条是可预见的"增强"，**决定不做**。原因不是实现难，而是它们会把
#   "字段/依赖从哪来"变成运行期推导，排查成本远大于收益。
#
#   1) Mixin 字段注入（{FIELDS} + 优先级 类自身 > Mixin > 继承）—— 不做
#
#      一旦允许 Mixin 往对象里补字段，一个对象的最终字段集就是
#      「类模板 + 若干 Mixin 模板 + 继承链」按优先级合并的结果。查一个字段时，
#      你无法只读一个模板就回答"它有没有、默认值是多少、谁覆盖了谁"，必须重建
#      整个合并过程；更糟的是"我明明写了默认值却没生效"——因为类模板里也声明了
#      同名字段，静默覆盖。
#
#      现在的规则只有一条，且是可 grep 的：
#        字段集 = 类模板声明的那一份；运行期不新增字段。
#      所以对象 Mixin 只注入方法。能力需要状态时，由类模板先声明字段
#      （例：BossBase 声明 {bi_cd}/{ms_cd}/{heal_cd} 给 INV/MIS/HEAL 用）。
#      这条耦合是**故意的**：它让"这个能力要哪些状态"出现在模板里、出现在 review 里。
#
#      将来真有"某个能力需要一堆状态"的情况，更好的替代是——在已声明的容器字段
#      下开命名空间，一个字段解决：{_state}$X{M_xxx}$X{count}$X 之类
#      （见上文临时属性约定）。
#      不需要框架去合并模板。
#
#   2) {REQUIRES} 运行期依赖校验 —— 不做
#
#      Mixin 读的字段由使用方保证（契约）。在 xo_init / 每次 add 时校验，等于把
#      一个静态可查的问题搬到运行期，还给热路径加检查；而且对象级 Mixin 的
#      add 在 tick 内发生，出错时机的语义更难界定。
#
#      更好的位置是测试期：写一个用例断言"每个使用 Mixin 的类都声明了它的
#      {REQUIRES} 字段"。零运行期成本，失败信息还带类名与字段名。
#      在没写这个用例之前，{REQUIRES} 就是文档，这是可接受的。
#
#   3) xo_obj_call_all 回落类方法 —— 不做（语义选择，不是缺口）
#
#      它是钩子扇出：每个持有者各跑一次；"没实现"的含义是"这个能力没有这类状态"，
#      不是"请用默认行为"。加回落会逼类侧留着空实现（那种空壳我们删过两次），
#      还会在钩子名与能力名撞车时把无关类方法当成默认钩子跑起来。
#      需要类侧参与时，显式在调用点写：类级逻辑 + xo_obj_call_all，顺序可见。
#
#   判据（以后想加增强时先过这一条）：
#      如果引入后，"某字段/某方法的实际来源"不能再靠**读一个地方**回答，
#      就不加。可推导性优先于少写几行声明。
#
# ------------------------------------------------------------------------------
# 【推荐做法：优先手写转发，需要时再用 Mixin 自动注入】
#
# 两种方式并存，手写转发优先级最高（它就是「类自身方法」）：
#
# 1) 手写转发（推荐用于「少数类共享」）：
#
#      common_restart() {
#          local -n self=$1
#          local dev=${self[{device_id}$X]}
#          do_reset "$dev"
#      }
#
#      Device_restart() { common_restart "$@" ; }    # 手写转发
#
# 2) Mixin 自动注入（推荐用于「多个不相关类共享」）：
#
#      M_RestartableStaticTemplate='
#          M_RestartableObj ->
#              {CLS} => M_Restartable
#              {MIX} =>
#          '
#
#      M_Restartable_restart() {
#          local -n self=$1
#          local dev=${self[{device_id}$X]}
#          do_reset "$dev"
#      }
#
#      # 类模板中声明
#      DeviceStaticTemplate='
#          DeviceObj ->
#              {CLS} => Device
#              {SUP} => Base
#              {MIX} => M_Restartable
#      '
#
# 优先级：手写转发 > Mixin 注入 > 继承透传。同一方法名，手写转发优先。
# 迁移到 Mixin 时，先删掉手写转发，再在 {MIX} 里声明 Mixin 名。
#
# ------------------------------------------------------------------------------
# 【手写转发的 5 个优势（为什么仍推荐优先用它）】
#
#   - bash 函数天然全局可调用，手写转发只需一行，Mixin 省不了多少
#   - 手写转发显式可见，Mixin 自动注入是 xo_init 时 eval 生成，代码里搜不到
#   - 手写转发 set -x 一眼看到调用链，Mixin 需要理解优先级规则才能调试
#   - 手写转发是局部修改，Mixin 是全局重算（改一个 Mixin 影响所有使用方）
#   - 手写转发无「注入时机」概念，Mixin 要考虑 xo_init 前/后、字段/方法
#
# 判据：手写转发总数 < 30 行时，手写更划算；超过 30 行或需要声明式
#       能力查询时，再迁移到 Mixin。
#
# ------------------------------------------------------------------------------
# 【子类使用 Mixin 公共函数的规范】
#
#   - Mixin 公共方法命名：M_Mixin名_方法名（单下划线），注入到类
#   - Mixin 私有方法命名：M_Mixin名__方法名（双下划线），不注入
#   - 多 Mixin 同名方法：{MIX} 列表前面的优先（后处理时 declare -F 跳过已有）
#   - Mixin 内部只依赖 self 的字段，字段由使用方保证（契约）：
#       使用方类模板必须提供 Mixin 读取的字段，如 {device_id}
#   - Mixin 不要依赖「自己属于哪个类」，它是纯粹的「行为实现」
#   - Mixin 不要改 self 的元数据字段（{CLS}/{SUP}/{MIX}）
#
#   手写转发（common_* 函数）的临时状态：
#       - 默认不往 self 写临时属性，用局部变量 + REPLY 返回值
#       - 若确需跨调用保持状态，用「类别 + 子键」的两级命名空间
#         （下文的 {_x}{...} 都是这种简写；物理键形如 {_common_restart}$X{call_cnt}$X）：
#           如 {_common_restart}{call_cnt}
#       - 类字段禁止 common_ 开头（避免跟公共函数临时状态撞车）：
#           · 临时属性根 key 不能用 {_common_xxx}{...}
#           · 公共属性不能用 {common_xxx}
#           · 私有属性天然不冲突（{_大驼峰_字段}，common 是小写）
#       - 类的临时属性推荐语义化小写类别：
#           {_cache}{...}  {_tmp}{...}  {_state}{...}  {_retry}{...}
#
# ------------------------------------------------------------------------------
# 【Mixin 需要自己维护状态时怎么办】
#
#   不要指望字段注入（见上文【明确不做的三件事】）。按优先级两种做法：
#
#   1) 使用方类模板先声明标量字段（推荐，也是唯一适合每 tick 写的做法）：
#        BossBase 为 INV/MIS/HEAL 声明 {bi_cd}/{ms_cd}/{heal_cd} 就是这种。
#      Mixin 在方法里直接读写，前提是使用方保证（契约，{REQUIRES} 里写明）。
#
#   2) 状态确实很多时，可在**模板里用缩进声明的容器字段**下开命名空间：
#        模板：   {_state}          （中间容器不写箭头）
#                     {M_Cache}
#                         {count} => 0
#        运行期：只往里写叶子，走 x_insert_token_dict / x_insert_dict / x_qinserts
#
#      两个硬约束：
#        - 容器必须在模板里声明（空容器模板表达不了，见下文【值的类型标记】）。
#          运行期绝不能手写 self[$k]='{}'：会绕过 x 的节点与索引维护
#          （.c / .s / max_index / .t），结构直接坏掉，x_walk / x_dump 读出来是错的。
#        - 运行期"造新节点"等于字段集偏离模板（字段注入的变体），只适合低频状态；
#          每 tick 都要写的请用做法 1。
#
#      现状：本仓库没有任何运行期造节点的调用点（grep 可证）。需要状态时先问
#      "能不能在模板里加一个字段"——通常可以，而且更便宜。
#
# ==============================================================================
#
# 命名空间约定：
#   - 用户类：大驼峰，如 Animal / NetworkCard
#   - Mixin：M_ 前缀 + 大驼峰，如 M_Swimmer / M_Flyer
#   - M_ 前缀是 Mixin 保留的命名空间，用户类不要用 M_ 开头
#
# 模板会自动生成类对象 BaseObj
#
# M_Swimmer_swim() { ... }

# 类名      ->  大驼峰
# 方法名    ->  小写蛇形
# Mixin类   ->  M_大驼峰
# Mixin方法 ->  小写蛇形
#
# 元类属性      {大写字段,如CLS等}  拷贝(除了定义该定义的值用户不要去乱设置值或者增删)
# 公共属性      {小写蛇形}          拷贝
# 私有属性      {_类名_小写字段}    拷贝（父类方法要用），类名大驼峰
# 公共方法      类名_方法名         透传生成
# 私有方法      类名__方法名        不生成（子类调不到）
# 临时属性      {_小写类别}{...}    不继承（运行时对象的动态数据，真子容器）
# Mixin 方法    M_Mixin名_方法名    注入时生成

# 【值的类型标记：哨兵值】
#   x 用「内容 + 分隔符 $X」表示特殊值（定义在 x.in 顶部）：
#     X_VALUE_NULL     = "null$X"    显式 null（有键、值为空）
#     X_VALUE_NULL_OBJ = "{}$X"      空字典
#     X_VALUE_NULL_ARR = "[]$X"      空数组（另有 TRUE / FALSE）
#
#   $X 就是键路径里那个分隔符，默认 $'\034'（0x1C），**可自定义**：担心数据里
#   出现 0x1C 时，把 X 换成更长的序列即可（x.in 顶部已留了 $'\034\035\036\037'
#   的写法），其余代码不用改。
#   分隔符是值的一部分：没有它的 "null" / "{}" 只是普通字符串。x_insert* 靠这个
#   后缀写 .t 类型位，x_type_of / x_dump 靠它还原语义；xo 的类继承树就是用
#   X_VALUE_NULL 插入节点、再由 x_insert 在有子类时自动升变容器。
#
#   我们只关心两个：NULL 与 空字典。**解析器支持把它们写进模板**，但本项目约定
#   不这么写——理由是写法别扭、易错，不是能力缺失（实测）：
#
#     {f} => ${X_VALUE_NULL_OBJ}   正确建出空字典（节点 .t = X_TYPE_OBJ，无叶子值）
#     {f} => ${X_VALUE_NULL}       正确建出 null 叶子
#     {f} => {}                    串 "{}"：缺分隔符 → 普通标量，不是空字典
#
#   为什么不写：
#     - 模板是单引号字符串，插哨兵变量得断开引号拼接；换成 heredoc 又会把缩进与
#       反斜杠转义搞乱（模板对缩进敏感），比直接写字段难维护得多；
#     - 漏掉分隔符不会有任何报错，只会静默退化成普通字符串——最难查的一类错；
#     - 真需要空容器 / null 时，运行期 x_insert* 直接传哨兵变量，意图更清楚。
#
#   附：解析顺序是「先定键、再看值」——
#     · 键：从 `{` 开始扫，`\` 会连同下一个字符一起跳过，所以 `\}` 不会闭合，
#       遇到**未转义**的 `}` 才闭合；键文本随后做一次 str_unescape；
#     · 值：闭合之后到行尾的剩余部分里找 `=>`，取 `=> ` 之后的内容，同样
#       str_unescape 一次。
#   因此值以 `{` 开头**不会**被误判成键（键的扫描早已结束）。两者的差别在
#   「键要处理转义括号、值不需要」，反转义本身是同一套 str_unescape。
#   键里要带右括号必须写 `\}`（值里不用，也不需要）。但这种键名极难维护，
#   不建议这么干——命名里用下划线/字母数字，别用花括号。
#
# 【模板的边界：只能表达静态结构】
#   模板是字面量字符串：值不展开变量，键不能动态生成。
#
#   结构标记只有一条规则：**只有字典叶子写 `=>`**，其余（含中间容器）都不写箭头；
#   `->` 只出现在首行的对象名上，纯装饰（解析器只检测 `=>`）。
#
#       FooObj ->                     ← 首行：对象名 + ->
#           {_state}                  ← 中间容器：只有键名，不写箭头
#               {M_Cache}
#                   {count} => 0      ← 叶子：=> 后面是值
#       # 叶子物理键 = {_state}$X{M_Cache}$X{count}$X
#
#   常见错法（都实测过）：
#       {k} =>           容器，但解析器报 "'=> ' without trailing space"（噪声）
#       {k} =>  (带空格)  变成叶子（值为空），嵌套直接失效
#       {k} ->           能解析成容器（解析器只认 `=>`），但不是约定写法，别用
#
#   带变量的内容（运行期算出的键或值）只能在运行期写，且必须走 x 的插入 API，
#   不能直接给关联数组赋值（会绕过 .c/.s/max_index/.t 维护）。
#   所以容器字段的现实用法是：模板声明固定骨架，内容运行期填；
#   每 tick 都要写的状态一律用标量字段。
#
# 标量 = 类型固定的值
#   子类不能改类型。改类型 x_insert 报错。
#
# 注意：Base 的 {SUP} 为空表示「无父类」，与 NULL=扩展点 语义无关，
# Base 是唯一特例。

# ---------------- 根类区域 --------------------------------------------------
# 模板规范：
#   {字段} => 值
#     - "=> " 后的第一个空格是语法部分，不属于值
#     - 值后面不要有尾随空格，否则会被当作值的一部分
#     - 值前面不要加额外空格，否则会被当作值的一部分
#   此规则对 {CLS} / {SUP} / {MIX} 及所有用户字段统一生效。
#
#   例（正确）：{CLS} => Base        -> 值为 `Base`
#   例（正确）：{CLS} =>             -> "=> " 后无内容，值为空
#   例（错误）：{CLS} => Base[SP]    -> 尾随空格进值，CLS 变成 "Base "
#   例（错误）：{CLS} =>[SP][SP]Base -> 第二个空格进值，值为 " Base"
readonly BaseStaticTemplate='
    BaseObj -> 
        # 类名（所有类的根，唯一允许 {SUP} 为空的类）
        {CLS} => Base
        # 父类名：Base 为空表示无父类，是唯一特例
        {SUP} => 
        # 类级 Mixin 列表（空格分隔，顺序即优先级）：类自身 > 靠前的 Mixin > 继承
        {MIX} => 
        # 是否是扁平类，默认Base是扁平类是一切类的跟
        # 由于它没有小写键，所以只剥离树中的工具键，外观看起来它是扁平类
        # 或者x_tree完全没有区别
        {FLT} => 1
    '

# 暂时不关注顺序，如果以后对顺序有要求可以对键排序
Base_print () {
    local -n self=$1
    local key
    printf "%s ->\n" "$1"
    for key in "${!self[@]}" ; do
        printf "    %s => %s\n" "${key@Q}" "${self[$key]@Q}"
    done
}

Base_born ()
{
    # 默认构造后钩子，子类可覆盖：模板字段已写入、对象已进池之后调用
    # $1=对象句柄，$2..=用户构造参数
    :
}

Base_retire ()
{
    # 默认"退役"钩子（对应 born）：对象**离开世界**之前调用，子类可覆盖。
    # 两种离开方式共用它：bury（肉体也销毁）和 fire（肉体留着待返聘）。
    # 这里要理解成"埋葬对象的记忆与灵魂"，不是消灭它的肉体：
    # 帧上残留要擦掉、持有的其它对象要一并退役（例：Plane_retire 处理武器对象）。
    # 框架要求每个类都有 <CLS>_retire（继承 Base_retire 即可），缺失会被当成错误。
    # $1=对象句柄
    :
}

Base_class ()
{
    local -n self=$1
    REPLY=${self[{CLS}$X]}
}

Base_is_a ()
{
    local obj=$1 expect=$2
    # 不是受管对象（已销毁或非法），返回 1
    [[ -z "${XO_OBJ_POOL[$obj]+_}" ]] && return 1
    local cls
    local -n self=$obj
    cls=${self[{CLS}$X]}

    while [[ -n "$cls" ]] ; do
        [[ "$cls" == "$expect" ]] && return 0
        [[ "$cls" == 'Base' ]] && break
        local -n c=${cls}Obj
        cls=${c[{SUP}$X]}
    done
    return 1
}

# ----------------------------------------------------------------------------
# 所有的 x_tree 类的根，它本身是 Base 子类，Base是所有扁平类的根
readonly BaseXStaticTemplate='
    BaseXObj -> 
        # 类名（所有 x_tree 类的根）
        {CLS} => BaseX
        {SUP} => Base
        # 类级 Mixin 列表（空格分隔，顺序即优先级）：类自身 > 靠前的 Mixin > 继承
        {MIX} => 
        # 不是扁平类，是 x_tree
        {FLT} => 0
    '

BaseX_print () { x_dump "$1" '' 4 2 ; }

# ----------------------------------------------------------------------------

# 继承树（x_tree 对象）：每个非根节点的 physical_full_key 路径即继承链
# tree -> 
#     Base (容器)
#     └── A (容器)
#         ├── B (容器)
#         │   └── C (叶子)
#         └── D (叶子)
# 每个类插入时值统一写 X_VALUE_NULL，有子类的节点由 x_insert 自动升变成容器
declare -gA CLASS_INHER_TREE=()
declare -gA XO_METHOD_INHERITED=()



_xo_init_get_class_inher_chain ()
{
    local -a class_template_vars=()
        #@if compgen_v==1
    compgen -V class_template_vars -A variable -X '!*StaticTemplate'
        #@endif
        #@if compgen_v==0
    class_template_vars=($(compgen -A variable -X '!*StaticTemplate'))
        #@endif

    local var_name super cls
    local -A cls_super=()
    local re='^([ ]+)\{SUP\} => (.*)$'

    # ---- 1. 收集 类名 -> 父类名（排除 Mixin 和 Base 自身）----
    for var_name in "${class_template_vars[@]}" ; do
        [[ "$var_name" == M_*StaticTemplate ]] && continue
        cls=${var_name%StaticTemplate}
        [[ "$cls" == 'Base' ]] && continue

            #@if current_shell_process_replace==1
        super=${|str_grep_first_line "${!var_name}" "$re" 2;}
            #@endif
            #@if current_shell_process_replace==0
        str_grep_first_line "${!var_name}" "$re" 2
        eval "${_ret_s/o/super}"
            #@endif

        # 契约：除 Base 外，所有类的 SUPER 非空
        if [[ -z "$super" ]] ; then
            die ERR "Class:$cls SUPER is NULL (only Base have empty SUPER)!"
            return 1
        fi

        cls_super[$cls]=$super
    done

    # ---- 2. 初始化继承树 ----
        #@if current_shell_process_replace==1
    declare -gA "CLASS_INHER_TREE=(${|x_init "$X_TYPE_OBJ";})"
        #@endif
        #@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; eval "${_ret_g_A/o/CLASS_INHER_TREE}"
        #@endif

    # ---- 3. 每个类往上回溯拼路径，插入树 ----
    #
    # 【幂等插入】
    #   x_insert 不允许往已有 children 的节点写叶子值。
    #   当某个子类先被处理时，它的中间祖先节点（如 Entity）会被自动
    #   升变成容器；此时再单独插入祖先自身（写 NULL），就会触发
    #   "have children" 错误。
    #
    #   修复：先查路径是否存在，存在就跳过。x_get_node_type 用 path 模式
    #   探测，返回 UNKNOWN 说明路径不存在，可以插入；否则（叶子/容器）
    #   说明已经存在（作为叶子写过，或作为容器被升变过），跳过。
    #
    local cur path seg
    local -a chain
    local -A _visited=()

    for cls in "${!cls_super[@]}" ; do
        chain=() cur=$cls _visited=()

        while [[ "$cur" != 'Base' ]] ; do
            # 悬空引用：SUPER 指向一个未定义的类
            if [[ -z "${cls_super[$cur]+_}" ]] ; then
                die ERR "Class:$cls SUPER chain hits undefined"\
                        "class:$cur (path: ${chain[*]} -> $cur)"
                return 1
            fi
            # 环检测：路径上重复出现
            if [[ -n "${_visited[$cur]+_}" ]] ; then
                die ERR "Class:$cls SUPER chain circular"\
                        "at:$cur (path: ${chain[*]} -> $cur)"
                return 1
            fi
            _visited[$cur]=1
            chain=("$cur" "${chain[@]}")     # 头插，保持 Base→...→cls 顺序
            cur=${cls_super[$cur]}
        done

        # 拼物理路径：{Base}$X{A}$X{B}$X{C}$X
        path="{Base}$X"
        for seg in "${chain[@]}" ; do
            path+="{$seg}$X"
        done

        # 幂等插入：路径不存在才写，存在就跳过
        x_get_node_type CLASS_INHER_TREE "$path" path
        if [[ $? == "$X_NODE_KIND_UNKNOWN" ]] ; then
            x_insert CLASS_INHER_TREE "$path" "$X_VALUE_NULL" || {
                die ERR "Class:$cls failed to insert into CLASS_INHER_TREE"\
                        "(path:$path)"
                return 1
            }
        fi
    done

    return 0
}

_xo_check_mixin_to_class_match ()
{
    local cls=$1 mixin=$2 flat
    local -n cls_obj="${cls}Obj"
    local -n mixin_tmpl="${mixin}StaticTemplate"
    flat=${cls_obj[{FLT}$X]}
    # 约定：FLT 必须是 {REQUIRES} 的第一个 token（见文件头的"Mixin 扁平声明约定"）。
    # 用 regex 匹配 token 边界：FLT 写在行尾、后面跟换行/空格都能识别；FLT=10 不会误判。
    if ((flat==1)) && [[ "$mixin_tmpl" =~ (^|[[:space:]])FLT=0([[:space:]]|$) ]] ; then
        die ERR "Cls:${cls} FLT=1 but mixin:${mixin} FLT=0"
        return 1
    elif ((flat==0)) && [[ "$mixin_tmpl" =~ (^|[[:space:]])FLT=1([[:space:]]|$) ]] ; then
        die ERR "Cls:${cls} FLT=0 but mixin:${mixin} FLT=1"
        return 1
    fi
    return 0
}

# 扁平类保留的元键（其余字段一律剥成扁平键）。和 _xo_field_key 的判定保持一致。
declare -gA XO_FLAT_META=(
    ["{CLS}$X"]=1
    ["{SUP}$X"]=1
    ["{MIX}$X"]=1
    ["{OBJMIX}$X"]=1
    ["{FLT}$X"]=1
)

# 根据所有的类模板变量动态生成所有类的类对象，并且动态更新类实例函数。
# 当前 x_walk 的顺序本来就能保证是 拓扑序（父先于子），但是不是 DFS 前序
# 所以按照 x_walk 的顺序直接覆盖就行。
#
# 扁平类（FLT=1）在构建时就写成扁平关联数组：不建 x 树、不插节点，
# 只在最后序列化一次 ObjStr。树类（FLT=0）仍走原来的"拷贝父类树 + x_insert"路径。
#
# ---- 初始化进度（可选，默认关闭） ----
# 调用方在 xo_init 之前设置 XO_INIT_PROGRESS=1 打开，输出走文件描述符
# XO_INIT_PROGRESS_FD（默认 2=stderr）。游戏里用 fd 1（stdout）并在备用屏幕内显示，
# 退出时随备用屏幕一起消失。默认关闭，所以测试/管道输出不会被打扰。
#
# 性能：计数用一次 compgen 变量扫描（不额外 x_walk 继承树），绘制只在每类结束时
# 做一次，27 个类 = 27 次 printf，实测在噪声内。
declare -g XO_INIT_PROGRESS=${XO_INIT_PROGRESS:-0}
declare -g XO_INIT_PROGRESS_FD=${XO_INIT_PROGRESS_FD:-2}
declare -gi XO_INIT_TOTAL=0
declare -gi XO_INIT_DONE=0
# 整行布局：loading classes  19/27  [###############       ]  72%
declare -gi XO_PROGRESS_BAR_MAX=24

_xo_progress_count ()
{
    XO_INIT_TOTAL=0
    local -a tmpl_vars=()
        #@if compgen_v==1
    compgen -V tmpl_vars -A variable -X '!*StaticTemplate'
        #@endif
        #@if compgen_v==0
    tmpl_vars=($(compgen -A variable -X '!*StaticTemplate'))
        #@endif
    local v
    for v in "${tmpl_vars[@]}" ; do
        # M_ 开头的是 Mixin 模板，不是类
        [[ "$v" == M_* ]] && continue
        XO_INIT_TOTAL=$(( XO_INIT_TOTAL + 1 ))
    done
}

_xo_progress_draw ()
{
    (( XO_INIT_PROGRESS )) || return 0
    local -i pct=0 bars=0 width=${COLUMNS:-80} barw=0 linelen=0 padv=0
    (( XO_INIT_TOTAL > 0 )) && pct=$(( XO_INIT_DONE * 100 / XO_INIT_TOTAL ))
    # 终端宽度自适应：整行不超过 COLUMNS-2；窄终端缩条，宽终端最多 24 格
    barw=$(( width - 33 ))
    (( barw < 8 )) && barw=8
    (( barw > XO_PROGRESS_BAR_MAX )) && barw=$XO_PROGRESS_BAR_MAX
    bars=$(( pct * barw / 100 ))
    local bar='' pad=''
    (( bars > 0 )) && printf -v bar '%*s' "$bars" ''
    bar=${bar// /#}
    printf -v bar '%-*s' "$barw" "$bar"
    # 居中：用最大行宽算一次，保证每次 \r 重画位置不变
    linelen=$(( 31 + barw ))
    (( width > linelen )) && padv=$(( (width - linelen) / 2 ))
    (( padv > 0 )) && printf -v pad '%*s' "$padv" ''
    printf '\r%sloading classes %3d/%d  [%s] %3d%% ' \
        "$pad" "$XO_INIT_DONE" "$XO_INIT_TOTAL" "$bar" "$pct" >&"$XO_INIT_PROGRESS_FD"
}

_xo_progress_finish ()
{
    (( XO_INIT_PROGRESS )) || return 0
    _xo_progress_draw
    printf '\n' >&"$XO_INIT_PROGRESS_FD"
}

_xo_init_class ()
{
    _xo_init_class_cb ()
    {
        # leaf / leaf_null / obj / obj_empty / arr / arr_empty
        local token=$5 full_key=$6 tmp_key k
        local cls=${token:1:-1} father=${full_key%"$X$token$X"}
        father=${father##*"$X"}
        father=${father:1:-1}

        # 获取当前类对象
        local tmpl_var="${cls}StaticTemplate"
            #@if current_shell_process_replace==1
        local obj_kv ; obj_kv=${|
            x_rebuild_from_dump "${!tmpl_var}";}
        if (($?)) ; then
            die ERR "Class Template:${cls}StaticTemplate is invalid!"
            return 1
        fi
        local -A "temp_obj=($obj_kv)"
            #@endif
            #@if current_shell_process_replace==0
        x_rebuild_from_dump "${!tmpl_var}" || {
            die ERR "Class Template:${cls}StaticTemplate is invalid!"
            return 1
        }
        eval "${_ret_A/o/temp_obj}"
            #@endif
        # 扁平属性：模板显式声明的 FLT 优先，否则继承父类（Base 是根，模板里声明了 FLT=1）。
        # 扁平类的父类一定是扁平类；树类的父类可以是树类，也可以是 Base（BaseX 场景）。
        local flat=1
        local -i is_flat_father=0
        if [[ "$cls" != 'Base' ]] ; then
            local -n father_obj0=${father}Obj
            is_flat_father=${father_obj0[{FLT}$X]:-0}
            if [[ -n "${temp_obj[{FLT}$X]+_}" ]] ; then
                flat=${temp_obj[{FLT}$X]}
            else
                flat=$is_flat_father
            fi
        fi

        if (( flat )) ; then
            # ---- 扁平类：不建 x 树；父类(扁平)KV 直接拷贝，模板叶子按扁平键写入 ----
            # 和以前的"建树再剥离"相比，这里少一整趟遍历，也少一次重新序列化。
            if [[ "$cls" == 'Base' ]] ; then
                declare -gA "BaseObj=()"
            else
                    #@if at_k_var_substitution==1
                declare -gA "${cls}Obj=(${father_obj0[*]@K})"
                    #@endif
                    #@if at_k_var_substitution==0
                array_to_kv_q_str ${father}Obj ; eval "${_ret_g_A/o/${cls}Obj}"
                    #@endif
            fi
            local -n _flat_obj="${cls}Obj"

            # 这里的 temp_obj 必须只有一层，所以完全不用走树遍历，直接
            # 关联数组原生遍历更快
            for tmp_key in "${!temp_obj[@]}" ; do
                if [[ -n "${XO_FLAT_META[$tmp_key]+_}" ]] ; then
                    _flat_obj[$tmp_key]=${temp_obj[$tmp_key]}
                elif [[ "$tmp_key" == '{'* ]] ; then
                    k=${tmp_key%'}'*}
                    _flat_obj[${k:1}]=${temp_obj[$tmp_key]}
                fi
                # 其它键全部丢弃
            done
            # Base 是根：没有父类，也不需要更新/透传实例方法
        elif (( is_flat_father )) ; then
            # ---- 树类，但父类是扁平类（当前只有 Base -> BaseX 这一种） ----
            # 扁平父类不能有用户字段：树类没法从扁平键继承字段，混着建会得到混合键。
            # Base 只有元键，所以 BaseX 合法；其它情况直接报错，不允许"扁平升变为树"。
            for k in "${!father_obj0[@]}" ; do
                [[ -n "${XO_FLAT_META[$k]+_}" ]] || {
                    die ERR "Cls:${cls}: 树类的父类 ${father} 是扁平类且含用户字段 '${k}'（禁止扁平升变为树）"
                    return 1
                }
            done
            # 父类只有元键，自己的模板里已经包含这些元键，直接从模板建树。
                #@if at_k_var_substitution==1
            declare -gA "${cls}Obj=(${temp_obj[*]@K})"
                #@endif
                #@if at_k_var_substitution==0
            array_to_kv_q_str temp_obj ; eval "${_ret_g_A/o/${cls}Obj}"
                #@endif
        else
            # 树类 + 树父类：复制父类树，再把当前类的叶子 x_insert 上去
                #@if at_k_var_substitution==1
            declare -gA "${cls}Obj=(${father_obj0[*]@K})"
                #@endif
                #@if at_k_var_substitution==0
            array_to_kv_q_str ${father}Obj ; eval "${_ret_g_A/o/${cls}Obj}"
                #@endif

            _xo_init_class_cb_insert_cb ()
            {
                local type=$1 value=$4 full_key=$6
                if [[ "$type" != "$X_NODE_KIND_OBJ" &&
                      "$type" != "$X_NODE_KIND_ARR" ]] ; then
                    x_insert "${cls}Obj" "$full_key" "$value"
                    return $?
                else
                    return 0
                fi
            }

            x_walk temp_obj '' _xo_init_class_cb_insert_cb || {
                die ERR "Class:${cls} cover father:${father} fail!"
                return 1
            }
        fi

        if [[ "$cls" != 'Base' ]] ; then
            # ---- Mixin 方法注入（在继承透传之前，保证 Mixin 优先于继承） ----
            # 优先级：类自身方法 > Mixin 方法 > 继承透传方法
            # Mixin 公共方法命名：M_Mixin名_方法名（单下划线）
            # Mixin 私有方法命名：M_Mixin名__方法名（双下划线），不注入
            # 多 Mixin 同名方法：{MIX} 列表前面的优先（后处理时 declare -F 跳过已有）
            local -n mix_self="${cls}Obj"
            local mix_list=${mix_self["{MIX}$X"]}

            if [[ -n "$mix_list" ]] ; then
                local mix mix_pattern mix_fn mm
                local -a mix_methods=()
                for mix in $mix_list ; do
                    # 校验混入的Mixin和当前类的扁平属性是否匹配
                    _xo_check_mixin_to_class_match "$cls" "$mix" || return $?
                    printf -v mix_pattern '!%s_[!_]*' "$mix"
                        #@if compgen_v==1
                    compgen -V mix_methods -A function -X "$mix_pattern"
                        #@endif
                        #@if compgen_v==0
                    mix_methods=($(compgen -A function -X "$mix_pattern"))
                        #@endif
                    mix_methods=("${mix_methods[@]#${mix}_}")

                    for mm in "${mix_methods[@]}" ; do
                        mix_fn="${cls}_${mm}"
                        # 类自身已有 → 保留（类自身优先）
                        # 前面的 Mixin 已注入 → 保留（列表前面的优先）
                        declare -F "$mix_fn" >/dev/null && continue
                        eval -- "${mix_fn} () { ${mix}_${mm} \"\$@\" ; }"
                        XO_METHOD_INHERITED[$mix_fn]=$mix
                    done
                done
            fi

            # 扩充类实例方法，补充当前子类没有而父类拥有的方法
            # 首先获取父类所有的实例方法(排除掉_那些私有方法)
            # 这里一定要使用 compgen 工具重新获取，因为函数一直在动态刷新！
            # 下一次循环的时候父类的方法集合已经改变！
            local -a father_methods=()
            local father_func_pattern=
            printf -v father_func_pattern '!%s_[!_]*' "$father"
                #@if compgen_v==1
            compgen -V father_methods -A function -X "$father_func_pattern"
                #@endif
                #@if compgen_v==0
            father_methods=($(compgen -A function -X "$father_func_pattern"))
                #@endif
            father_methods=("${father_methods[@]#${father}_}")

            # ---- 路径压缩：直接把子类方法指向「最终实现类」----
            #
            # 目的：避免深继承链层层转发。若 Base→A→B→C，不压缩时 C_speak 会变成
            #       C_speak() { B_speak "$@" ; }，调用时 B→A→Base 三层栈开销。
            #       压缩后 C_speak() { Base_speak "$@" ; }，一次直达。
            #
            # 为什么「只查一次表」就够？（这段最容易让后来人误判成 bug）
            #
            #   关键前提：_xo_init_class 由 x_walk 驱动，x_walk 是拓扑序遍历，
            #            父类一定先于子类处理。所以当处理当前类 cls 时，父类 father
            #            的方法生成逻辑已经跑完。
            #
            #   父类在生成自己的方法时，做的是同样的事：
            #     - 若父类的方法是自己实现的（用户手写/Mixin）：映射表里没有记录
            #     - 若父类的方法是从爷爷辈透传来的：父类已把「爷爷（或更上面）」
            #       写进了 XO_METHOD_INHERITED，而不是写「直接父类」
            #
            #   因此 XO_METHOD_INHERITED[$parent_fn] 里存的，永远是这个方法的
            #   「最终实现类」——不是「上一层」。一次查表，就能拿到终极目标。
            #
            #   例：Base→A→B→C，Base_speak 是真实实现
            #     A 处理时：XO_METHOD_INHERITED[A_speak]=Base
            #     B 处理时：查得 A_speak→Base，生成 B_speak() { Base_speak "$@" ; }
            #              记录 XO_METHOD_INHERITED[B_speak]=Base
            #     C 处理时：查得 B_speak→Base，生成 C_speak() { Base_speak "$@" ; }
            #   每一层都直达 Base，无需追溯，无需循环，无需 declare -f 解析函数体。
            #
            #   Mixin 同理：Mixin 注入时记录的是 M_xxx 名，子类查表也一步命中。
            local m
            for m in "${father_methods[@]}" ; do
                local fn="${cls}_${m}"
                declare -F "$fn" >/dev/null && continue   # 子类已有，跳过

                # 路径压缩：父类方法若是透传/Mixin，映射表里存的已是最终目标
                local target_cls=$father
                local parent_fn="${father}_${m}"
                [[ -n "${XO_METHOD_INHERITED[$parent_fn]+_}" ]] && \
                    target_cls=${XO_METHOD_INHERITED[$parent_fn]}

                eval -- "${fn} () { ${target_cls}_${m} \"\$@\" ; }"
                XO_METHOD_INHERITED[$fn]=$target_cls
            done
        fi

        # 类对象保存一份字符串缓存，用于创建实例对象的时候加速
        local -n c_obj="${cls}Obj"
            #@if at_k_var_substitution==1
        declare -g ${cls}ObjStr="${c_obj[*]@K}"
            #@endif
            #@if at_k_var_substitution==0
        array_to_kv_q_str "${cls}Obj" ; eval "${_ret_g_s/o/${cls}ObjStr}"
            #@endif

        XO_INIT_DONE=$(( XO_INIT_DONE + 1 ))
        _xo_progress_draw
        return 0
    }
    XO_INIT_DONE=0
    (( XO_INIT_PROGRESS )) && _xo_progress_count
    x_walk CLASS_INHER_TREE '' _xo_init_class_cb || return $?
    _xo_progress_finish
}



# -------------------------对象管理部分---------------------------------------

declare -gA XO_OBJ_POOL=()
# 预留 OBJ_1 ~ OBJ_10 给系统特殊对象（如全局单例、框架内部对象），
# 用户对象从 OBJ_11 开始。修改此值时同步更新预留范围。
declare -gi XO_OBJ_SEQ=10


xo_init ()
{
    # 确保 xo_init 函数只能被调用一次
    [[ -n "$_XO_INIT_CALLED" ]] && return 0

    # 保存全局的调用关系链
    _xo_init_get_class_inher_chain || return $?
    _xo_init_class || return $?
    _XO_INIT_CALLED=1
}

declare -g XO_INHER_CHAIN_DUMP_CACHE=''
xo_dump_inher_chain ()
{
    [[ -n "$_XO_INIT_CALLED" ]] || {
        die ERR "xo: xo_init not called yet, CLASS_INHER_TREE is empty"
        return 1
    }
    if [[ -z "$XO_INHER_CHAIN_DUMP_CACHE" ]] ; then
            #@if current_shell_process_replace==1
        XO_INHER_CHAIN_DUMP_CACHE=${ x_dump CLASS_INHER_TREE '' 4 2 ;}
            #@endif
            #@if current_shell_process_replace==0
        XO_INHER_CHAIN_DUMP_CACHE=$(x_dump CLASS_INHER_TREE '' 4 2)
            #@endif
    fi
    printf "%s\n" "$XO_INHER_CHAIN_DUMP_CACHE"
}

# new
# 创建对象（两个 born 入口共用同一份函数体）。
#
# 热路径 xo_obj_born <类> [参数...] 直接走这里、自动分配句柄；具名场景由
# xo_obj_born_named 走内部 --name 分支。**不要**再拆出内部实现函数：born 是最热的
# 对象操作，多一层调用就多一次固定开销（实测 ~16us/次）。
xo_obj_born ()
{
    REPLY=
    local obj=''
    local cls
    if [[ "$1" == '--name' ]] ; then
        # 内部入口：xo_obj_born --name <句柄> <类> [参数...]
        obj=$2
        cls=$3
        shift 3

        # 名字规则：以 OBJ_ 开头，后缀以字母开头（避开纯数字，跟自动分配隔离）
        [[ "$obj" == OBJ_* ]] || {
            die ERR "xo: named object '${obj}' must start with 'OBJ_'"
            return 1
        }
        local suffix=${obj#OBJ_}
        [[ -n "$suffix" && "${suffix:0:1}" == [a-zA-Z] ]] || {
            die ERR "xo: named object suffix '${suffix}' must start with a letter"\
                    "(pure numeric names like OBJ_11 are reserved for auto-allocation)"
            return 1
        }

        # 具名句柄由用户提供，可能撞上两种已存在的东西，都必须拦：
        #   - 变量层：declare -gA 会**静默改写**已存在的变量（连标量都会被改成
        #     关联数组）。注意**不能**用 [[ -v "$obj" ]]——它对关联数组永远为假
        #     （等价于查 key 0），等于没检查；这里用最准确的 declare -p。
        #   - 池子层：同名对象可能正活着。
        #
        # 匿名分支两种都不会撞：句柄来自单调递增的 XO_OBJ_SEQ，既不在变量空间，
        # 也不会在池子里，所以匿名热路径上这两条检查一步都不做。
        declare -p "$obj" >/dev/null 2>&1 && {
            die ERR "xo: named object '${obj}' already exists as a variable"\
                    "(bury it or pick another name)"
            return 1
        }
        [[ -n "${XO_OBJ_POOL[$obj]+_}" ]] && {
            die ERR "xo: object handle '${obj}' already in pool"
            return 1
        }
    else
        cls=$1
        shift

        # 前置自增：表达式值为【新值】，永远 ≥1，(( )) 返回 0，set -e 下安全。
        # 勿改回后置自增 ((XO_OBJ_SEQ++))：表达式值为【旧值】，初始若为 0
        # 会返回 1，set -e 下第一次 born 就退出。
        ((++XO_OBJ_SEQ))
        obj="OBJ_${XO_OBJ_SEQ}"
    fi

    # 1. 类必须存在（且类对象非空）
    #
    # 【为什么用 nameref + ${#arr[@]}，不用其他写法】
    # 检查「关联数组是否存在且非空」，bash 里踩过两个坑：
    #
    #   x [[ -v "$var" ]]
    #       bash 4.3+ 对数组等价于 [[ -v "$var[0]" ]]，关联数组没有键 0，
    #       永远返回 1（明明对象存在却判不存在）。
    #
    #   x [[ -n "${!var+_}" ]]
    #       同理，${!var} 展开后对关联数组检查「变量本身有没有值」，
    #       关联数组作为整体没有值，只有键值对，永远返回空。
    #
    #   O local -n ref=$var ; ((${#ref[@]}))
    #       nameref 直绑，${#ref[@]} 取元素数，非零即「存在且非空」。
    #       同时拦住「变量不存在」和「空对象」两种情况，
    #       比 declare -p（放过空对象）更严。
    # 2. 实例 = 类对象缓存字符串
    local -n cls_objstr="${cls}ObjStr"
    [[ -z "$cls_objstr" ]] && {
        die ERR "xo: class '${cls}' not defined (did you forget to declare"\
                "${cls}StaticTemplate or run xo_init?)"

        return 1
    }
    declare -gA "${obj}=($cls_objstr)"

    # 3. 登记到对象池
    XO_OBJ_POOL[$obj]=$cls

    # 4. 调 born 钩子
    "${cls}_born" "$obj" "$@" || {
        unset -v "$obj"
        unset -v 'XO_OBJ_POOL[$obj]'
        die ERR "xo: ${cls}_born failed for ${obj}"
        return 1
    }

    REPLY=$obj
    return 0
}

# 具名对象：用户指定 OBJ_plane, OBJ_canvas, ...（冷路径，转给上面的 --name 分支）
xo_obj_born_named ()
{
    xo_obj_born --name "$@"
}

xo_obj_bury ()
{
    local obj=$1

    # 1. 必须是受管对象
    [[ -n "${XO_OBJ_POOL[$obj]+_}" ]] || {
        die ERR "xo: '${obj}' is not a managed object"
        return 1
    }

    # 2. 调退役钩子（如果存在）
    # 组合对象退役等等
    #
    # 钩子解析：继承来的钩子是一层转发（Bullet_retire -> Entity_retire），
    # XO_METHOD_INHERITED 里存的正是「最终实现类」（路径压缩过），直接调它，
    # 省掉每层转发的一次函数调用。表里没有记录 = 这个类自己实现了钩子。
    local cls=${XO_OBJ_POOL[$obj]}
    local _rt=${XO_METHOD_INHERITED["${cls}_retire"]:-$cls}
    "${_rt}_retire" "$obj" || {
        die ERR "xo: ${cls}_retire failed for ${obj}"
        return 1
    }

    # 2.5 动态能力的路由随对象一起销毁：否则具名句柄重建时，旧能力会串到新对象上。
    # 门控分两级：
    #   集合为空（没有任何对象带动态能力）→ 所有 bury 只做一次数组长度判断就返回；
    #   集合非空（例如 Boss 带着能力在场上）→ 每次 bury 多一次集合查询，命中才清。
    # 子弹永远不在集合里，所以第二级查询对它们必然落空，不会误清。
    #
    # 这里**不调 _cleanup**：对象变量接下来会被整个 unset，能力写在对象里的
    # 状态随之消失；具名句柄重建是从类模板重新 born，字段回到模板初值，不会残留。
    # 路由则是对象之外的状态（XO_OBJ_METHOD），所以必须在这里单独清。
    # _cleanup 的适用场景只有「对象还活着、中途摘掉某个能力」（xo_obj_mixin_delete）。
    # 将来若某个能力在对象之外持有资源（全局注册、它拥有的其它对象），届时才需要在
    # bury 里补清理——目前没有这种能力，先不加。
    if (( ${#XO_OBJ_MIXED[@]} )) && [[ -n "${XO_OBJ_MIXED[$obj]+_}" ]] ; then
        _xo_obj_mixin_drop_table "$obj"
        unset -v 'XO_OBJ_MIXED[$obj]'
    fi

    # 3. unset 全局变量 + 从池子移除
    unset -v "$obj"
    unset -v 'XO_OBJ_POOL[$obj]'
    return 0
}

# ==============================================================================
# 【资源市场：hire（返聘） / fire（解聘）】
#
# 生与死仍然是 born / bury：born 从类模板反序列化出一个全新的关联数组，bury 彻底销毁。
# hire/fire 是**存储层的复用**，不改变生命语义：
#
#   born  出生   新肉体 + 进入世界
#   hire  返聘   复用待业肉体 + 重新进入世界（内部走同一个 <cls>_born）
#   fire  解聘   离开世界，肉体保留 → 资源市场
#   bury  埋葬   离开世界，肉体销毁
#
# 【硬约束：hire / fire 只用于"简单对象"】
#
#   简单对象 = 不拥有其它对象的类：子弹、敌弹、导弹、掉落、飘字都是。
#   组合对象 = 字段里持有其它对象句柄的类：目前只有 Plane（{w1}..{w5} 指向武器）。
#
#   组合对象一律用 bury，父子一起消灭。
#   绝对不要对组合对象调 fire —— retire 钩子只知道"我要离开世界了"，不知道
#   自己处在 bury 还是 fire 里：它会把子对象按 bury 处理（销毁），而父对象却
#   进了资源市场；返聘回来的父对象字段里就挂着一把悬空的子句柄。
#
#   同理，**fire 只用于匿名句柄**（OBJ_数字）。具名句柄由使用方自己管生命周期，
#   fire 之后变量还在，这个名字在 bury 之前不能再 born（会报 already exists）。
#
#   将来若真要回收组合对象，必须先扩展契约：<cls>_retire 传入出口模式
#   （bury|fire），并让 <cls>_born 重建父子关系。在那之前这条约束不做例外。
#
# 关键约束（性能）：复用时**不能全字段重置**——逐字段写回比重新解析还慢
# （实测 39 字段 469µs vs 类串解析 245µs）。所以：
#   - 类可以在类文件里声明 `<cls>ResetFields='prev_x prev_y color'`（易变字段）；
#   - fire 只重置这些字段（3~6 个 ≈ 15~30µs）；
#   - 没声明的类退回"全字段重置"（用类 KV 串重建，仍比 born 便宜），保证正确性。
#   - 默认值直接从类对象读（`${cls}Obj["{字段}$X"]`），不需要额外的默认值表。
#
# 市场结构（O(1) 后进先出，单关联数组，避免每类一个动态变量名）：
#   RES_COUNT[类]           当前存货数
#   RES_MARKET["类|序号"]    句柄
#   RES_LIMIT[类]           容量上限，缺省 RES_LIMIT_DEFAULT
#
# 契约（和 bury 一样）：调用 fire 之前必须把句柄从调用方自己的集合里摘掉；
# 用句柄前必须查 XO_OBJ_POOL。原因是 fire 之后变量仍然存在，过期句柄会读到
# "默认值"而不是空——错误会从显式变成隐式。
#
# 其它已知边界（都是"禁止操作"，不是缺口）：
#   - **不要手动 unset / 改写 OBJ_* 变量**。整个 OBJ_ 前缀是框架保留的；
#     市场里的肉体如果被外部 unset，xo_obj_hire 会照常把它登记回池却发现变量
#     不在——这是未定义行为。销毁对象只有 xo_obj_bury 一个出口。
#   - xo_fire_clear 只丢引用、不销毁肉体（测试/换局用）；需要彻底回收请逐个 bury。
#   - xo_call / xo_obj_call 是**裸分发**，不查池：对死句柄会得到 bash 的
#     "command not found: _move"。热路径上加了校验就是每对象每 tick 多一次查表，
#     所以契约是"调用方先查 XO_OBJ_POOL"。xo_obj_call_all / xo_obj_mixin_list
#     同理：它们也只读对象的 {OBJMIX}，不替调用方兜底。
#   - xo_obj_hire_n 中途失败会返回 1，REPLY 里是**已经返聘出来的部分**句柄。
#   - 市场键用 '|' 分隔：类名是标识符，不含 '|'，所以不会歧义。
# ==============================================================================
declare -gA RES_COUNT=() RES_MARKET=() RES_LIMIT=()
# 回收市场默认容量
declare -gi RES_LIMIT_DEFAULT=512
declare -gA XO_RESET_FIELDS=() XO_RESET_DEF=() XO_RESET_READY=()

# 字段键：返回该字段在类对象/实例里的真实键名。
#   扁平类（FLT=1）：hp          树类（FLT=0）：{hp}$X
# fire/hire 的默认值读写走这里，两条路共用同一套键规则。
_xo_field_key ()
{
    local -n _kc="${1}Obj"
    if [[ "${_kc[{FLT}$X]:-0}" == 1 ]] ; then
        REPLY=$2
    else
        REPLY="{${2}}$X"
    fi
}

# 预处理一个类的重置清单（每类只做一次）
_xo_reset_prepare ()
{
    local cls=$1
    local var="${cls}ResetFields"
    local list=''
    if declare -p "$var" >/dev/null 2>&1 ; then
        list=${!var}
    fi
    XO_RESET_FIELDS[$cls]=$list
    if [[ -n "$list" ]] ; then
        local -n _c="${cls}Obj"
        local f k
        for f in $list ; do
            _xo_field_key "$cls" "$f" ; k=$REPLY
            if [[ -z "${_c[$k]+_}" ]] ; then
                die ERR "xo: class '${cls}' ResetFields lists unknown field '${f}'"
                return 1
            fi
            XO_RESET_DEF["$cls|$f"]=${_c[$k]}
        done
    fi
    XO_RESET_READY[$cls]=1
    return 0
}

# 把对象的易变字段恢复成模板默认值（fire 前调用）
_xo_obj_reset_fields ()
{
    local cls=$1
    local obj=$2
    (( XO_RESET_READY[$cls] )) || _xo_reset_prepare "$cls" || return 1
    local list=${XO_RESET_FIELDS[$cls]:-}
    if [[ -z "$list" ]] ; then
        # 安全路径：没有声明易变字段 → 用类 KV 串整体重建（等价于 born 的初始化）
        local -n _rs="${cls}ObjStr"
        declare -gA "${obj}=($_rs)"
        return 0
    fi
    local -n o=$obj
    local f k
    for f in $list ; do
        _xo_field_key "$cls" "$f" ; k=$REPLY
        o[$k]=${XO_RESET_DEF["$cls|$f"]}
    done
    return 0
}

# 解聘：对象离开世界，肉体保留进资源市场
xo_obj_fire ()
{
    local obj=$1
    [[ -n "${XO_OBJ_POOL[$obj]+_}" ]] || {
        die ERR "xo: '${obj}' is not a managed object"
        return 1
    }
    local cls=${XO_OBJ_POOL[$obj]}

    # 1. 退役钩子：和 bury 完全同一套语义（记忆与灵魂离开世界）。
    # 解析方式同 bury：直接调「最终实现类」的钩子，跳过继承转发。
    local _rt=${XO_METHOD_INHERITED["${cls}_retire"]:-$cls}
    "${_rt}_retire" "$obj" || {
        die ERR "xo: ${cls}_retire failed for ${obj}"
        return 1
    }

    # 2. 动态能力必须清掉：否则返聘的雇员会带着前任的技能。
    # 注意和 bury 的区别：bury 会把对象整体 unset，所以只清路由就够；
    # fire 的肉体留着，{OBJMIX} 字段本身也必须清空，否则名单里还留着旧能力。
    if (( ${#XO_OBJ_MIXED[@]} )) && [[ -n "${XO_OBJ_MIXED[$obj]+_}" ]] ; then
        _xo_obj_mixin_drop_table "$obj"
        unset -v 'XO_OBJ_MIXED[$obj]'
        local -n _mo=$obj
        _mo["{OBJMIX}$X"]=''
    fi

    # 3. 恢复易变字段（此时对象还在池里，字段可读写）
    _xo_obj_reset_fields "$cls" "$obj" || return 1

    # 4. 进市场；超过容量就当场销毁，不囤货
    local -i n=${RES_COUNT[$cls]:-0}
    local -i lim=${RES_LIMIT[$cls]:-$RES_LIMIT_DEFAULT}
    if (( n < lim )) ; then
        RES_MARKET["$cls|$n"]=$obj
        RES_COUNT[$cls]=$(( n + 1 ))
        unset -v 'XO_OBJ_POOL[$obj]'
    else
        unset -v "$obj"
        unset -v 'XO_OBJ_POOL[$obj]'
    fi
    return 0
}

# 返聘：优先从市场捞一个，没有就 born。空市场时与 born 完全等价。
xo_obj_hire ()
{
    REPLY=
    local cls=$1
    shift
    local -i n=${RES_COUNT[$cls]:-0}
    if (( n > 0 )) ; then
        local -i idx=$(( n - 1 ))
        local obj=${RES_MARKET["$cls|$idx"]}
        unset -v "RES_MARKET[$cls|$idx]"
        RES_COUNT[$cls]=$(( n - 1 ))
        # 顺序与 born 一致：先登记回池，再调 born 钩子（钩子可读写自己的字段）
        XO_OBJ_POOL[$obj]=$cls
        "${cls}_born" "$obj" "$@" || {
            unset -v "$obj"
            unset -v 'XO_OBJ_POOL[$obj]'
            die ERR "xo: ${cls}_born failed for ${obj}"
            return 1
        }
        REPLY=$obj
        return 0
    fi
    xo_obj_born "$cls" "$@"
}

# 一次返聘 N 个：省掉调用方 N 次函数调用（环形弹幕用）。REPLY=空格分隔的句柄。
xo_obj_hire_n ()
{
    local -i n=$1
    local cls=$2
    shift 2
    local out=''
    local h
    local -i i
    for (( i=0 ; i<n ; i++ )) ; do
        xo_obj_hire "$cls" "$@" || { REPLY=$out ; return 1 ; }
        h=$REPLY
        out+="${out:+ }$h"
    done
    REPLY=$out
    return 0
}

# 市场概况（调试/测试用）：不带参数打印全部类
xo_fire_stats ()
{
    local cls
    if [[ -n "${1:-}" ]] ; then
        printf '%-16s %s / %s\n' "$1" "${RES_COUNT[$1]:-0}" "${RES_LIMIT[$1]:-$RES_LIMIT_DEFAULT}"
        return 0
    fi
    for cls in $( printf '%s\n' "${!RES_COUNT[@]}" | sort ) ; do
        printf '%-16s %s / %s\n' "$cls" "${RES_COUNT[$cls]}" "${RES_LIMIT[$cls]:-$RES_LIMIT_DEFAULT}"
    done
    return 0
}

# 清空市场（测试/换局用）。注意：对象变量本身不会被销毁（它们是"待业"的肉体），
# 这里只是丢弃所有引用。需要彻底回收请逐个 bury。
xo_fire_clear ()
{
    RES_MARKET=()
    RES_COUNT=()
    return 0
}

xo_class_methods ()
{    local cls=$1

    local -n cls_obj_var="${cls}Obj"
    ((${#cls_obj_var[@]})) || {
        die ERR "xo: class '${cls}' not defined"
        return 1
    }

    local pattern
    printf -v pattern '!%s_[!_]*' "$cls"
    local -a methods=()
        #@if compgen_v==1
    compgen -V methods -A function -X "$pattern"
        #@endif
        #@if compgen_v==0
    methods=($(compgen -A function -X "$pattern"))
        #@endif
    methods=("${methods[@]#${cls}_}")

    local m fn origin
    for m in "${methods[@]}" ; do
        fn="${cls}_${m}"
        if [[ -n "${XO_METHOD_INHERITED[$fn]+_}" ]] ; then
            origin=${XO_METHOD_INHERITED[$fn]}
            # 来源是 M_* → Mixin 注入；否则是父类透传
            if [[ "$origin" == M_* ]] ; then
                printf '%-24s (from mixin %s)\n' "$m" "$origin"
            else
                printf '%-24s (inherited from %s)\n' "$m" "$origin"
            fi
        else
            printf '%-24s (own)\n' "$m"
        fi
    done
}

# xo_call — 实例方法调用（热路径，每帧数十次，紧凑写法是有意的）
# $1=对象句柄  $2=方法名  $3..=方法参数
# 方法名约定：${{CLS}}_${方法名}，如 Dog_speak
#
# 类名直接取自对象池：XO_OBJ_POOL[$obj] 在 _xo_obj_born_impl 里写入、
# 在 load_game 里按 {CLS} 重建，与 {CLS} 恒等。省掉「nameref 绑定 +
# 一次关联数组取值 + 解绑」三件事，热路径每次调用少约 1/3 开销。
# 不再依赖 local -n 的自动释放（bash 4.4+），无兼容性代价。
xo_call ()
{
    "${XO_OBJ_POOL[$1]}_${2}" "$1" "${@:3}"
}

#-------------------------------------------------------------------------------
#                      【对象级 Mixin（动态能力）】
#
# 类级 {MIX} 在 xo_init 时注入一次、全类共享，那部分逻辑本补丁完全不碰；这里补的是
# 「只作用于单个对象」的一层，运行期可增可删。不生成也不注销任何函数：状态只有对象
# 字段 {OBJMIX}、方法缓存、分派表、持有集合，所以「创建快、消灭快」都只是几次数组读写。
#
#   分派   xo_obj_call obj method
#            ├─ 命中 XO_OBJ_METHOD["obj|method"] → M_<mixin>_<method>
#            └─ 未命中 → 回落类的 xo_call（无动态能力的对象行为与 xo_call 相同）
#
#   优先级 {OBJMIX} 列表靠前的先赢（与 {MIX} 语义一致）；删除后自动回退给下一个。
#
#   增删   xo_obj_mixin_add obj M_A [M_B ...]     按顺序注入，幂等，可一次加一组
#          xo_obj_mixin_delete obj [M_A ...]      不给参数 = 全部卸载
#
#   生命周期钩子（可选；方法名以 _ 开头 = 私有，不参与路由注入，多个能力同时实现也不会覆盖）：
#          _init     obj    注入完成后立刻调用：初始化状态 + "获得即生效"的效果
#          _cleanup  obj    卸载前（还在册时）调用一次：收尾
#     完整函数名 = M_<mixin>_<方法名>，即 M_Xxx__init / M_Xxx__cleanup。
#     _init 里可以自卸（一次性能力放完就调 xo_obj_mixin_delete 删掉自己），
#     所以 add 的列表循环每轮都会重读 {OBJMIX}。
#     bury 不调 _cleanup：整个对象变量会被销毁，对象内状态随之消失（详见 bury 处注释）。
#
#   约定（框架不强制，靠 review 与测试兜底）：
#     - 有对象状态的能力：_init / _cleanup **成对实现**——进时建状态，出时清状态；
#     - 无状态能力：至少实现 _init（获得即生效），或提供公共方法；
#     - 框架只强制一条：mixin 必须至少有一个公共方法或一个 _init，否则拒绝注入
#       （防止拼错名字的空 mixin 静默生效）。
#
# 边界：
#   - 热路径继续用 xo_call（零额外开销），只有需要动态能力的调用点用 xo_obj_call
#   - bury 只清路由与持有集合（具名句柄重用不串味），不调 _cleanup：
#     中途换能力才需要显式 xo_obj_mixin_delete
#   - {OBJMIX} 是纯运行时状态，但类模板必须声明空字段 '{OBJMIX} => '（值留空）：
#     节点进了类对象，运行期直接赋值才与对象树一致（x_walk/x_dump 才看得见）
#   - born 不注入任何能力：初始能力由调用方在 born 之后自行 add（用现成的 _born 钩子）
#-------------------------------------------------------------------------------

# 缓存：mixin => "方法1 方法2"，首次使用时扫描一次，之后只查表
declare -gA XO_MIXIN_METHODS=()
# 分派表："OBJ_x|method" => "M_Mixin_method"
declare -gA XO_OBJ_METHOD=()
# 当前持有动态能力的对象集合；xo_obj_bury 靠它做「是否需要清理路由」的廉价门控
declare -gA XO_OBJ_MIXED=()

# 取一个 Mixin 的公共方法列表（去掉 Mixin_ 前缀），结果放 REPLY。
# 只扫这一个 Mixin 的函数，不做全局 M_* 分组：Mixin 名带下划线时不会歧义。
_xo_mixin_methods ()
{
    local mixin=$1
    if [[ -n "${XO_MIXIN_METHODS[$mixin]+_}" ]] ; then
        REPLY=${XO_MIXIN_METHODS[$mixin]}
        return 0
    fi

    local -a found=()
    local pattern
    printf -v pattern '!%s_[!_]*' "$mixin"
        #@if compgen_v==1
    compgen -V found -A function -X "$pattern"
        #@endif
        #@if compgen_v==0
    found=($(compgen -A function -X "$pattern"))
        #@endif
    found=("${found[@]#${mixin}_}")

    REPLY=${found[*]}
    XO_MIXIN_METHODS[$mixin]=$REPLY
    return 0
}

# 内部：只删路由表项，不动 {OBJMIX}。
# 只允许在「该对象还没有任何动态 Mixin（名单为空）」时用，此时两半本来都是空的；
# 名单非空时调它会造出「名单有、路由没有」的坏状态，外部请用 xo_obj_mixin_delete。
_xo_obj_mixin_drop_table ()
{
    local obj=$1 k
    for k in "${!XO_OBJ_METHOD[@]}" ; do
        [[ "$k" == "${obj}|"* ]] && unset -v 'XO_OBJ_METHOD[$k]'
    done
    return 0
}

# 给对象注入一个或多个 Mixin：xo_obj_mixin_add OBJ M_A [M_B ...]
#
# 语义：
#   1) 按参数顺序注入，{OBJMIX} 的顺序就是优先级：同名方法先加先赢。
#   2) 幂等：对象已持有某个 Mixin 时跳过它、**不重复调 _init**
#      （否则会把正在倒计时的状态重置）。
#   3) 同一次调用里重复列同一个名字会被去重：add 是集合并集语义。
#      这条对一次性能力尤其重要——它在 _init 里放完就自卸，若同批重复列出
#      就会连触发两次（例如连放两条电网）。
#   4) 每个成功注入的 Mixin 在注册完成后立刻调它的 _init（若存在）。
#      _init 里允许自卸（放完就调 xo_obj_mixin_delete 删自己），所以循环每轮都重读
#      {OBJMIX}：既不会把已自卸的能力拼回名单（复活），也不会丢掉同批后面要加的能力。
#   5) 想去掉能力用 xo_obj_mixin_delete；想**再次获得**一次性能力，请在另一次 add
#      调用里加——那时它已不在名单里，不算"已持有"。
#
# 一句话总结：
#   持续性能力：add 一次与 add 多次**完全等价**（幂等，_init 只跑一次）。
#   一次性能力：同一次调用内与"add 一次"等价（去重）；只有分开的调用会再触发一次，
#              这是刻意的（比如下个阶段再放一条电网）。
#
# 契约：使用方类模板必须声明空字段 '{OBJMIX} => '，否则这里直接拒绝注入。
xo_obj_mixin_add ()
{
    local obj=$1 ; shift
    (( $# )) || { die ERR "xo: mixin add needs at least one mixin name" ; return 1 ; }

    [[ -n "${XO_OBJ_POOL[$obj]+_}" ]] || {
        die ERR "xo: mixin add on unknown object '${obj}'"
        return 1
    }

    # 契约：类模板必须声明 '{OBJMIX} => '（空值）。漏声明时字段不在对象树里，
    # x_walk/x_dump 会看不见它，所以这里直接报错而不是悄悄写一个野字段。
    # 一次调用只校验一次（列表形式也是同一个类）。
    local _cls=${XO_OBJ_POOL[$obj]}
    local -n _co="${_cls}Obj"
    if [[ -z "${_co[{OBJMIX}$X]+_}" ]] ; then
        die ERR "xo: class '${_cls}' must declare '{OBJMIX} => ' to use object mixins"
        return 1
    fi

    local -n _om=$obj
    local list=${_om["{OBJMIX}$X"]}

    # 对象当前没有任何动态 Mixin：先清掉可能残留的旧路由（具名句柄重用场景）
    [[ -z "$list" ]] && _xo_obj_mixin_drop_table "$obj"

    local mixin methods m seen=
    for mixin in "$@" ; do
        # 同一次调用里重复列同一个名字没有意义（add 是集合并集语义）：一次性能力被重复
        # 列出会连放两次（例如两条电网），属于写错。去重后 add A A 等价于 add A；
        # 想让它再触发一次，请在另一次调用里 add（那时它已经不在名单里了）。
        [[ " $seen " == *" $mixin "* ]] && continue
        seen+=" $mixin"

        # 每轮重新读名单：_init 里允许自卸（一次性能力放完就删自己），列表会变
        list=${_om["{OBJMIX}$X"]}
        # 幂等：已持有 → 跳过（不重复 init，避免把正在倒计时的状态重置）
        [[ " $list " == *" $mixin "* ]] && continue

        # 校验混入的Mixin和当前类的扁平属性是否匹配
        _xo_check_mixin_to_class_match "$_cls" "$mixin" || return $?

        _xo_mixin_methods "$mixin"
        methods=$REPLY
        # 只提供钩子、没有公共方法的能力也允许：它"获得即生效"，不对外提供可调用能力。
        # 但"既无公共方法又无 _init"的 Mixin 必然是名字写错，拒绝注入（否则会静默生效的空壳）。
        if [[ -z "$methods" ]] && ! declare -F "${mixin}__init" >/dev/null ; then
            die ERR "xo: mixin '${mixin}' has neither public methods (M_${mixin}_*) nor _init"
            return 1
        fi

        for m in $methods ; do
            # 先加的先赢：已被更早的 Mixin 占用的方法名保留原样
            [[ -n "${XO_OBJ_METHOD["$obj|$m"]+_}" ]] && continue
            XO_OBJ_METHOD["$obj|$m"]="${mixin}_${m}"
        done

        # ${list:+$list } 在 list 非空时展开成 "list "，否则为空串
        _om["{OBJMIX}$X"]="${list:+$list }$mixin"
        list=${_om["{OBJMIX}$X"]}
        XO_OBJ_MIXED[$obj]=1

        # 注册完成后再初始化（_init 是私有方法名，只在这里调用，不参与路由注入；
        # init 里可以安全读写自己的字段，也可以查询其它能力）
        if declare -F "${mixin}__init" >/dev/null ; then
            "${mixin}__init" "$obj"
        fi
    done
    return 0
}

# 卸载对象的动态 Mixin；不给参数 = 全部卸载。
# 每个「确实持有、且要被删掉」的 Mixin 先调 _cleanup（此刻还在册，能正常读写字段），
# 再摘名单并重解析路由：否则当初被先加先赢跳过的方法不会回来。
xo_obj_mixin_delete ()
{
    local obj=$1 ; shift

    [[ -n "${XO_OBJ_POOL[$obj]+_}" ]] || {
        die ERR "xo: mixin delete on unknown object '${obj}'"
        return 1
    }

    local -n _om=$obj
    local list=${_om["{OBJMIX}$X"]}
    local -a drop=() keep=()
    if (( $# )) ; then drop=("$@") ; else drop=($list) ; fi

    # 先清理状态（幂等：没持有过的 Mixin 不会触发 cleanup）
    local d
    for d in "${drop[@]}" ; do
        [[ " $list " == *" $d "* ]] || continue
        # 此刻还在册，钩子能正常读写字段
        if declare -F "${d}__cleanup" >/dev/null ; then
            "${d}__cleanup" "$obj"
        fi
    done

    # 从 {OBJMIX} 里摘掉要删的 Mixin，保留其余顺序
    local x hit
    for x in $list ; do
        hit=0
        for d in "${drop[@]}" ; do
            [[ "$x" == "$d" ]] && { hit=1 ; break ; }
        done
        (( hit )) || keep+=("$x")
    done
    _om["{OBJMIX}$X"]="${keep[*]}"

    # 名单被清空 → 这个对象不再持有动态能力
    (( ${#keep[@]} )) || unset -v 'XO_OBJ_MIXED[$obj]'

    # 重新解析路由：删掉谁，就把「谁提供过的每个方法」重新问一遍——
    #   名单里剩下的、最靠前的、能提供它的 Mixin 接任；没人能提供就删掉这条路由。
    #
    # 例：名单 [M_A, M_B, M_C]，M_A 提供 ping/solo，M_B 提供 ping，M_C 提供 ping
    #   删 M_A 前: ping → M_A_ping, solo → M_A_solo
    #   删 M_A 后: ping → M_B_ping（剩下的里 M_B 最先提供）
    #              solo → 删除路由（没人提供，调用会回落到类方法）
    local m pick k methods_d
    for d in "${drop[@]}" ; do                    # 被删掉的 Mixin
        _xo_mixin_methods "$d"
        methods_d=$REPLY
        for m in $methods_d ; do                  # 它提供过的每个方法
            pick=''
            for k in "${keep[@]}" ; do            # 剩下的 Mixin，按名单原顺序
                _xo_mixin_methods "$k"
                # 找到第一个能提供 m 的就接任；keep 的顺序就是优先级
                [[ " $REPLY " == *" $m "* ]] && { pick=$k ; break ; }
            done
            if [[ -n "$pick" ]] ; then
                XO_OBJ_METHOD["$obj|$m"]="${pick}_${m}"   # 有人接任
            else
                unset -v 'XO_OBJ_METHOD[$obj|$m]'         # 没人接任，路由消失
            fi
        done
    done
    return 0
}

# 查询对象的动态 Mixin 列表（空格分隔，可能为空），结果放 REPLY。
xo_obj_mixin_list ()
{
    local -n _om=$1
    REPLY=${_om["{OBJMIX}$X"]}
    return 0
}

#-------------------------------------------------------------------------------
#            【两种对象级分派：覆盖语义 vs 观察者语义】
#
# 对象级 Mixin 允许一个对象同时挂多个能力，于是"调用同名方法"有两种截然不同的语义，
# 框架给出两个函数，用哪个取决于调用点需要的语义 —— 选错会静默丢功能。
#
#   xo_obj_call  obj method [args]      覆盖语义：只跑一个（先赢）
#   xo_obj_call_all obj method [args]   观察者语义：每个持有者都跑一次
#
# ── xo_obj_call：能力查询 / 虚函数覆盖 ───────────────────────────────────────
#   分派：XO_OBJ_METHOD["obj|method"] 命中 → M_<mixin>_<method>
#         未命中 → 回落到类方法 <CLS>_<method>（xo_call 的路径）
#   语义：{OBJMIX} 列表里最靠前的、能提供该方法的 Mixin 赢；删掉它，下一个接任；
#         没人能提供就回落到类方法。
#   适用：你只关心"这个对象现在能不能做某件事"，且做一次就够。
#         例：玩家的技能槽查 <CLS>_use_skill、单个一次性效果、
#             "取某个能力的最新实现"这类覆盖式扩展点。
#   不适用：钩子（初始化/每 tick 维护），因为后面的能力会被静默吞掉。
#
# ── xo_obj_call_all：钩子 / 观察者 ───────────────────────────────────────────
#   分派：按 {OBJMIX} 列表顺序，逐个该 Mixin 自己的 M_<mixin>_<method>；
#         某个 Mixin 没实现这个方法就跳过（不报错、不回落类方法）。
#   语义：所有持有者都跑，顺序 = {OBJMIX} 顺序（所以能力的执行顺序是可预期的）。
#   适用：多个能力要各自维护自己的状态、每个都必须被调用到。
#         例：Boss 增益系统的 buff_tick 钩子（周期无敌、发射导弹、推进回血窗口），
#             每个能力都实现了它，用 xo_obj_call 会只跑第一个，
#             表现为"第二个能力完全没有效果"——这正是当初加这个函数的原因。
#         获得/失去能力不靠这个函数：那两条路径由 xo_obj_mixin_add/delete
#         直接调用各能力的 _init/_cleanup（见上文对象级 Mixin 一节）。
#   注意：它不调用类方法。若类侧也要参与，类侧应自己调用 xo_obj_call_all。
#
# 共同约束：
#   - 遍历的是 {OBJMIX} 名单本身，不依赖路由表；名单为空时是一次空循环（零成本路径）
#   - 能力在自己的回调用 xo_obj_mixin_delete/xo_obj_mixin_add 改名单是安全的：
#     本次遍历用的是名单快照（for 循环已展开），新增的能力下一轮才生效
#   - 两者都不做字段注入、不改 {CLS}/{SUP}/{MIX}
#   - 热路径（子弹移动等）继续用 xo_call，不要用这两个
#-------------------------------------------------------------------------------

# 能力查询 / 覆盖语义：只跑一个（{OBJMIX} 里最先提供该方法的 Mixin），未命中回落类方法。
xo_obj_call ()
{
    local f=${XO_OBJ_METHOD["$1|$2"]}
    [[ -n "$f" ]] || f="${XO_OBJ_POOL[$1]}_${2}"
    "$f" "$1" "${@:3}"
}

# 钩子 / 观察者语义：按 {OBJMIX} 顺序，把每个持有者自己的实现都跑一次。
# 没有实现该方法的 Mixin 直接跳过；不回落类方法。
xo_obj_call_all ()
{
    local obj=$1 method=$2
    local -n _ao=$obj
    local list=${_ao["{OBJMIX}$X"]}
    local m fn
    for m in $list ; do
        fn="${m}_${method}"
        declare -F "$fn" >/dev/null && "$fn" "$obj" "${@:3}"
    done
    return 0
}

#-------------------------------------------------------------------------------
# xo_set xo_qset xo_get 对于扁平类来说完全没有意义
# 因为扁平类就是直接的关联数组读取和写入，没有{}和$X
# 本身已经足够轻量，不需要再封装
#
#-------------------------------------------------------------------------------
#                      属性写入部分
# 【关于多层属性】
#   本框架不提供多层属性的语法糖。如需写入 {a}$X{b}$X{c}$X：
#   - 批量写同一前缀 → x_qinserts
#   - 单点写完整路径 → x_insert_dict / x_insert
#   - 写深层路径的扁平键 -> x_insert_token_dict
#   在 OOP 中，推荐用「对象组合（存句柄）」代替深层嵌套路径。
#-------------------------------------------------------------------------------
# xo_set — 一层属性的【安全设置】语法糖
#   xo_set $obj attr1 = value1 attr2 = value2
#   或者更加好看一点
#   xo_set $obj attr1 = value1\
#               attr2 = value2
#
# 【用途】消除满屏的 {attr}$X 视觉污染。
#
# 【机制】
#   属性已存在：直接赋值 o[{attr}$X]=$value（快）
#   属性不存在：走 x_insert 创建节点并维护 x_tree 结构（慢，但安全）
#
# 【适用场景】
#   类初始化、低频业务逻辑、动态添加新属性。
#
# 【禁忌】禁止在每帧执行的高频热路径（如游戏主循环）中使用。
#         内部循环 + shift 有开销，且不存在属性时调 x_insert 极慢。
#         如果在热路径，请直接写原生 o[{attr}$X]=$value。
#-------------------------------------------------------------------------------
xo_set ()
{
    local -n o=$1
    local on=$1
    shift
    while ((${#})) ; do
        if [[ -n "${o[{$1}$X]+_}" ]] ; then
            o[{$1}$X]=$3
        else
            x_insert "$on" "{$1}$X" "$3" || {
                die ERR "Obj:${on} set ${1}=${3} fail."
                return 1
            }
        fi
        shift 3
    done
    return 0
}

#-------------------------------------------------------------------------------
# xo_qset — 一层属性的【快速设置】语法糖
#   xo_set $obj attr1 = value1 attr2 = value2
#   或者更加好看一点
#   xo_set $obj attr1 = value1\
#               attr2 = value2
#
# 【用途】消除满屏的 {attr}$X，且追求极致速度。
#
# 【机制】
#   直接赋值 o[{attr}$X]=$value，零校验、零结构维护。
#
# 【适用场景】
#   已知属性必定存在的中低频更新（如每秒几次的物理状态同步）。
#
# 【致命警告：不能无脑调用！】
#   1. 属性必须存在：如果不存在，会写入“幽灵键”（有值但无 .c/.s 映射），
#      x_dump 和 x_walk 根本遍历不到，树结构会静默损坏。
#   2. 禁止在每帧执行的高频热路径中使用：
#      内部循环 + shift 的开销，比直接写 o[{attr}$X]=$value 大得多。
#      游戏主循环里，请老老实实写原生赋值！
#-------------------------------------------------------------------------------
xo_qset ()
{
    local -n o=$1
    shift
    while ((${#})) ; do
        o[{$1}$X]=$3 ; shift 3
    done
    return 0
}

#-------------------------------------------------------------------------------
# xo_get — 一层属性的批量读取语法糖
#
# 【框架保留名】本函数内部引用名为 `_xo_obj`。
#   调用方的接收变量名严禁使用 `_xo_obj`，除此之外任何名字（包括 `o`）都安全。
#
# 【用法】
#   xo_get $obj  key1 :- var1 \
#                key2 :- var2 \
#                key3 :- var3
#-------------------------------------------------------------------------------
xo_get ()
{
    local -n _xo_obj=$1
    shift
    while (($# >= 3)) ; do
        printf -v "$3" '%s' "${_xo_obj[{$1}$X]}"
        shift 3
    done
    return 0
}


return 0

