((_STR_IMPORTED++)) && return 0

. "${BASH_SOURCE[0]%/*}/grammar.sh"

readonly _STR_BUILT_IN_THRESHOLDS=3000
# readonly _STR_BUILT_IN_THRESHOLDS=-1

#-------------------------------------------------------------------------------

# The current function is much faster than the following way of writing
# printf -v REPLY '%*s' "$2" "" ; REPLY=${REPLY// /"$1"}
str_repeat ()
{
    local str=$1 ; local -i len=$(($2*${#str}))
    while ((${#str} < len)) ; do str+=$str ; done
    REPLY=${str::len}
}

#-------------------------------------------------------------------------------

# $1: a string
# $2: b string
# REPLY
str_common_prefix ()
{
    local a=$1 b=$2
    ((${#a}>${#b})) && local a=$b b=$a
    b=${b::${#a}}
    if [[ $a == "$b" ]] ; then
        REPLY=$a ; return 0
    fi

    local l=0 u=${#a} m
    while ((l+1<u)); do
        ((m=(l+u)/2))
        if [[ ${a::m} == "${b::m}" ]]; then
            ((l=m))
        else
            ((u=m))
        fi
    done

    REPLY=${a::l}
}

#-------------------------------------------------------------------------------

# $1: a string
# $2: b string
# REPLY
str_common_suffix ()
{
    local a=$1 b=$2
    ((${#a}>${#b})) && local a=$b b=$a
    b=${b:${#b}-${#a}}
    if [[ $a == "$b" ]]; then
        REPLY=$a ; return 0
    fi

    local l=0 u=${#a} m
    while ((l+1<u)); do
        ((m=(l+u+1)/2))
        if [[ ${a:m} == "${b:m}" ]]; then
            ((u=m))
        else
            ((l=m))
        fi
    done

    REPLY=${a:u}
}

#-------------------------------------------------------------------------------

str_count ()
{
    [[ -z "$1" || -z "$2" ]] && {
        echo "null haystack or null needle!" >&2
        REPLY=-1 ; return 1
    }
    ((${#1}>_STR_BUILT_IN_THRESHOLDS)) && {
        # -z Treat the input as a whole (because there are no nulls in shell variables)
        # --null Output with null delimiter
        # -F Search according to literals, not according to regular rules
        # -dc Only keep empty characters
        REPLY=$( printf '%s' "$1" | grep -zFo --null -- "$2" | tr -dc '\0' | wc -c )
        return 0
    }
    local text=${1//"$2"}
    ((REPLY=(${#1}-${#text})/${#2}))
    return 0
}

#-------------------------------------------------------------------------------

str_is_decimal_positive_int ()
{
    [[ -z "$1" ]] && return 1
    [[ "$1" == "0" || ( -z "${1//[0-9]/}" && "$1" != 0* ) ]]
}

#-------------------------------------------------------------------------------

str_is_decimal_int ()
{
    [[ "$1" == '-0' ]] && return 1
    [[ "${1:0:1}" == "-" ]] && set -- "${1:1}"
    str_is_decimal_positive_int "$1"
}

#-------------------------------------------------------------------------------

# $1: str
# $2: sep
str_split ()
{
    local str=$1 sep=$2
    local -a ret_arr=()
    local part=

    [[ -z "$sep" ]] && {
        local i ; for ((i=0; i<${#str}; i++)); do ret_arr+=("${str:i:1}") ; done
        REPLY=${ret_arr[*]@Q} ; return
    }

    [[ $str == *$'\034'* ]] || {
        local - ; set -f
        local old_ifs=$IFS IFS=$'\034'
        ret_arr=(${str//"$sep"/"$IFS"})
        IFS=$old_ifs ; REPLY=${ret_arr[*]@Q}
        return
    }

    while [[ $str == *"$sep"* ]]; do
        part=${str%%"$sep"*} ; ret_arr+=("$part") ; str=${str#*"$sep"}
    done
    [[ -n "$str" ]] && ret_arr+=("$str")

    REPLY=${ret_arr[*]@Q}
}

#-------------------------------------------------------------------------------

awk_cut ()
{
    REPLY=
    local str=$1 sep=$2 cnt=$3
    local tmp_sep=$(mktemp) tmp_str=$(mktemp)
    trap "rm -f ${tmp_sep} ${tmp_str}" RETURN EXIT
    printf '%s' "$sep" >"$tmp_sep"
    printf '%s' "$str" >"$tmp_str"

    REPLY=$(
        awk -v cnt="$cnt" '
        function split_literal(str, sep, arr, cnt,    pos, m, idx)
        {
        m = length(sep)
        idx = 1

        # Forward index: stop when splitting reaches the target segment
        if (cnt >= 0)
            {
            while ((pos = index(str, sep)) > 0)
                {
                arr[idx++] = substr(str, 1, pos - 1)
                if (idx > cnt + 1) {
                    # We have reached the target section and there is no need
                    # to continue dismantling it.
                    arr[idx] = substr(str, pos + m)
                    return idx
                }
                str = substr(str, pos + m)
                }
            arr[idx] = str
            return idx
            }
        else
            {
            # Negative index: must be split completely
            while ((pos = index(str, sep)) > 0)
                {
                arr[idx++] = substr(str, 1, pos - 1)
                str = substr(str, pos + m)
                }
            arr[idx] = str
            return idx
            }
        }

        BEGIN {
            RS = "\0"
            if ((getline s < ARGV[1]) > 0)
                {
                close(ARGV[1])
                }
            if ((getline str < ARGV[2]) > 0)
                {
                close(ARGV[2])
                }
            
            n = split_literal(str, s, a, cnt)

            if (cnt >= 0)
                idx = cnt + 1
            else
                idx = n + cnt + 1

            if (idx >= 1 && idx <= n)
                printf "%s ", a[idx]
            }
        ' "$tmp_sep" "$tmp_str")
    [[ -n "$REPLY" ]] && REPLY=${REPLY::-1}
}

#-------------------------------------------------------------------------------

awk_cut_regex ()
{
    local str=$1 sep=$2 cnt=$3
    # Using temporary file syntax is more stable than process replacement
    # Because process replacement <(cmd) relies more on OS features
    local tmp_sep=$(mktemp) tmp_str=$(mktemp)
    trap "rm -f ${tmp_sep} ${tmp_str}" RETURN EXIT
    printf '%s' "$sep" > "$tmp_sep"
    printf '%s' "$str" > "$tmp_str"

    REPLY=$(
        awk -v cnt="$cnt" '
        BEGIN {
            RS = "\0"
            if ((getline s < ARGV[1]) > 0)
                {
                close(ARGV[1])
                }
            if ((getline str < ARGV[2]) > 0)
                {
                close(ARGV[2])
                }
            n = split(str, a, s)
            if (cnt >= 0) idx = cnt + 1
            else idx = n + cnt + 1
            if (idx >= 1 && idx <= n) printf "%s ", a[idx]
            }
        ' "$tmp_sep" "$tmp_str")
    [[ -n "$REPLY" ]] && REPLY=${REPLY::-1}
}

#-------------------------------------------------------------------------------

# str_cut
# ----------
# Extract a field from a string using a multi character separator.
#
# Arguments:
#   $1: str   – input string
#   $2: sep   – separator (must not be empty)
#   $3: count – field index
#
# Field indexing rules:
#   count >= 0 : 0-based forward indexing
#   count < 0  : -1 = last field, -2 = second last, etc.
#
# Behavior:
#   . If the field does not exist → return empty string (unlike awk)
#   . Multi-character separators are fully supported
#   . No external commands are used (pure Bash, high performance)
#
# Return values:
#   0  – success (field extracted OR field not found but no error)
#        REPLY contains the field or empty string if not found
#   1  – error (separator is empty)
#
# Performance notes:
#   . Cutting ~400,000 characters takes ~0.16 seconds
#   . For strings < 3000 characters, str_cut is significantly faster than awk (no fork)
#   . For very large strings (> 3000 characters), awk becomes faster (C engine)
#
# Examples:
#   str_cut "$str" ':' 0     # first field
#   str_cut "$str" ':' 2     # third field
#   str_cut "$str" ':' -1    # last field
str_cut ()
{
    REPLY=
    local str=$1 sep=$2 cnt=$3
    [[ -z "$sep" ]] && { echo "sep:$sep can not be null!" >&2 ; return 1 ; }
    [[ "$str" == *"$sep"* ]] || return 0
    ((${#str}>_STR_BUILT_IN_THRESHOLDS)) && { awk_cut "$@" ; return $? ; }

    local transformed=$str
    if ((cnt>0)) ; then
            #@if current_shell_process_replace==1
        local repeat_str=${|str_repeat '*"$sep"' "$cnt";}
            #@endif
            #@if current_shell_process_replace==0
        str_repeat '*"$sep"' "$cnt" ; local repeat_str=$REPLY
            #@endif
        eval -- "transformed=\${str#$repeat_str}"
        # Length comparison takes much less time than direct string comparison
        ((${#transformed}==${#str})) && transformed=
        REPLY=${transformed%%"$sep"*}
    elif ((cnt<0)) ; then
        ((cnt!=-1)) && {
                #@if current_shell_process_replace==1
            local repeat_str=${|str_repeat '"$sep"*' "$((-cnt-1))";}
                #@endif
                #@if current_shell_process_replace==0
            str_repeat '"$sep"*' "$((-cnt-1))" ; local repeat_str=$REPLY
                #@endif
            eval -- "transformed=\${str%$repeat_str}"
            (("${#transformed}"=="${#str}")) && transformed=
        }
        REPLY=${transformed##*"$sep"}
    else
        REPLY=${transformed%%"$sep"*}
    fi
}

#-------------------------------------------------------------------------------

awk_str_index_of ()
{
    local haystack=$1 needle=$2 count=${3:-1}
    [[ -z "$needle" ]] && { REPLY=-1; return 0; }
    local tmp_needle=$(mktemp) tmp_haystack=$(mktemp)
    trap "rm -f ${tmp_needle} ${tmp_haystack}" RETURN EXIT
    printf '%s' "$needle" > "$tmp_needle"
    printf '%s' "$haystack" > "$tmp_haystack"

    REPLY=$(
        awk -v c="$count" '
        BEGIN {
            RS = "\0"
            if ((getline n < ARGV[1]) > 0)
                {
                close(ARGV[1])
                }
            if ((getline h < ARGV[2]) > 0)
                {
                close(ARGV[2])
                }

            pos = 0
            start = 1
            len_n = length(n)

            for (i = 1; i <= c; i++)
                {
                idx = index(substr(h, start), n)
                if (idx == 0)
                    {
                    print -1
                    exit
                    }
                pos = start + idx - 1
                start = pos + len_n
                }
            print pos - 1
            }
        ' "$tmp_needle" "$tmp_haystack")
}

#-------------------------------------------------------------------------------

# Find the index of the count-th occurrence of a substring in a string
function str_index_of
{
    REPLY=
    local haystack=$1 needle=$2 count=${3:-1}
    ((${#haystack}>_STR_BUILT_IN_THRESHOLDS||${#needle}>_STR_BUILT_IN_THRESHOLDS)) && {
        awk_str_index_of "$@" ; return $?
    }
        #@if current_shell_process_replace==1
    eval -- "local transformed=\${haystack#${|str_repeat '*"$needle"' "$count";}}"
        #@endif
        #@if current_shell_process_replace==0
    str_repeat '*"$needle"' "$count" ; local repeat_str=$REPLY   
    eval -- "local transformed=\${haystack#$repeat_str}"
        #@endif
    ((REPLY=${#haystack}-${#transformed}-${#needle},
    REPLY<0&&(REPLY=-1),REPLY>=0))
}

#-------------------------------------------------------------------------------

# str_cuts "$str" ':' 2 ';' -1
str_cuts ()
{
    REPLY=
    local str=$1
    local i sep cnt
    for((i=2;i<$#;i++)) ; do
        sep=${!i} ; ((i++)) ; cnt=${!i}
            #@if current_shell_process_replace==1
        str=${|str_cut "$str" "$sep" "$cnt";} || return $?
            #@endif
            #@if current_shell_process_replace==0
        str_cut "$str" "$sep" "$cnt" || return $?
        str=$REPLY
            #@endif
    done
    REPLY=$str
}

#-------------------------------------------------------------------------------

# e  -> 1
# 中 -> 3
# 😊 -> 4
str_bytes () { local LC_ALL=C; REPLY=${#1}; }

#-------------------------------------------------------------------------------
# JSON 风格转义内部实现，不直接调用。
# 公开包装：str_escape_keep_nl（值用，不动 }）/ str_escape_key（key 用，额外转 }）
#
# 输出：保留 \n 真换行；\b \f \r \t 用简写；反斜杠转 \\；
#       C0(0x00-0x1F) / DEL(0x7F) / C1(0x80-0x9F) 转 \uXXXX；
#       双引号、中文等可打印字符原样（不转义 "，不输出外层引号）；
#       $3=1 时额外把 } 转成 \}（供字典键定界用）。
#
# 【执行机制】
#   1. 快速路径：若字符串不含反斜杠，且除换行外全为可打印字符，
#      且（值版）无需处理 } / （key 版）不含裸 }，直接原样返回。
#   2. 中速路径：使用 Bash 内置模式替换（C 底层实现，极快）处理
#      高频字符（反斜杠、}、\b \f \r \t）。反斜杠必须排在第一位，
#      防止后续插入的字面量被二次转义；} 紧随其后，仅 key 版执行。
#   3. 慢速路径：替换后若仍残留罕见控制字符（C0/DEL/C1），逐字符
#      计算码点并转为 \uXXXX 格式。
#
# 【注意】C1 中 0x9B=CSI、0x9D=OSC、0x90=DCS，终端安全风险高于 C0。
#
# @in  $1=原始字符串  $2=输出变量名（nameref）  $3=1 表示额外转义 }（默认 0）
# @ret 0
_str_escape_impl ()
{
    local s=$1 i ch code hex
    local -n out=$2
    local escape_rbrace=${3:-0}

    # 快速路径：无反斜杠、无非打印（除换行）；key 版还需无裸 }
    if [[ $s != *\\* && $s != *[!$'\n'[:print:]]* ]] &&
       { ((!escape_rbrace)) || [[ $s != *'}'* ]]; } ; then
        out=$s ; return
    fi

    s=${s//'\'/'\\'}
    ((escape_rbrace)) && s=${s//'}'/'\}'}
    s=${s//$'\b'/'\b'}
    s=${s//$'\f'/'\f'}
    s=${s//$'\r'/'\r'}
    s=${s//$'\t'/'\t'}

    # 如果替换后只剩可打印 ASCII和回车,直接返回
    [[ $s != *[!$'\n'[:print:]]* ]] && { out=$s ; return ; }

    out=''
    for ((i = 0; i < ${#s}; i++)); do
        ch=${s:i:1}
        case $ch in
            $'\n')  out+=$'\n'   ;;   # 保留真换行
            *)
                # 显式按码点判断，不依赖 [[:cntrl:]] 对 C1 的 locale 行为：
                printf -v code '%d' "'$ch"
                if (( code < 32 || (code >= 127 && code <= 159) )); then
                    printf -v hex '\\u%04x' "$code"
                    out+=$hex
                else
                    out+=$ch
                fi
                ;;
        esac
    done
}

#-------------------------------------------------------------------------------
# 值用：通用 JSON 风格转义，不转义 }。
# @in  $1=原始字符串  $2=输出变量名（nameref）
# @ret 0
str_escape_keep_nl () { _str_escape_impl "$1" "$2" 0 ; }

#-------------------------------------------------------------------------------
# 字典键用：在通用转义基础上额外把 } 转成 \}，保证 { ... } 定界无歧义。
# 反斜杠先于 } 转义（顺序不可颠倒，否则注入的 \} 会被二次转义）。
# @in  $1=原始字符串  $2=输出变量名（nameref）
# @ret 0
str_escape_key ()     { _str_escape_impl "$1" "$2" 1 ; }

#-------------------------------------------------------------------------------
# 转义字符串反解。是 str_escape_keep_nl 和 str_escape_key 的共同逆函数。
#
# 反转：\\ \} \n \b \f \r \t \uXXXX（4位hex，大小写均可）
# 未知 \X 宽松保留为 \X。
#
# 【分支配对说明】
#   \}  仅 str_escape_key 会产生（字典键定界用）。对值侧（str_escape_keep_nl
#       的输出）是"死分支"——值 escape 不产生裸 \}，此分支永不命中，安全无害。
#
# 【执行机制】
#   逐反斜杠扫描：head 取第一个 \ 之前的内容原样搬走，然后识别 \ 后的
#   转义单元翻译。逐字符消费保证 \\ 先于 \n / \u 被吃，不会二次转义
#   （如 \\u4e2d 正确还原为字面 \u4e2d 而非"中"）。
#
# 【Windows 限制】BMP 外字符（U+10000 以上，如 emoji 😊）在 Windows Bash
# 下会被 wchar_t=16bit 拆成 UTF-16 代理对，导致 ${#s} 计数偏大、
# ${s:i:1} 切分错位、printf '%d' "'$ch" 返回代理值，转义/往返可能失败。
# 中文、日文、韩文、C0/C1 控制符均在 BMP 内，不受影响。
# 如需处理 emoji 等 BMP 外字符，请改用字节语义版本（local LC_ALL=C
#   + 手动 UTF-8 解码）。
#
# @in  $1=转义字符串
# @out REPLY=反解后的原始字符串
# @ret 0
str_unescape ()
{
    REPLY=
    local s=$1
    local out=''

    # 快速路径：无反斜杠直接原样返回
    [[ $s != *\\* ]] && { REPLY=$s ; return 0 ; }

    local rest=$s head ch hex ch_out
    while [[ $rest == *\\* ]]; do
        head=${rest%%\\*}
        out+=$head
        rest=${rest:${#head}+1}          # 吃掉 head 和一个 '\'
        [[ -z $rest ]] && { out+='\' ; break ; }
        ch=${rest:0:1}
        case $ch in
            '\')  out+='\'   ; rest=${rest:1} ;;
            '}')  out+='}'   ; rest=${rest:1} ;;
            'n')  out+=$'\n' ; rest=${rest:1} ;;
            'b')  out+=$'\b' ; rest=${rest:1} ;;
            'f')  out+=$'\f' ; rest=${rest:1} ;;
            'r')  out+=$'\r' ; rest=${rest:1} ;;
            't')  out+=$'\t' ; rest=${rest:1} ;;
            'u')
                hex=${rest:1:4}
                if ((${#hex}==4)) && [[ $hex != *[!0-9a-fA-F]* ]] ; then
                    printf -v ch_out '%b' "\\u$hex"
                    out+=$ch_out ; rest=${rest:5}
                else
                    out+='\u' ; rest=${rest:1}
                fi
                ;;
            *) out+="\\$ch" ; rest=${rest:1} ;;
        esac
    done
    out+=$rest ; REPLY=$out ; return 0
}

#-------------------------------------------------------------------------------
# 计算字符串在终端下的显示宽度（以终端字符单元格为准）
# 用法: str_display_width <字符串> <输出变量名>
#
# 【计算规则】
#   - 纯 ASCII 字符：宽度 = 字符数（例如已转义的 \u0001 序列是 6 个
#     ASCII 字符，宽度为 6）。
#   - CJK / 全角 / Emoji：宽度 = 2。
#   - 原始控制字符（C0/DEL/C1）：宽度 = 0。
#   - 残留的真换行 \n：宽度 = 0（换行表示上一行结束）。
#
# 【注意】入参通常应是已经过 str_escape_keep_nl 转义的字符串：
#   - 转义后，原始控制字符已变成 \uXXXX 这 6 个可打印 ASCII 字符，
#     宽度为 6 而非 0。
#   - str_escape_keep_nl 唯一保留的原始控制字符是真换行 \n，宽度按 0 计。
#   - 若值多行，调用方应先取最后一行（例如 ${s##*$'\n'}）再计算宽度。
#   - 若直接传入未转义的原始控制字符，慢速路径虽按码点算 0 宽，但
#     会造成终端显示混乱，属用法错误。建议先过 str_escape_keep_nl 再传。
str_display_width ()
{
    local s=$1
    local -n out_w=$2
    local total=0 i ch cp

    # 快速路径：纯 ASCII（0x00-0x7F），宽度 = 字符数
    # 用 [[:ascii:]] 而非 [ -~] 或 [[:print:]]：后两者在多字节 locale 下
    # 会漏判或误判中文，[[:ascii:]] 与 locale 无关，最稳。
    if [[ $s != *[![:ascii:]]* ]]; then
        out_w=${#s}
        return
    fi

    # 慢速路径：逐字符判断码点范围
    # 宽字符（宽度 2）范围：
    #   0x1100-0x115F   Hangul Jamo
    #   0x2E80-0x303E   CJK 部首扩展、符号
    #   0x3041-0x33FF   Hiragana, Katakana, Bopomofo, 兼容
    #   0x3400-0x4DBF   CJK 扩展 A
    #   0x4E00-0x9FFF   CJK 统一表意文字
    #   0xA000-0xA4CF   Yi
    #   0xAC00-0xD7A3   Hangul 音节
    #   0xF900-0xFAFF   CJK 兼容表意文字
    #   0xFE30-0xFE4F   CJK 兼容形式
    #   0xFF00-0xFF60   全角 ASCII
    #   0xFFE0-0xFFE6   全角符号
    #   0x1F300-0x1F64F Emoji
    #   0x1F900-0x1F9FF 补充 Emoji
    #   0x20000-0x3FFFD CJK 扩展 B+
    for (( i = 0; i < ${#s}; i++ )); do
        ch=${s:i:1}
        printf -v cp '%d' "'$ch"

        if (( cp < 32 || (cp >= 127 && cp < 160) )); then
            :                                        # 控制字符宽度 0
        elif (( (cp >= 0x1100  && cp <= 0x115F) ||
                (cp >= 0x2E80  && cp <= 0x303E) ||
                (cp >= 0x3041  && cp <= 0x33FF) ||
                (cp >= 0x3400  && cp <= 0x4DBF) ||
                (cp >= 0x4E00  && cp <= 0x9FFF) ||
                (cp >= 0xA000  && cp <= 0xA4CF) ||
                (cp >= 0xAC00  && cp <= 0xD7A3) ||
                (cp >= 0xF900  && cp <= 0xFAFF) ||
                (cp >= 0xFE30  && cp <= 0xFE4F) ||
                (cp >= 0xFF00  && cp <= 0xFF60) ||
                (cp >= 0xFFE0  && cp <= 0xFFE6) ||
                (cp >= 0x1F300 && cp <= 0x1F64F) ||
                (cp >= 0x1F900 && cp <= 0x1F9FF) ||
                (cp >= 0x20000 && cp <= 0x3FFFD) )); then
            (( total += 2 ))
        else
            (( total += 1 ))
        fi
    done
    out_w=$total
}

#-------------------------------------------------------------------------------

return 0

