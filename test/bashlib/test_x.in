                    "[1]$X{c6}$X" "$X_VALUE_TRUE" \
                    "[1]$X{c7}$X" "$X_VALUE_FALSE" \
                    "[1]$X{c8}$X" "strwxx" \
                    "[1]$X{$xx_key}$X[0]$X" "null" \
                    "[1]$X{$xx_key}$X[1]$X" $'\ngege\ngege\n' \
                    "[1]$X{$xx_key}$X[2]$X" "$X_VALUE_TRUE" \
                    "[1]$X{$xx_key}$X[3]$X" "1010$X" \
                    "[1]$X{$xx_key}$X[4]$X" "1010.22" \
                    "[1]$X{$key_nl}$X" "$val_nl" \
                    "[1]$X{$xx_key}$X[5]$X" "gegege" \
                    "[2]$X{x}$X" "value3" \
                    "[3]$X{y}$X" "value4" \
                    "[4]$X{z}$X" "value5" \
                    "[5]$X[3]$X" "value5" \
                    "[6]$X{key1ggggggggg}$X{keeeeeeeey2}$X" "valueX"

    x_dump t1 '' 4 $((2#010))
}

