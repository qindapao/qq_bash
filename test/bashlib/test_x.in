    x_qinserts   t1 leaves '' \
                    "{a}$X" $'geg\ngee\n  gg\n ' \
                    "{$sp}$X" $'2333\n geg\ngge  '
    local old_ifs=$IFS IFS=$'\n' tuple
    local -a get_params=()
    local iter_str

#@if current_shell_process_replace==1
    iter_str=${|x_iter t1 '' $((2#11111));}
#@endif
#@if current_shell_process_replace==0
    x_iter t1 '' $((2#11111)) ; iter_str=$REPLY
#@endif

    for tuple in $iter_str ; do
        IFS=$old_ifs ; local -a "tuple=($tuple)"
        get_params+=("${tuple[@]}")
    done
    local -a param_spec=(
        [5]=$'{\ngeg geg\n ge\ng  ge  }'
        [6]="5"
        [7]=$'{\ngeg geg\n ge\ng  ge  }'
        [8]=$'2333\n geg\ngge  '
        [9]="3"
        [0]="{a}"
        [1]="5"
        [2]="{a}"
        [3]=$'geg\ngee\n  gg\n '
        [4]="2"
        )

    if assert_array a get_params param_spec ; then
        log_test 1 1
    else
        log_test 0 1 ; return 1
    fi
    
    return 0
}

