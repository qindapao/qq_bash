#!/usr/bin/env bash

. ../../src/bashlib/x.sh
. ../libs/test_utils.sh

# x_insert
test_case1 ()
{
    # 初始化为对象节点
    test_case1_inner1 ()
    {
    #@if current_shell_process_replace==1
        local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
    #@endif
    #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
    #@endif
        local -A t1_init_spec=(
            [1.t]=1
            [max_index]=2
            )
        if assert_array 'A' t1 t1_init_spec ; then
            log_test 1 1
        else
            log_test 0 1 ;return 1
        fi

        x_insert t1 "{key1}$X" "value1"
        local -A t1_insert_spec=(
            [1.t]=1
            [1.s]="'{key1}'"
            ["1.c.{key1}"]=2
            ["{key1}$X"]=value1
            [2.k]="{key1}$X"
            [max_index]=3
            )

        # printf '%s=>%s\n' "${t1[@]@k}"

        if assert_array 'A' t1 t1_insert_spec ; then
            log_test 1 2
        else
            log_test 0 2 ;return 1
        fi
    }

    
    # 对象的嵌套插入
    test_case1_inner2 ()
    {
    #@if current_shell_process_replace==1
        local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
    #@endif
    #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
    #@endif
        x_inserts t1 "{key1}$X[2]$X[2]$X" "key1_2_2"                \
                        "{key1}$X[1]$X[1]$X" "null0_change"            \
                        "{key1}$X[3]$X[2]$X" "new_value"               \
                        "{key1}$X[3]$X[0]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[3]$X[0]$X{x3}$X" "1.11"              \
                        "{key1}$X[3]$X[1]$X" "$X_VALUE_NULL_ARR"      \
                        "{key1}$X[3]$X[1]$X[5]$X" "$X_VALUE_NULL_OBJ" \
                        "{key1}$X[3]$X[1]$X[5]$X{key11}$X" "xx1"       \
                        "{key1}$X[3]$X[1]$X[5]$X{key1}$X" "xx2"        \
                        "{key1}$X[3]$X[1]$X[5]$X{c}$X" "c"             \
                        "{key1}$X[3]$X[1]$X[5]$X{b}$X" "c"             \
                        "{key1}$X[3]$X[1]$X[5]$X{a}$X" "c"             \
                        "{key1}$X[3]$X[1]$X[5]$X{m}$X" "c"             \
                        "{key1}$X[3]$X[1]$X[5]$X{key2}$X" "c"          \
                        "{key1}$X[3]$X[1]$X[5]$X{key3}$X" "c"          \
                        "{key1}$X[3]$X[3]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[3]$X[4]$X" "$X_VALUE_NULL_ARR"      \
                        "{key1}$X[3]$X[5]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[3]$X[6]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[3]$X[7]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[3]$X[-4]$X" "$X_VALUE_NULL_ARR"     \
                        "{key2}${ohter_lev1}$X" "$X_VALUE_NULL_OBJ"

        local str1="$( x_dump t1 "" 4 $((2#011)) )"
        x_delete t1 "{key1}$X[2]$X"
        local str2="$( x_dump t1 "" 4 $((2#011)) )"
        diff_two_str_side_by_side "$str1" "$str2" "t1" "t1_delete"
        
    #@if current_shell_process_replace==1
        local -A "t2=(${|x_init "$X_TYPE_OBJ";})"
    #@endif
    #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; local -A "t2=($REPLY)"
    #@endif

        x_inserts t2 "{key1}$X[1]$X[1]$X" "null0_change"            \
                        "{key1}$X[2]$X[2]$X" "new_value"               \
                        "{key1}$X[2]$X[0]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[2]$X[0]$X{x3}$X" "1.11"              \
                        "{key1}$X[2]$X[1]$X" "$X_VALUE_NULL_ARR"      \
                        "{key1}$X[2]$X[1]$X[5]$X" "$X_VALUE_NULL_OBJ" \
                        "{key1}$X[2]$X[1]$X[5]$X{key11}$X" "xx1"       \
                        "{key1}$X[2]$X[1]$X[5]$X{key1}$X" "xx2"        \
                        "{key1}$X[2]$X[1]$X[5]$X{c}$X" "c"             \
                        "{key1}$X[2]$X[1]$X[5]$X{b}$X" "c"             \
                        "{key1}$X[2]$X[1]$X[5]$X{a}$X" "c"             \
                        "{key1}$X[2]$X[1]$X[5]$X{m}$X" "c"             \
                        "{key1}$X[2]$X[1]$X[5]$X{key2}$X" "c"          \
                        "{key1}$X[2]$X[1]$X[5]$X{key3}$X" "c"          \
                        "{key1}$X[2]$X[3]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[2]$X[4]$X" "$X_VALUE_NULL_ARR"      \
                        "{key1}$X[2]$X[5]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[2]$X[6]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[2]$X[7]$X" "$X_VALUE_NULL_OBJ"      \
                        "{key1}$X[2]$X[-4]$X" "$X_VALUE_NULL_ARR"     \
                        "{key2}${ohter_lev1}$X" "$X_VALUE_NULL_OBJ"

        # x_dump t2 "" 4 $((2#111));
        if x_equals t1 t2 ; then
            log_test 1 1
        else
            log_test 0 1 ; return 1
        fi

        return 0
    }

    test_case1_inner3 ()
    {
    #@if current_shell_process_replace==1
        local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
    #@endif
    #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
    #@endif

        x_inserts t1 "{a}$X{b}$X{c}$X" "1" \
                        "{a}$X{b}$X{c1}$X" "2" \
                        "{a}$X{b}$X{c2}$X" "$X_VALUE_NULL_OBJ" \
                        "{a}$X{b}$X{c3}$X" "$X_VALUE_NULL_ARR" \
                        "{a}$X{c}$X[4]$X" "$X_VALUE_NULL"

    #@if current_shell_process_replace==1
        local -A "t2=(${|x_init "$X_TYPE_ARR";})"
    #@endif
    #@if current_shell_process_replace==0
        x_init "$X_TYPE_ARR" ; local -A "t2=($REPLY)"
    #@endif

        x_inserts t2 "[0]$X(4)$X{c}$X" "t2_1" \
                        "[0]$X(2)$X{c1}$X" "t2_2"

    #@if current_shell_process_replace==1
        local -a "my_graft_info=(${|x_graft t1 "{a}$X{c}$X[4]$X" t2;})"
    #@endif
    #@if current_shell_process_replace==0
        x_graft t1 "{a}$X{c}$X[4]$X" t2 ; local -a "my_graft_info=($REPLY)"
    #@endif

        if [[ "${my_graft_info[0]}" == '13' ]] ; then
            log_test 1 1
        else
            log_test 0 1 ; return 1
        fi

        local abc
    #@if current_shell_process_replace==1
        abc=${|x_get_leaf t1 "{a}$X{c}$X[4]$X[0]$X[2]$X{c1}$X";}
    #@endif
    #@if current_shell_process_replace==0
        x_get_leaf t1 "{a}$X{c}$X[4]$X[0]$X[2]$X{c1}$X"
        abc=$REPLY
    #@endif
        x_insert t1 "{a}$X{c}$X[4]$X[0]$X[2]$X{c1}$X" "18.2"
        local ab
    #@if current_shell_process_replace==1
        abc=${|x_get_leaf t1 "{a}$X{c}$X[4]$X[0]$X[2]$X{c1}$X";}
    #@endif
    #@if current_shell_process_replace==0
        x_get_leaf t1 "{a}$X{c}$X[4]$X[0]$X[2]$X{c1}$X"
        abc=$REPLY
    #@endif
        x_insert t1 "{a}$X{c}$X[4]$X[0]$X[0]$X" "18.2"
        x_insert t1 "{a}$X{c}$X[5]$X" "$X_VALUE_NULL_ARR"
        x_insert t1 "{a}$X{c}$X[5]$X[0]$X" "xx_1"

        x_delete t1 "{a}$X{b}$X"

    #@if current_shell_process_replace==1
        local -A "t1_rebuild=(${|x_id_rebuild t1;})"
    #@endif
    #@if current_shell_process_replace==0
        x_id_rebuild t1 ; local -A "t1_rebuild=($REPLY)"
    #@endif


        x_insert t1 "{a}$X{m}$X" "$X_VALUE_NULL_OBJ"
        x_insert t1_rebuild "{a}$X{m}$X" "$X_VALUE_NULL_OBJ"
        
        if x_equals t1 t1_rebuild ; then
            log_test 1 2
        else
            log_test 0 2 ; return 1
        fi
        
        return 0
    }

    test_case1_inner4 ()
    {
    #@if current_shell_process_replace==1
        local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
    #@endif
    #@if current_shell_process_replace==0
        x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
    #@endif

        x_inserts t1 "{a 1}$X{b}$X{c}$X" "1" \
                        "{a 1}$X{b}$X{c1}$X" "2" \
                        "{a 1}$X{b}$X{c2}$X" "$X_VALUE_NULL_OBJ" \
                        "{a 1}$X{b}$X{c3}$X" "$X_VALUE_NULL_ARR" \
                        "{a 1}$X{c}$X[4]$X" "xx"
        x_dump t1
        local tuple
        local old_ifs=$IFS ; local IFS=$'\n'
        local -a get_info=()
        local iter_str

    #@if current_shell_process_replace==1
        iter_str=${|x_iter t1 "{a 1}$X{c}$X" $((2#11111));}
    #@endif
    #@if current_shell_process_replace==0
        x_iter t1 "{a 1}$X{c}$X" $((2#11111)) ; iter_str=$REPLY
    #@endif
        for tuple in $iter_str ; do
            IFS=$old_ifs ; eval -- set -- $tuple
            get_info+=("$@")
        done
        declare -a get_info_spec=(
            [0]="<9>" [1]="6" [2]="0" [3]="$X_VALUE_NULL" [4]="9"
            [5]="<10>" [6]="6" [7]="1" [8]="$X_VALUE_NULL" [9]="10"
            [10]="<11>" [11]="6" [12]="2" [13]="$X_VALUE_NULL" [14]="11" 
            [15]="<12>" [16]="6" [17]="3" [18]="$X_VALUE_NULL" [19]="12"
            [20]="<13>" [21]="5" [22]="4" [23]="xx" [24]="13")
        if assert_array a get_info_spec get_info ; then
            log_test 1 1
        else
            log_test 0 1 ; return 1
        fi

        return 0
    }


    test_case1_inner1 || return $?
    test_case1_inner2 || return $?
    test_case1_inner3 || return $?
    test_case1_inner4 || return $?
}

test_case2 ()
{
#@if current_shell_process_replace==1
    local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
    local -A "t2=(${|x_init "$X_TYPE_OBJ";})"
    local -A "t1_spec=(${|x_init "$X_TYPE_OBJ";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
    x_init "$X_TYPE_OBJ" ; local -A "t2=($REPLY)"
    x_init "$X_TYPE_OBJ" ; local -A "t1_spec=($REPLY)"
#@endif
    
    x_inserts t1 "{a}$X{b}$X{c}$X" "1" \
                    "{a}$X{m}$X" "$X_VALUE_NULL"

    x_inserts t2 "{a1}$X{b}$X{c}$X" "1" \
                    "{b}$X{m}$X[5]$X" "$X_VALUE_NULL"

    x_graft t1 "{x}$X" t2

    x_inserts t1_spec    "{a}$X{b}$X{c}$X" "1" \
                            "{a}$X{m}$X" "$X_VALUE_NULL" \
                            "{x}$X{a1}$X{b}$X{c}$X" "1" \
                            "{x}$X{b}$X{m}$X[5]$X" "$X_VALUE_NULL"

    if x_equals t1 t1_spec ; then
        log_test 1 1
    else
        log_test 0 1 ; return 1
    fi
    
    return 0
}

test_case3 ()
{
#@if current_shell_process_replace==1
    local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
#@endif
    x_inserts t1     "{a}$X{b}$X{c}$X" "1" \
                        "{a}$X{m}$X" "$X_VALUE_NULL" \
                        "{x}$X{a1}$X{b}$X{c}$X" "1" \
                        "{x}$X{b}$X{m}$X[5]$X" "$X_VALUE_NULL"

    x_dump t1 '' 4 2
    x_push_leaf t1 "{a}$X{beee}$X" 'x'
    x_push_leaf t1 "{a}$X{beee}$X" 'y'
    x_push_leaf t1 "{a}$X{beee}$X" "$X_VALUE_NULL_ARR"
    x_push_leaf t1 "{a}$X{beee}$X" "$X_VALUE_NULL"
    x_push_leaf t1 "{a}$X{beee}$X" "$X_VALUE_NULL_OBJ"

    x_insert t1 "{a}$X{m}$X" "$X_VALUE_NULL_ARR"
    x_push_leaf t1 "{a}$X{m}$X" "x"

#@if current_shell_process_replace==1
    local -A "t1_spec=(${|x_init "$X_TYPE_OBJ";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; local -A "t1_spec=($REPLY)"
#@endif
    x_inserts t1_spec "{a}$X{b}$X{c}$X" 1 \
                        "{a}$X{beee}$X[0]$X" x \
                        "{a}$X{beee}$X[1]$X" y \
                        "{a}$X{beee}$X[2]$X" "$X_VALUE_NULL_ARR" \
                        "{a}$X{beee}$X[3]$X" "$X_VALUE_NULL" \
                        "{a}$X{beee}$X[4]$X" "$X_VALUE_NULL_OBJ" \
                        "{a}$X{m}$X[0]$X" x \
                        "{x}$X{a1}$X{b}$X{c}$X" 1 \
                        "{x}$X{b}$X{m}$X[9]$X" "$X_VALUE_NULL" \
                        "{x}$X{b}$X{m}$X[0]$X" "4" \
                        "{x}$X{b}$X{m}$X[1]$X" "3" \
                        "{x}$X{b}$X{m}$X[2]$X" "2" \
                        "{x}$X{b}$X{m}$X[3]$X" "1"

    x_unshift_leaf t1 "{x}$X{b}$X{m}$X" "1"
    x_unshift_leaf t1 "{x}$X{b}$X{m}$X" "2"
    x_unshift_leaf t1 "{x}$X{b}$X{m}$X" "3"
    x_unshift_leaf t1 "{x}$X{b}$X{m}$X" "4"

    if x_equals t1 t1_spec ; then
        log_test 1 1
    else
        log_test 0 1 ; return 1
    fi

    return 0
}

test_case4 ()
{
#@if current_shell_process_replace==1
    local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
    local -A "t2=(${|x_init "$X_TYPE_OBJ";})"
    local -A "t1_spec=(${|x_init "$X_TYPE_OBJ";})"
    local -A "t3=(${|x_init "$X_TYPE_OBJ";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
    x_init "$X_TYPE_OBJ" ; local -A "t2=($REPLY)"
    x_init "$X_TYPE_OBJ" ; local -A "t1_spec=($REPLY)"
    x_init "$X_TYPE_OBJ" ; local -A "t3=($REPLY)"
#@endif
    x_inserts t1     "{a}$X{b}$X{c}$X" "1" \
                        "{a}$X{m}$X" "$X_VALUE_NULL" \
                        "{x}$X{a1}$X{b}$X{c}$X" "1" \
                        "{x}$X{b}$X{m}$X[5]$X" "$X_VALUE_NULL"

    x_inserts t2     "{a}$X{b}$X{c}$X" "1" \
                        "{a}$X{m}$X" "$X_VALUE_NULL" \
                        "{mxx}$X{a1}$X{b}$X{c}$X" "1" \
                        "{x}$X{b}$X{m}$X[5]$X" "$X_VALUE_NULL"

    x_push_tree t1 "{a}$X{x}$X{b}$X{m}$X" t2
    
    x_inserts t1_spec "{a}$X{b}$X{c}$X" "1" \
                        "{a}$X{m}$X" "$X_VALUE_NULL" \
                        "{x}$X{a1}$X{b}$X{c}$X" "1" \
                        "{x}$X{b}$X{m}$X[5]$X" "$X_VALUE_NULL" \
                        "{a}$X{x}$X{b}$X{m}$X[1]$X{a}$X{b}$X{c}$X" "1" \
                        "{a}$X{x}$X{b}$X{m}$X[1]$X{a}$X{m}$X" "$X_VALUE_NULL" \
                        "{a}$X{x}$X{b}$X{m}$X[1]$X{mxx}$X{a1}$X{b}$X{c}$X" "1" \
                        "{a}$X{x}$X{b}$X{m}$X[1]$X{x}$X{b}$X{m}$X[5]$X" "$X_VALUE_NULL" \
                        "{a}$X{x}$X{b}$X{m}$X[0]$X{new}$X" "new_value"


    x_insert t3 "{new}$X" "new_value"
    x_unshift_tree t1 "{a}$X{x}$X{b}$X{m}$X" t3

    if x_equals t1 t1_spec ; then
        log_test 1 1
    else
        log_test 0 1 ; return 1
    fi

    # x_walk t1
}

test_case5 ()
{
#@if current_shell_process_replace==1
    local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
#@endif
    x_inserts t1     "{a}$X" "1"                    \
                        "{b}$X" "101.3$X"              \
                        "{c}$X" "101.3"                \
                        "{d}$X" "${X_VALUE_TRUE}"     \
                        "{e}$X" "${X_VALUE_FALSE}"    \
                        "{f}$X" "${X_VALUE_NULL_ARR}" \
                        "{g}$X" "${X_VALUE_NULL_OBJ}" \
                        "{h}$X" "${X_VALUE_NULL}"     \
                        "{i}$X" "null"                 \
                        "{j}$X" $'xxx\n  \n yyy'
    local flat_1 flat_1_ret
    local -A flat_1_spec=(
        [a]=1
        [b]="101.3$X"
        [c]="101.3"
        [d]="${X_VALUE_TRUE}"
        [e]="${X_VALUE_FALSE}"
        [f]="${X_VALUE_NULL_ARR}"
        [g]="${X_VALUE_NULL_OBJ}"
        [h]="${X_VALUE_NULL}"
        [i]="null"
        [j]=$'xxx\n  \n yyy'
        )
    local flat_1 flat_1_ret

#@if current_shell_process_replace==1
    flat_1=${|x_to_flat_assoc t1;} ; flat_1_ret=$?
#@endif
#@if current_shell_process_replace==0
    x_to_flat_assoc t1 ; flat_1_ret=$?
    flat_1=$REPLY
#@endif

    if ((flat_1_ret==0)) ; then
        local -A "flat_1=($flat_1)"
    fi

    # cat -A <(x_dump t1)

    if  [[ "${flat_1@a}" == *A* ]] &&
        assert_array A flat_1 flat_1_spec ; then
        log_test 1 1
    else
        log_test 0 1 ; return 1
    fi

    return 0
}

test_case6 ()
{
#@if current_shell_process_replace==1
    local -A "t1=(${|x_init "$X_TYPE_ARR";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_ARR" ; local -A "t1=($REPLY)"
#@endif
    x_inserts t1     "[10]$X" "1"                    \
                        "[14]$X" "101.3$X"              \
                        "[16]$X" "101.3"                \
                        "[17]$X" "${X_VALUE_TRUE}"     \
                        "[18]$X" "${X_VALUE_FALSE}"    \
                        "[19]$X" "${X_VALUE_NULL_ARR}" \
                        "[20]$X" "${X_VALUE_NULL_OBJ}" \
                        "[21]$X" "${X_VALUE_NULL}"     \
                        "[22]$X" "null"                 \
                        "[23]$X" "xxx"
    local flat_1 flat_1_ret
    local -a flat_1_spec=(
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "1"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "${X_VALUE_NULL}"
        "101.3$X"
        "${X_VALUE_NULL}"
        "101.3"
        "${X_VALUE_TRUE}"
        "${X_VALUE_FALSE}"
        "${X_VALUE_NULL_ARR}"
        "${X_VALUE_NULL_OBJ}"
        "${X_VALUE_NULL}"
        "null"
        "xxx"
        )

#@if current_shell_process_replace==1
    flat_1=${|x_to_flat_array t1;} ; flat_1_ret=$?
#@endif
#@if current_shell_process_replace==0
    x_to_flat_array t1 ; flat_1_ret=$?
    flat_1=$REPLY
#@endif

    if ((flat_1_ret==0)) ; then
        local -a "flat_1=($flat_1)"
    fi

    # cat -A <(x_dump t1)

    if  [[ "${flat_1@a}" == *a* ]] &&
        assert_array a flat_1 flat_1_spec ; then
        log_test 1 1
    else
        log_test 0 1 ; return 1
    fi

    return 0
}

test_case7 ()
{
#@if current_shell_process_replace==1
    local -A "t1=(${|x_init "$X_TYPE_OBJ";})"
#@endif
#@if current_shell_process_replace==0
    x_init "$X_TYPE_OBJ" ; local -A "t1=($REPLY)"
#@endif
    x_inserts t1     "{x}$X{a}$X" "1"                    \
                        "{x}$X{b}$X" "101.3$X"              \
                        "{x}$X{c}$X" "101.3"                \
                        "{x}$X{d}$X" "${X_VALUE_TRUE}"     \
                        "{y}$X{e}$X" "${X_VALUE_FALSE}"    \
                        "{y}$X{f}$X" "${X_VALUE_NULL_ARR}" \
                        "{y}$X{g}$X" "${X_VALUE_NULL_OBJ}" \
                        "{y}$X{h}$X" "${X_VALUE_NULL}"     \
                        "{y}$X{i}$X" "null"                 \
                        "{y}$X{j}$X" "xxx"
    local flat_1 flat_1_ret
    local -A flat_1_spec=(
        [a]=1
        [b]="101.3$X"
        [c]="101.3"
        [d]="${X_VALUE_TRUE}"
        )
    
#@if current_shell_process_replace==1
