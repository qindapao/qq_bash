#@endif
#@if current_shell_process_replace==0
    x_from_json "$json_spec" ; local -A "my_recover_tree1=($REPLY)"
    x_from_json "$json_spec" 0 ; local -A "my_recover_tree2=($REPLY)"
#@endif

    # cat -A <(x_dump my_recover_tree1)

    if  x_equals my_recover_tree1 t1 &&
        x_equals my_recover_tree2 t2 ; then
        log_test 1 2
    else
        log_test 0 2 ; return 1
    fi


    
    return 0
}

test_case17 ()
